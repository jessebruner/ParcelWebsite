---
/**
 * Bottom CTA Band
 * High-converting closing band encouraging board officers to request early access or view pricing.
 */
interface Props {
  headline?: string;
  lede?: string;
}

const {
  headline = "Modern software built for self-managed associations.",
  lede = "Save time, keep full board oversight, and run your neighborhood on your schedule."
} = Astro.props;
---

<section class="cta-band">
  <div class="page">
    <div class="cta-card">
      <div class="cta-content">
        <span class="t-label cta-badge">Get Started</span>
        <h2 class="cta-title">{headline}</h2>
        <p class="cta-lede">{lede}</p>
        <div class="cta-actions">
          <button type="button" class="btn btn--primary" data-open-modal="early-access">Request Early Access</button>
          <a href="/pricing" class="btn">Calculate Association Pricing</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(48px, 6vw, 84px);
    background: var(--paper);
    border-top: var(--stroke-rule);
  }
  .cta-card {
    background: var(--card);
    border: 1.5px solid var(--ink);
    padding: clamp(36px, 5vw, 64px) clamp(24px, 4vw, 48px);
    text-align: center;
  }
  .cta-content {
    max-width: 36em;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
  }
  .cta-badge {
    background: var(--held);
    padding: 3px 8px;
    border: 1px solid var(--bisque-edge);
  }
  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.15;
    margin: 0;
  }
  .cta-lede {
    font-size: var(--t-lede);
    color: var(--ink-body);
    line-height: 1.45;
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
    margin-top: var(--s-4);
  }
</style>
