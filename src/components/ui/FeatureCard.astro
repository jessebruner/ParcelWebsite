---
/**
 * Feature Showcase Card
 * A visual module showing a key capability with a live-styled mockup preview.
 */
/**
 * `eyebrow` used to render twice: once as a label above the heading and again
 * as the title of the mock window beside it. The label above the heading is
 * gone — the heading carries its own weight — and the string is kept only as
 * the window's own chrome, which is where the homepage's panels put their
 * names. Renamed to say what it is now.
 */
interface Props {
  panelName: string;
  title: string;
  description: string;
  href?: string;
  linkText?: string;
  reverse?: boolean;
}

const { panelName, title, description, href, linkText = "Learn more", reverse = false } = Astro.props;
---

<div class:list={["feature-block", { reverse }]}>
  <div class="feature-text">
    <h3 class="feature-title">{title}</h3>
    <p class="feature-desc">{description}</p>
    <div class="feature-slot">
      <slot name="details" />
    </div>
    {href && (
      <div class="feature-cta">
        <a href={href} class="btn btn--primary">{linkText}</a>
      </div>
    )}
  </div>
  <div class="feature-visual">
    <div class="visual-frame">
      <div class="visual-bar">
        <div class="bar-dots">
          <span></span><span></span><span></span>
        </div>
        <div class="bar-title">{panelName}</div>
      </div>
      <div class="visual-content">
        <slot name="visual" />
      </div>
    </div>
  </div>
</div>

<style>
  .feature-block {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: var(--s-8);
    border-bottom: var(--stroke-rule);
  }
  .feature-block.reverse {
    grid-template-columns: 1.15fr 1fr;
  }
  .feature-block.reverse .feature-text { order: 2; }
  .feature-block.reverse .feature-visual { order: 1; }

  @media (max-width: 860px) {
    .feature-block, .feature-block.reverse {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .feature-block.reverse .feature-text { order: 1; }
    .feature-block.reverse .feature-visual { order: 2; }
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .feature-title {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.8vw, 32px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }
  .feature-desc {
    font-size: var(--t-lede);
    color: var(--ink-body);
    line-height: 1.5;
    margin: 0;
  }
  .feature-slot { margin-top: var(--s-2); }
  .feature-cta { margin-top: var(--s-3); }

  .feature-visual {
    width: 100%;
  }
  .visual-frame {
    background: var(--card);
    border: 1px solid var(--c-edge);
    overflow: hidden;
  }
  .visual-bar {
    background: var(--field);
    border-bottom: 1px solid var(--c-edge);
    padding: var(--s-2) var(--s-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .bar-dots {
    display: flex;
    gap: 5px;
  }
  .bar-dots span {
    width: 8px;
    height: 8px;
    background: var(--c-edge);
    display: inline-block;
  }
  .bar-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .visual-content {
    padding: var(--s-5);
    background: var(--card);
  }
</style>
