---
/**
 * The masthead, matched to the homepage's.
 *
 * The homepage is the original bundle and carries its own masthead. Two
 * different navigations on one site is the first thing anybody notices, so this
 * one reproduces that bar exactly: the same lockup, the same mono links at the
 * same size and tracking, the same terracotta block stretching full height, and
 * the same underline that wipes in from the left on hover.
 *
 * NO DROPDOWNS, for now, and on purpose. The bundle cannot render an Astro
 * component, so a panel here would be a panel the homepage does not have. When
 * the homepage moves into Astro both gain them together.
 *
 * The links come from src/data/routes.ts, and tools/patch-homepage-nav.mjs
 * writes the same list into the bundle from the same file, so the two bars
 * cannot list different pages.
 */
import Mark from "./Mark.astro";
import { TOP_NAV, PRODUCT, COMPARE } from "../data/routes";

/* The bundle's bar is flat, so a panel trigger becomes a link to the first page
   behind it. Same order, same labels. */
const LINKS = TOP_NAV.map((item) =>
  item.panel === "product"
    ? { href: PRODUCT[0].path, label: item.label }
    : item.panel === "compare"
      ? { href: COMPARE[0].path, label: item.label }
      : { href: item.path!, label: item.label }
);

const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const section = (href: string) =>
  href.startsWith("/product") ? "/product" : href.startsWith("/vs") ? "/vs" : href;
const isCurrent = (href: string) =>
  here === href || (section(href).startsWith("/") && here.startsWith(section(href)) && section(href) !== href);
---

<header class="mast">
  <div class="lockup-pad">
    <a class="lockup" href="/">
      <Mark size={34} />
      <span class="wordmark">Common Parcel</span>
    </a>
  </div>

  <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>

  <nav id="nav" aria-label="Main">
    <div class="nav-links">
      {LINKS.map((l) => (
        <a class:list={["navlink", { on: isCurrent(l.href) }]} href={l.href}
           aria-current={here === l.href ? "page" : undefined}>{l.label}</a>
      ))}
    </div>
    <a class="nav-cta" href="/demo">Get early access</a>
  </nav>
</header>

<style>
  .mast {
    display: flex; justify-content: space-between; align-items: stretch; gap: 20px;
    border-bottom: 1px solid var(--c-edge);
    position: sticky; top: 0; z-index: 60;
    background: var(--paper);
  }

  .lockup-pad { display: flex; align-items: center; padding: 0 var(--pad-x); }
  .lockup { display: flex; align-items: center; gap: 11px; text-decoration: none; }
  .wordmark {
    font-family: var(--font-serif); font-size: var(--t-title); font-weight: 600;
    letter-spacing: -0.025em; color: var(--ink); white-space: nowrap;
  }
  /* The beak warms on hover, the way it does on the homepage. */
  .lockup :global(svg rect:nth-of-type(2)) { transition: fill 0.16s ease; }
  .lockup:hover :global(svg rect:nth-of-type(2)) { fill: var(--terracotta-deep); }

  nav { display: flex; align-items: stretch; gap: 0; flex-wrap: wrap; }
  .nav-links {
    display: flex; align-items: center; gap: clamp(18px, 2.4vw, 34px); flex-wrap: wrap;
    padding: 14px clamp(18px, 2.4vw, 34px) 14px 0;
  }

  .navlink {
    position: relative;
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink-3); text-decoration: none;
    transition: color 0.16s ease;
    padding-block: var(--s-2);
  }
  .navlink::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 1.5px;
    background: var(--terracotta);
    transform: scaleX(0); transform-origin: left center;
    transition: transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .navlink:hover { color: var(--ink); }
  .navlink:hover::after, .navlink.on::after { transform: scaleX(1); }
  .navlink.on { color: var(--ink); }

  .nav-cta {
    display: inline-flex; align-items: center;
    background: var(--terracotta); color: var(--paper);
    font-family: var(--font-sans); font-size: var(--t-micro); font-weight: 600;
    letter-spacing: 0.02em; text-decoration: none;
    padding: 0 clamp(18px, 2.4vw, 30px);
    transition: background 0.16s ease;
  }
  .nav-cta:hover { background: var(--terracotta-deep); }

  .burger { display: none; }

  /* Below 720 the bundle drops its links and keeps the button, because the
     lockup and the button are the whole bar. Same here. */
  @media (max-width: 720px) {
    .lockup-pad { padding: var(--s-3) var(--s-4); }
    .burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 4px;
      width: 44px; margin-left: auto; padding: 0 10px; background: none; border: none; cursor: pointer;
    }
    .burger span { display: block; height: 1.5px; background: var(--ink); }
    nav { display: none; width: 100%; flex-direction: column; align-items: stretch;
          border-top: 1px solid var(--c-edge); }
    .mast[data-open] { flex-wrap: wrap; }
    .mast[data-open] nav { display: flex; }
    .nav-links { flex-direction: column; align-items: stretch; gap: 0; padding: 0 var(--s-4); }
    .navlink { padding-block: var(--s-3); border-bottom: var(--stroke-hairline); min-height: 44px;
               display: flex; align-items: center; }
    .navlink::after { display: none; }
    .nav-cta { margin: var(--s-4); justify-content: center; min-height: 44px; }
  }
  @media (max-width: 420px) { .wordmark { display: none; } }
</style>

<script>
  const mast = document.querySelector<HTMLElement>(".mast");
  const burger = mast?.querySelector<HTMLButtonElement>(".burger");
  burger?.addEventListener("click", () => {
    const open = mast!.hasAttribute("data-open");
    open ? mast!.removeAttribute("data-open") : mast!.setAttribute("data-open", "");
    burger.setAttribute("aria-expanded", String(!open));
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    mast?.removeAttribute("data-open");
    burger?.setAttribute("aria-expanded", "false");
  });
</script>
