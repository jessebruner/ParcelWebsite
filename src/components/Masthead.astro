---
import Mark from "./Mark.astro";
import { APP_URL } from "../data/site";
const links = [["/product", "Product"], ["/pricing", "Pricing"], ["/blog", "Guides"], ["/about", "About"]];
const path = Astro.url.pathname;
---
<header class="mast">
  <div class="page mast-inner">
    <a class="lockup" href="/" aria-label="Common Parcel home"><Mark size={32} /><span>Common Parcel</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu <span aria-hidden="true">＋</span></button>
    <nav id="site-nav" aria-label="Main navigation">
      {links.map(([href, label]) => <a href={href} aria-current={path === href || path.startsWith(`${href}/`) ? "page" : undefined}>{label}</a>)}
      <a class="nav-cta" href={APP_URL}>Get started <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<script>
  const mast = document.querySelector<HTMLElement>(".mast");
  const toggle = mast?.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = mast?.querySelector<HTMLElement>("#site-nav");
  if (mast && toggle && nav) {
    toggle.hidden = false;
    mast.classList.add("enhanced");
    function closeMenu(focus = false) {
      toggle!.setAttribute("aria-expanded", "false");
      if (focus) toggle!.focus();
    }
    toggle.addEventListener("click", () => toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true")));
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") closeMenu(true);
    });
    document.addEventListener("click", event => { if (!mast.contains(event.target as Node)) closeMenu(); });
    mast.addEventListener("focusout", event => { if (!mast.contains(event.relatedTarget as Node)) closeMenu(); });
    nav.addEventListener("click", event => { if ((event.target as HTMLElement).closest("a")) closeMenu(); });
    matchMedia("(min-width: 761px)").addEventListener("change", () => closeMenu());
  }
</script>
<style>
  .mast { border-bottom: var(--stroke-edge); background: var(--paper); position: relative; z-index: 20; }
  .mast-inner { min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  .lockup { display: flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; font-size: 23px; font-weight: 650; letter-spacing: -.05em; white-space: nowrap; }
  nav { display: flex; align-items: center; gap: 30px; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; color: var(--ink-2); text-decoration: none; font-size: 15px; font-weight: 550; }
  nav a:hover, nav a[aria-current] { color: var(--terracotta); text-decoration: underline; text-underline-offset: 6px; }
  nav .nav-cta { background: var(--terracotta); color: var(--paper); padding: 10px 20px; gap: 22px; }
  nav .nav-cta:hover { background: var(--terracotta-deep); color: var(--paper); text-decoration: none; }
  .menu-toggle { display: none; border: var(--stroke-edge); background: transparent; color: var(--ink); min-height: 44px; padding: 8px 12px; font: inherit; font-size: 15px; gap: 14px; align-items: center; }
  @media(max-width: 760px) {
    .mast-inner { min-height: 76px; flex-wrap: wrap; gap: 0; }
    .lockup { font-size: 21px; gap: 9px; }
    .lockup :global(svg) { width: 27px; }
    nav { width: 100%; flex-wrap: wrap; gap: 8px 24px; padding: 12px 0 20px; }
    .enhanced .menu-toggle { display: flex; }
    .enhanced .menu-toggle[aria-expanded="false"] + nav { display: none; }
    .enhanced nav { display: grid; gap: 0; padding-top: 16px; }
    .enhanced nav > a { padding: 12px 4px; border-top: var(--stroke-rule); font-size: 17px; }
    .enhanced nav > .nav-cta { padding: 12px 16px; margin-top: 12px; justify-content: space-between; }
  }
  @media(max-width: 360px) {
    .lockup { font-size: 18px; gap: 6px; }
    .lockup :global(svg) { width: 22px; }
    .menu-toggle { gap: 6px; padding-inline: 8px; }
  }
</style>
