---
/**
 * Global Masthead with Product & Company Dropdowns and Early Access CTA.
 *
 * Provides responsive navigation across desktop and mobile, with keyboard-accessible
 * mega menus for Product and Company.
 */
import Mark from "./Mark.astro";
import { PRODUCT_NAV, COMPANY_NAV } from "../data/routes";

const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const isCurrent = (href: string) => here === href;
const isProductActive = here.startsWith("/product");
const isCompanyActive = here === "/about" || here === "/why-common-parcel" || here === "/blog";
---

<header class="mast">
  <div class="lockup-pad">
    <a class="lockup" href="/">
      <Mark size={34} />
      <span class="wordmark">Common Parcel</span>
    </a>
  </div>

  <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>

  <nav id="nav" aria-label="Main navigation">
    <div class="nav-links">
      <!-- PRODUCT MEGA DROPDOWN -->
      <div class="nav-item has-dropdown">
        <button type="button" class:list={["navlink nav-btn", { on: isProductActive }]} aria-expanded="false">
          <span>Product</span>
          <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
        </button>
        <div class="dropdown-menu mega-menu">
          <div class="mega-menu-inner">
            {PRODUCT_NAV.map((p) => (
              <a href={p.path} class:list={["menu-item", { active: isCurrent(p.path) }]}>{p.label}</a>
            ))}
            <a href="/product" class:list={["menu-item", "menu-item--wide", { active: isCurrent("/product") }]}>Everything Common Parcel does</a>
            <a href="/security" class:list={["menu-item", "menu-item--wide", { active: isCurrent("/security") }]}>Security</a>
          </div>
        </div>
      </div>

      <!-- PRICING -->
      <div class="nav-item">
        <a class:list={["navlink", { on: isCurrent("/pricing") }]} href="/pricing" aria-current={here === "/pricing" ? "page" : undefined}>
          Pricing
        </a>
      </div>

      <!-- COMPANY DROPDOWN -->
      <div class="nav-item has-dropdown">
        <button type="button" class:list={["navlink nav-btn", { on: isCompanyActive }]} aria-expanded="false">
          <span>Company</span>
          <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
        </button>
        <div class="dropdown-menu standard-menu">
          <div class="menu-grid">
            {COMPANY_NAV.map((c) => (
              <a href={c.path} class:list={["menu-item", { active: isCurrent(c.path) }]}>{c.label}</a>
            ))}
          </div>
        </div>
      </div>

      <!-- CONTACT -->
      <div class="nav-item">
        <a class:list={["navlink", { on: isCurrent("/contact") }]} href="/contact" aria-current={here === "/contact" ? "page" : undefined}>
          Contact
        </a>
      </div>
    </div>

    <!-- CTA -->
    <button type="button" class="nav-cta" data-open-modal="early-access">
      Early Access
    </button>
  </nav>
</header>

<script>
  function initMasthead() {
    const mast = document.querySelector<HTMLElement>(".mast");
    if (!mast) return;

    const burger = mast.querySelector<HTMLButtonElement>(".burger");
    const dropdownBtns = mast.querySelectorAll<HTMLButtonElement>(".has-dropdown > .nav-btn");

    burger?.addEventListener("click", () => {
      const open = mast.hasAttribute("data-open");
      open ? mast.removeAttribute("data-open") : mast.setAttribute("data-open", "");
      burger.setAttribute("aria-expanded", String(!open));
    });

    const dropdownContainers = mast.querySelectorAll<HTMLElement>(".has-dropdown");

    /**
     * A panel is open for one of two reasons, and they close differently.
     *
     * Hovering opens it and moving away closes it. Clicking LATCHES it, and a
     * latched panel ignores the pointer entirely: it closes on a second click,
     * on Escape, or on a click outside the masthead. Before this, `mouseleave`
     * tore the panel down however it had been opened, so a clicked panel died
     * the moment the pointer left it.
     *
     * Clicking also could not open a panel at all on a desktop pointer. The
     * old handler asked whether the panel was already open, but `mouseenter`
     * fires as the pointer arrives on the button and opens it first, so by the
     * time the click landed the answer was always yes and the click closed
     * what the hover had just opened. Latching is tracked separately from
     * `.open` for exactly that reason.
     */
    const closeTimers = new WeakMap<HTMLElement, number>();

    const shut = (el: Element) => {
      el.removeAttribute("data-latched");
      el.classList.remove("open");
      el.querySelector(".nav-btn")?.setAttribute("aria-expanded", "false");
    };

    dropdownContainers.forEach((container) => {
      const btn = container.querySelector<HTMLButtonElement>(".nav-btn");

      container.addEventListener("mouseenter", () => {
        if (window.innerWidth > 860) {
          const pending = closeTimers.get(container);
          if (pending) { window.clearTimeout(pending); closeTimers.delete(container); }
          container.classList.add("open");
          btn?.setAttribute("aria-expanded", "true");
        }
      });

      container.addEventListener("mouseleave", () => {
        if (window.innerWidth > 860) {
          if (container.hasAttribute("data-latched")) return;
          const pending = closeTimers.get(container);
          if (pending) window.clearTimeout(pending);
          // A short grace period. Leaving a menu by a diagonal path clips the
          // corner of a neighbouring element on the way, and an instant close
          // makes the menu feel like it is running away from the pointer.
          closeTimers.set(container, window.setTimeout(() => {
            closeTimers.delete(container);
            container.classList.remove("open");
            btn?.setAttribute("aria-expanded", "false");
          }, 220));
        }
      });
    });

    dropdownBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const parent = btn.closest<HTMLElement>(".has-dropdown");
        if (!parent) return;
        const wasLatched = parent.hasAttribute("data-latched");

        mast.querySelectorAll(".has-dropdown").forEach((el) => {
          if (el !== parent) shut(el);
        });

        if (wasLatched) {
          shut(parent);
        } else {
          parent.setAttribute("data-latched", "");
          parent.classList.add("open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    // Close on escape or outside click
    document.addEventListener("click", (e) => {
      if (!mast.contains(e.target as Node)) {
        mast.querySelectorAll(".has-dropdown").forEach(shut);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        mast.removeAttribute("data-open");
        burger?.setAttribute("aria-expanded", "false");
        mast.querySelectorAll(".has-dropdown").forEach(shut);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMasthead);
  } else {
    initMasthead();
  }
</script>
