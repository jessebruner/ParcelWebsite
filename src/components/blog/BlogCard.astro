---
/**
 * BlogCard component.
 *
 * Renders an article card on the /blog index grid.
 */
import { readingMinutes, type BlogPost } from "../../data/blog";
import BlogHeaderArt from "./BlogHeaderArt.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="blog-card">
  <a href={`/blog/${post.slug}`} class="blog-card-media-link" tabindex="-1" aria-hidden="true">
    <BlogHeaderArt subject={post.artSubject} mode="card" />
  </a>
  <div class="blog-card-content">
    <div class="blog-card-meta">
      <span class="blog-category t-mono-label">{post.category}</span>
      <span class="meta-separator" aria-hidden="true">·</span>
      <span class="blog-time t-mono-label">{readingMinutes(post)} min</span>
    </div>
    <h2 class="blog-card-title">
      <a href={`/blog/${post.slug}`} class="blog-title-link">
        {post.title}
      </a>
    </h2>
    <p class="blog-card-desc">
      {post.description}
    </p>
    <div class="blog-card-footer">
      <span class="author-name">{post.author.name}</span>
      <time datetime={post.publishedAt} class="published-date t-mono-label">
        {post.publishedAt}
      </time>
    </div>
  </div>
</article>

<style>
  .blog-card {
    background: var(--card);
    border: var(--stroke-consequence);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .blog-card:hover {
    border-color: var(--terracotta);
  }
  .blog-card-media-link {
    display: block;
    text-decoration: none;
  }
  .blog-card-content {
    padding: clamp(20px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
  }
  .blog-category {
    color: var(--terracotta);
  }
  .meta-separator {
    color: var(--ink-3);
  }
  .blog-time {
    color: var(--ink-3);
  }
  .blog-card-title {
    font-family: var(--font-serif);
    font-size: var(--t-title);
    font-weight: 600;
    line-height: 1.28;
    margin: 0 0 var(--s-3);
  }
  .blog-title-link {
    color: var(--ink);
    text-decoration: none;
  }
  .blog-title-link:hover {
    color: var(--terracotta);
    text-decoration: underline;
  }
  .blog-card-desc {
    font-family: var(--font-sans);
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 var(--s-6);
    flex-grow: 1;
  }
  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: var(--stroke-rule);
    padding-top: var(--s-3);
    margin-top: auto;
    font-size: var(--t-micro);
  }
  .author-name {
    font-weight: 600;
    color: var(--ink);
  }
  .published-date {
    color: var(--ink-3);
  }
</style>
