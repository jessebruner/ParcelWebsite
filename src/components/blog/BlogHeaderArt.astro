---
/**
 * Article-specific editorial art.
 *
 * The first blog pass changed only a seed inside the same parcel grid. Every
 * article therefore looked like the same article in a different sky. These
 * are six authored diagrams: the picture names the work before the title has
 * to. They are deterministic SVG geometry, use only site tokens, and carry no
 * synthetic product screenshot or factual data.
 */
export type BlogArtSubject = "meeting" | "handoff" | "records" | "budget" | "renewal" | "payments";

interface Props {
  subject: BlogArtSubject;
  mode?: "hero" | "card";
  class?: string;
}

const { subject, mode = "hero", class: className } = Astro.props;
---

<div class:list={["blog-art", mode, `subject-${subject}`, className]} aria-hidden="true">
  <svg viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg" class="blog-art-svg">
    <rect width="600" height="300" class="art-night" />
    <rect y="0" width="600" height="54" class="art-sky" />
    <rect y="54" width="600" height="8" class="art-horizon" />
    <circle cx="544" cy="30" r="13" class="art-moon" />

    {subject === "meeting" && (
      <g class="meeting-art">
        <rect x="88" y="111" width="424" height="105" class="surface" />
        <rect x="228" y="132" width="144" height="62" class="paper" />
        <path d="M248 151h104M248 166h76" class="ink-line" />
        <rect x="114" y="83" width="50" height="25" class="chair" />
        <rect x="190" y="83" width="50" height="25" class="chair warm" />
        <rect x="266" y="83" width="50" height="25" class="chair" />
        <rect x="342" y="83" width="50" height="25" class="chair warm" />
        <rect x="418" y="83" width="50" height="25" class="chair" />
        <rect x="114" y="219" width="50" height="25" class="chair warm" />
        <rect x="190" y="219" width="50" height="25" class="chair" />
        <rect x="266" y="219" width="50" height="25" class="chair warm" />
        <rect x="342" y="219" width="50" height="25" class="chair" />
        <rect x="418" y="219" width="50" height="25" class="chair warm" />
        <path d="M65 265h470" class="baseline" />
        <rect x="468" y="132" width="20" height="20" class="ballot" />
        <path d="m472 142 5 5 8-11" class="check" />
      </g>
    )}

    {subject === "handoff" && (
      <g class="handoff-art">
        <rect x="64" y="91" width="174" height="145" class="cabinet" />
        <rect x="362" y="91" width="174" height="145" class="cabinet" />
        <path d="M64 139h174M64 187h174M362 139h174M362 187h174" class="cabinet-line" />
        <path d="M132 115h38M430 115h38M132 163h38M430 163h38M132 211h38M430 211h38" class="handle" />
        <path d="M245 162h103M322 140l26 22-26 22" class="transfer" />
        <rect x="267" y="113" width="55" height="68" class="paper" />
        <path d="M278 130h33M278 143h26M278 156h31" class="ink-line" />
        <rect x="78" y="248" width="64" height="18" class="key" />
        <rect x="458" y="248" width="64" height="18" class="key warm" />
      </g>
    )}

    {subject === "records" && (
      <g class="records-art">
        <rect x="71" y="88" width="252" height="160" class="cabinet" />
        <path d="M71 128h252M71 168h252M71 208h252" class="cabinet-line" />
        <path d="M168 108h58M168 148h58M168 188h58M168 228h58" class="handle" />
        <rect x="354" y="78" width="174" height="197" class="paper" />
        <path d="M378 108h126M378 127h92M378 164h126M378 183h108M378 220h85" class="ink-line" />
        <rect x="378" y="145" width="18" height="18" class="stamp" />
        <path d="m382 154 4 4 7-10" class="check" />
        <circle cx="111" cy="111" r="18" class="lens" />
        <path d="m124 124 23 23" class="lens-handle" />
      </g>
    )}

    {subject === "budget" && (
      <g class="budget-art">
        <rect x="62" y="82" width="476" height="176" class="ledger" />
        <path d="M220 82v176M62 126h476M62 170h476M62 214h476" class="ledger-line" />
        <path d="M83 104h95M83 148h108M83 192h72M83 236h118" class="ink-line" />
        <path d="M250 104h72M250 148h112M250 192h90M250 236h134" class="money-line" />
        <path d="M428 236v-41h25v41M466 236v-72h25v72" class="bars" />
        <path d="m408 107 13 13 24-29" class="check large" />
      </g>
    )}

    {subject === "renewal" && (
      <g class="renewal-art">
        <rect x="73" y="79" width="250" height="183" class="calendar" />
        <path d="M73 123h250M123 123v139M173 123v139M223 123v139M273 123v139M73 169h250M73 215h250" class="calendar-line" />
        <rect x="227" y="172" width="42" height="40" class="date-hot" />
        <rect x="354" y="92" width="172" height="154" class="paper" />
        <path d="M378 120h124M378 140h97M378 184h124M378 204h78" class="ink-line" />
        <path d="M353 226h174" class="renewal-rule" />
        <circle cx="496" cy="226" r="9" class="seal" />
      </g>
    )}

    {subject === "payments" && (
      <g class="payments-art">
        <rect x="51" y="101" width="123" height="139" class="paper" />
        <path d="M72 128h81M72 147h61M72 188h81M72 207h38" class="ink-line" />
        <path d="M183 170h59M225 153l17 17-17 17" class="transfer" />
        <rect x="255" y="105" width="90" height="58" class="approval" />
        <rect x="255" y="179" width="90" height="58" class="approval warm" />
        <path d="m277 133 9 9 18-22M277 207l9 9 18-22" class="check" />
        <path d="M356 170h54M393 153l17 17-17 17" class="transfer" />
        <path d="M426 129h129M439 129v99M542 129v99M418 228h145M440 108l51-29 51 29z" class="bank" />
        <path d="M464 146v60M491 146v60M518 146v60" class="bank" />
      </g>
    )}
  </svg>
</div>

<style>
  .blog-art {
    display: block; width: 100%; overflow: hidden;
    background: var(--night); border: var(--stroke-rule);
  }
  .blog-art.hero { height: clamp(220px, 28vw, 360px); border-bottom: 2px solid var(--terracotta); }
  .blog-art.card { height: 190px; border-bottom: 1px solid var(--c-edge); }
  .blog-art-svg { display: block; width: 100%; height: 100%; shape-rendering: crispEdges; }

  .art-night { fill: var(--night); }
  .art-sky { fill: var(--plum); }
  .art-horizon { fill: var(--rose); }
  .art-moon { fill: var(--sand); }
  .surface, .cabinet, .ledger, .calendar { fill: var(--on-dark-tile-edge); stroke: var(--on-dark-label); stroke-width: 2; }
  .paper { fill: var(--paper); stroke: var(--bisque-edge); stroke-width: 2; }
  .ink-line { fill: none; stroke: var(--terracotta); stroke-width: 4; }
  .baseline { fill: none; stroke: var(--rose); stroke-width: 2; }
  .chair, .key, .approval { fill: var(--slate); stroke: var(--on-dark-label); stroke-width: 2; }
  .warm, .date-hot { fill: var(--amber); stroke: var(--amber-edge); stroke-width: 2; }
  .ballot, .stamp { fill: var(--paper); stroke: var(--terracotta); stroke-width: 2; }
  .check { fill: none; stroke: var(--terracotta); stroke-width: 4; }
  .check.large { stroke: var(--amber); stroke-width: 6; }
  .cabinet-line, .ledger-line, .calendar-line { fill: none; stroke: var(--on-dark-label); stroke-width: 2; }
  .handle { fill: none; stroke: var(--amber); stroke-width: 4; }
  .transfer { fill: none; stroke: var(--sand); stroke-width: 5; }
  .lens { fill: var(--night); stroke: var(--sand); stroke-width: 5; }
  .lens-handle { fill: none; stroke: var(--sand); stroke-width: 7; }
  .money-line { fill: none; stroke: var(--sand); stroke-width: 5; }
  .bars { fill: var(--rose); stroke: var(--amber); stroke-width: 2; }
  .renewal-rule { fill: none; stroke: var(--terracotta); stroke-width: 5; }
  .seal { fill: var(--amber); stroke: var(--sand); stroke-width: 2; }
  .bank { fill: none; stroke: var(--sand); stroke-width: 5; }
</style>
