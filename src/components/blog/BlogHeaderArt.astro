---
/** Six original vector illustrations: readable at card size, with no stock or synthetic UI imagery. */
export type BlogArtSubject = "meeting" | "handoff" | "records" | "budget" | "renewal" | "payments";
interface Props { subject: BlogArtSubject; mode?: "hero" | "card"; class?: string; }
const { subject, mode = "hero", class: className } = Astro.props;
const grainId = `paper-${subject}-${mode}`;
---
<div class:list={["blog-art", mode, `subject-${subject}`, className]} aria-hidden="true">
  <svg viewBox="0 0 720 440" xmlns="http://www.w3.org/2000/svg">
    <defs><pattern id={grainId} width="32" height="32" patternUnits="userSpaceOnUse"><circle cx="3" cy="8" r=".8" fill="#302D35" opacity=".1"/><circle cx="21" cy="25" r=".6" fill="#302D35" opacity=".14"/></pattern></defs>
    <rect width="720" height="440" fill={subject === "meeting" || subject === "records" ? "#DCE1D6" : "#F0E1CB"} />
    <circle cx="618" cy="55" r="164" fill={subject === "meeting" || subject === "records" ? "#C7D0C3" : "#E4C6AA"} />
    <path d="M0 340H720V440H0Z" fill={subject === "budget" || subject === "handoff" ? "#C7B69C" : "#C1C4B3"} />
    <path d="M0 340H720" stroke="#302D35" stroke-opacity=".13" />
    {subject === "budget" && <g>
      <path d="M76 330 390 376 600 326 275 289Z" fill="#302D35" opacity=".13" />
      <g transform="translate(112 84) rotate(-7 182 130)">
        <path d="M0 22 166 4 166 265 0 284Z" fill="#FDF8ED" stroke="#C7B69C" stroke-width="2"/>
        <path d="M166 4 338 28 338 283 166 265Z" fill="#F8F0DF" stroke="#C7B69C" stroke-width="2"/>
        <path d="M166 4V265" stroke="#AC9C84" stroke-width="3"/>
        <path d="M26 53 137 40M26 66 96 58" stroke="#A65337" stroke-width="6"/>
        {[100,132,164,196,228].map(y => <path d={`M26 ${y} 140 ${y-10}M188 ${y-6} 311 ${y+10}`} stroke="#C7B69C" stroke-width="2"/>)}
        <path d="M190 60 299 75" stroke="#47574D" stroke-width="6"/>
        <path d="M211 223V168H233V226M248 229V135H270V232M285 233V110H307V236" fill="#47574D"/>
        <path d="m151 18 9-1v73l-5-7-4 8Z" fill="#A65337"/>
      </g>
      <g transform="translate(490 163) rotate(10 58 91)">
        <rect x="6" y="8" width="119" height="183" rx="6" fill="#302D35" opacity=".18"/>
        <rect width="119" height="183" rx="6" fill="#292C3A"/>
        <rect x="14" y="16" width="91" height="36" rx="2" fill="#B5C0AA"/>
        <path d="M64 32h27M80 41h11" stroke="#47574D" stroke-width="4"/>
        {[0,1,2,3].map(row => [0,1,2].map(col => <rect x={14+col*32} y={67+row*26} width="25" height="18" rx="2" fill={col===2 && row===3 ? "#C7835B" : "#ECE5D8"} />))}
      </g>
      <g fill="#C79B4B" stroke="#A87D34" stroke-width="2"><path d="M446 346v22c0 14 60 14 60 0v-22"/><ellipse cx="476" cy="346" rx="30" ry="10"/><path d="M446 357c0 13 60 13 60 0"/></g>
    </g>}
    {subject === "renewal" && <g>
      <path d="M114 348 367 385 595 344 320 308Z" fill="#302D35" opacity=".12"/>
      <g transform="translate(109 78) rotate(-5 138 144)">
        <path d="M12 16h276v277H12Z" fill="#A65337"/>
        <rect width="272" height="280" rx="3" fill="#FDF8ED"/>
        <path d="M0 0h272v67H0Z" fill="#A65337"/>
        <path d="M36 29h97" stroke="#F0E1CB" stroke-width="8"/>
        {[50,222].map(x => <path d={`M${x} -10v28`} stroke="#292C3A" stroke-width="9" stroke-linecap="round"/>)}
        {[0,1,2,3].map(row => [0,1,2,3,4].map(col => <rect x={28+col*46} y={94+row*40} width="18" height="5" rx="1" fill="#747365" opacity={row===0 && col<2 ? ".3" : "1"}/>))}
        <circle cx="175" cy="177" r="26" fill="none" stroke="#A65337" stroke-width="5"/>
        <path d="m162 177 9 9 18-22" fill="none" stroke="#A65337" stroke-width="4"/>
      </g>
      <g transform="translate(404 154) rotate(8 100 105)">
        <rect x="8" y="8" width="177" height="210" fill="#302D35" opacity=".12"/><rect width="177" height="210" fill="#F8F0DF"/>
        <path d="m32 57 55-38 55 38M45 48v51h84V48M80 99V73h18v26" fill="none" stroke="#47574D" stroke-width="5"/>
        <path d="M27 127h122M27 145h96M27 163h114" stroke="#BAAD97" stroke-width="4"/>
        <circle cx="143" cy="190" r="28" fill="#47574D"/><path d="m130 190 9 9 19-22" fill="none" stroke="#F8F0DF" stroke-width="4"/>
      </g>
    </g>}
    {subject === "payments" && <g>
      <path d="M90 339 385 393 625 340 300 299Z" fill="#302D35" opacity=".12"/>
      <g transform="translate(135 62) rotate(-7 126 150)">
        <path d="M15 13h247v295l-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8Z" fill="#D5C6AF"/>
        <path d="M0 0h246v294l-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-14-8-14 8-22-8Z" fill="#FDF8ED"/>
        <path d="M27 36h100M27 53h62" stroke="#A65337" stroke-width="6"/>
        <path d="M27 89h192M27 125h192M27 161h192M27 197h192" stroke="#C7B69C" stroke-width="2"/>
        <path d="M28 106h87M177 106h40M28 142h104M182 142h35M28 178h72M170 178h47" stroke="#747365" stroke-width="5"/>
        <path d="M144 236h73" stroke="#292C3A" stroke-width="10"/>
      </g>
      <g transform="translate(351 251) rotate(9 130 70)"><rect width="239" height="139" fill="#A65337"/><path d="m0 0 119 83L239 0" fill="#C7835B"/><path d="m0 139 91-71M239 139l-91-71" stroke="#89452E" stroke-width="2"/></g>
      <g transform="translate(497 130)"><circle r="43" fill="#47574D"/><path d="m-20 0 14 14 28-33" fill="none" stroke="#FDF8ED" stroke-width="6"/></g>
      <g transform="translate(555 205) rotate(26)"><path d="M0 0h13v123H0Z" fill="#292C3A"/><path d="m0 123 6.5 20 6.5-20" fill="#C79B4B"/><path d="M3 8v31" stroke="#F0E1CB" stroke-width="2"/></g>
    </g>}
    {subject === "meeting" && <g>
      <g fill="#A65337" stroke="#89452E" stroke-width="2">
        <rect x="162" y="48" width="94" height="73" rx="22"/><rect x="304" y="48" width="94" height="73" rx="22"/><rect x="446" y="48" width="94" height="73" rx="22"/>
        <rect x="162" y="320" width="94" height="73" rx="22"/><rect x="304" y="320" width="94" height="73" rx="22"/><rect x="446" y="320" width="94" height="73" rx="22"/>
      </g>
      <rect x="79" y="111" width="569" height="238" rx="76" fill="#302D35" opacity=".14"/>
      <rect x="68" y="99" width="569" height="238" rx="76" fill="#47574D"/>
      <rect x="81" y="112" width="543" height="211" rx="64" fill="none" stroke="#8C9B82" stroke-width="2"/>
      <g transform="translate(281 146) rotate(-6 80 69)"><rect x="7" y="6" width="150" height="149" fill="#302D35" opacity=".25"/><rect width="150" height="149" fill="#FDF8ED"/><path d="M22 29h93" stroke="#A65337" stroke-width="7"/><path d="M22 56h105M22 78h105M22 100h79M22 122h94" stroke="#C7B69C" stroke-width="4"/></g>
      <g transform="translate(150 165) rotate(8)"><rect width="75" height="98" fill="#E4C6AA"/><path d="M13 22h46M13 39h40M13 56h46" stroke="#A65337" stroke-width="3"/></g>
      <g fill="#C79B4B"><circle cx="523" cy="226" r="32"/><rect x="547" y="213" width="22" height="24" rx="9"/></g><circle cx="523" cy="226" r="22" fill="#503D30"/><path d="M512 217q8-10 19 0" fill="none" stroke="#C7835B" stroke-width="3"/>
      <path d="m443 168 12-3 30 112-12 3Z" fill="#C79B4B"/>
    </g>}
    {subject === "handoff" && <g>
      <path d="M97 341 329 390 600 349 357 296Z" fill="#302D35" opacity=".13"/>
      <g transform="translate(104 89) rotate(-5 160 130)">
        <path d="M0 54V15h113l20 26h184v216H0Z" fill="#47574D"/>
        <path d="M30 16h242v226H30Z" fill="#DDD2BC"/><path d="M46 3h242v229H46Z" fill="#FDF8ED"/>
        <path d="M72 38h137M72 59h97" stroke="#A65337" stroke-width="6"/><path d="M72 90h186M72 114h186" stroke="#C7B69C" stroke-width="3"/>
        <path d="M0 125h122l20-20h178v163H0Z" fill="#788670"/>
        <rect x="96" y="171" width="125" height="50" fill="#E4E5D6"/><path d="M113 191h89M128 204h58" stroke="#47574D" stroke-width="4"/>
      </g>
      <g transform="translate(482 200) rotate(-27)">
        <circle r="46" fill="none" stroke="#A87D34" stroke-width="15"/><circle r="46" fill="none" stroke="#D7B66C" stroke-width="7"/>
        <path d="M-5 44h22v130h-17v-24h-18v-17h18v-22h-5Z" fill="#C79B4B"/><path d="M4 59v61" stroke="#E8CE92" stroke-width="4"/>
        <g transform="translate(43 12) rotate(-34)"><rect x="-6" y="24" width="62" height="78" rx="10" fill="#A65337"/><path d="m4 65 20-17 20 17M11 61v27h26V61" stroke="#F0E1CB" stroke-width="3" fill="none"/><circle cx="25" cy="37" r="4" fill="#F0E1CB"/></g>
      </g>
    </g>}
    {subject === "records" && <g>
      <path d="M100 349 313 390 620 346 347 289Z" fill="#302D35" opacity=".13"/>
      <path d="M116 174h329l37 166H82Z" fill="#47574D"/>
      <g transform="rotate(-9 263 181)"><rect x="169" y="67" width="210" height="220" fill="#DDD2BC"/><rect x="185" y="52" width="210" height="220" fill="#FDF8ED"/><path d="M212 85h111M212 105h73" stroke="#A65337" stroke-width="6"/><path d="M212 139h154M212 163h154M212 187h124M212 211h145" stroke="#C7B69C" stroke-width="4"/></g>
      <path d="M92 240h137l18-21h239v135H92Z" fill="#788670"/>
      <rect x="209" y="274" width="145" height="45" fill="#E4E5D6"/><path d="M232 291h100M247 304h69" stroke="#47574D" stroke-width="4"/>
      <g transform="translate(488 161) rotate(-32)">
        <path d="M-10 56h20v139h-20Z" fill="#292C3A"/><path d="M-6 96h12v88H-6Z" fill="#A65337"/>
        <circle r="66" fill="#E4E5D6" stroke="#292C3A" stroke-width="12"/><circle r="51" fill="#FDF8ED"/>
        <path d="m-33 0 33-27L33 0M-25-6v37h50V-6M-7 31V10H7v21" fill="none" stroke="#47574D" stroke-width="4"/>
        <path d="M-40-26q10-17 30-19" fill="none" stroke="#C7D0C3" stroke-width="4"/>
      </g>
    </g>}
    <rect width="720" height="440" fill={`url(#${grainId})`} pointer-events="none" />
  </svg>
</div>
<style>
  .blog-art { display: block; width: 100%; overflow: hidden; background: #F0E1CB; }
  .blog-art svg { display: block; width: 100%; height: 100%; }
  .card { aspect-ratio: 18 / 11; border-bottom: var(--stroke-edge); }
  .hero { aspect-ratio: 18 / 11; border: var(--stroke-edge); }
</style>
