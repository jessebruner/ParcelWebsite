---
/**
 * Procedural Blog Header and Thumbnail Artwork.
 *
 * Emits deterministic geometric compositions in the Common Parcel design language
 * (PixelSky dusk/dawn gradients, plat grids, token palettes).
 *
 * No external stock photos. Byte-for-byte reproducible per seed.
 */
interface Props {
  seed?: number;
  scene?: "dusk" | "dawn";
  mode?: "hero" | "card";
  class?: string;
}

const { seed = 101, scene = "dusk", mode = "hero", class: className } = Astro.props;

// Seeded deterministic pseudo-random number generator (Linear Congruential Generator)
function createPrng(s: number) {
  let current = Math.abs(s) % 2147483647;
  if (current === 0) current = 1;
  return () => {
    current = (current * 48271) % 2147483647;
    return (current - 1) / 2147483646;
  };
}

const prng = createPrng(seed);

const duskPalette = ["#171326", "#634468", "#966073", "#DE9B7E", "#F4CB9F", "#8A4B2A", "#C96A3D", "#E8D5C2"];
const dawnPalette = ["#20293B", "#546177", "#966073", "#DE9B7E", "#F4CB9F", "#DED6C6", "#C96A3D", "#FBF8F4"];
const palette = scene === "dawn" ? dawnPalette : duskPalette;

const width = mode === "hero" ? 1200 : 600;
const height = mode === "hero" ? 380 : 300;

// Generate deterministic plat parcels and skyline bands
const numBands = 5;
const bandHeight = height / numBands;
const bands = Array.from({ length: numBands }, (_, i) => ({
  y: i * bandHeight,
  h: bandHeight,
  color: palette[i % palette.length],
}));

// Generate grid lot matrices
const gridCols = mode === "hero" ? 12 : 8;
const gridRows = mode === "hero" ? 4 : 3;
const cellW = (width - 80) / gridCols;
const cellH = (height - 80) / gridRows;

const parcels = [];
for (let r = 0; r < gridRows; r++) {
  for (let c = 0; c < gridCols; c++) {
    const val = prng();
    if (val > 0.45) {
      parcels.push({
        x: 40 + c * cellW + 4,
        y: 40 + r * cellH + 4,
        w: cellW - 8,
        h: cellH - 8,
        fill: val > 0.85 ? "#E8A87C" : val > 0.7 ? "#8A4B2A" : "#3A342D",
        stroke: val > 0.85 ? "#C4855C" : "#5C544A",
        opacity: val > 0.85 ? 0.95 : 0.65,
      });
    }
  }
}
---

<div class:list={["blog-art", mode, className]} aria-hidden="true">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
    class="blog-art-svg"
  >
    <!-- Background dusk / dawn bands -->
    {bands.map((b) => (
      <rect x="0" y={b.y} width={width} height={b.h} fill={b.color} />
    ))}

    <!-- Subdued grid matrix -->
    <g stroke="rgba(251, 248, 244, 0.08)" stroke-width="1">
      {Array.from({ length: gridCols + 1 }).map((_, i) => (
        <line x1={40 + i * cellW} y1="30" x2={40 + i * cellW} y2={height - 30} />
      ))}
      {Array.from({ length: gridRows + 1 }).map((_, i) => (
        <line x1="30" y1={40 + i * cellH} x2={width - 30} y2={40 + i * cellH} />
      ))}
    </g>

    <!-- Plat parcels -->
    {parcels.map((p) => (
      <rect
        x={p.x}
        y={p.y}
        width={p.w}
        height={p.h}
        fill={p.fill}
        stroke={p.stroke}
        stroke-width="1.5"
        fill-opacity={p.opacity}
      />
    ))}

    <!-- Framing baseline and accents -->
    <line x1="0" y1={height - 1} x2={width} y2={height - 1} stroke="var(--terracotta)" stroke-width="2" />
    <circle cx={mode === "hero" ? width - 80 : width - 50} cy={60} r={mode === "hero" ? 28 : 18} fill="#F4CB9F" fill-opacity="0.85" />
  </svg>
</div>

<style>
  .blog-art {
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--night);
    border: var(--stroke-rule);
  }
  .blog-art.hero {
    height: clamp(200px, 28vw, 340px);
    border-bottom: 2px solid var(--terracotta);
  }
  .blog-art.card {
    height: 180px;
    border-bottom: 1px solid var(--c-edge);
  }
  .blog-art-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
