---
/**
 * Procedural Blog Header and Thumbnail Artwork.
 *
 * Emits deterministic geometric compositions in the Common Parcel design language
 * (PixelSky dusk/dawn gradients, plat grids, token palettes).
 *
 * No external stock photos. Byte-for-byte reproducible per seed.
 */
interface Props {
  seed?: number;
  scene?: "dusk" | "dawn";
  mode?: "hero" | "card";
  class?: string;
}

const { seed = 101, scene = "dusk", mode = "hero", class: className } = Astro.props;

// Seeded deterministic pseudo-random number generator (Linear Congruential Generator)
function createPrng(s: number) {
  let current = Math.abs(s) % 2147483647;
  if (current === 0) current = 1;
  return () => {
    current = (current * 48271) % 2147483647;
    return (current - 1) / 2147483646;
  };
}

const prng = createPrng(seed);

const duskPalette = [
  "var(--night)",
  "var(--plum)",
  "var(--rose)",
  "var(--ember)",
  "var(--sand)",
  "var(--terracotta)",
  "var(--clay)",
  "var(--bisque)",
];
const dawnPalette = [
  "var(--cold)",
  "var(--slate)",
  "var(--rose)",
  "var(--ember)",
  "var(--sand)",
  "var(--mist)",
  "var(--clay)",
  "var(--paper)",
];
const palette = scene === "dawn" ? dawnPalette : duskPalette;

const width = mode === "hero" ? 1200 : 600;
const height = mode === "hero" ? 380 : 300;

// Generate deterministic plat parcels and skyline bands
const numBands = 5;
const bandHeight = height / numBands;
const bands = Array.from({ length: numBands }, (_, i) => ({
  y: i * bandHeight,
  h: bandHeight,
  color: palette[i % palette.length],
}));

// Generate grid lot matrices
const gridCols = mode === "hero" ? 12 : 8;
const gridRows = mode === "hero" ? 4 : 3;
const cellW = (width - 80) / gridCols;
const cellH = (height - 80) / gridRows;

const parcels = [];
for (let r = 0; r < gridRows; r++) {
  for (let c = 0; c < gridCols; c++) {
    const val = prng();
    if (val > 0.45) {
      parcels.push({
        x: 40 + c * cellW + 4,
        y: 40 + r * cellH + 4,
        w: cellW - 8,
        h: cellH - 8,
        fill: val > 0.85 ? "var(--amber)" : val > 0.7 ? "var(--terracotta)" : "var(--on-dark-tile-edge)",
        stroke: val > 0.85 ? "var(--amber-edge)" : "var(--on-dark-tile)",
        opacity: val > 0.85 ? 0.95 : 0.65,
      });
    }
  }
}
---

<div class:list={["blog-art", mode, className]} aria-hidden="true">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid slice"
    class="blog-art-svg"
  >
    {/*
      EVERY TOKEN GOES IN style, NOT IN fill OR stroke.

      A presentation attribute is not a declaration. MDN's own sentence about
      them is "Presentation attribute values are parsed as CSS values, not
      declarations", and var() substitution is defined over declarations, so
      fill="var(--night)" is not substituted: the attribute is invalid and fill
      falls back to its initial value, which is black. A style attribute holds
      real declarations and var() resolves there.

      This file briefly had the tokens in the attributes because I told
      Antigravity that form worked. It does not, and none of us has a browser
      to notice a page of black rectangles, so the safe form is the one that is
      unambiguous rather than the one that is shorter.
    */}

    <!-- Background dusk / dawn bands -->
    {bands.map((b) => (
      <rect x="0" y={b.y} width={width} height={b.h} style={`fill:${b.color}`} />
    ))}

    <!-- Subdued grid matrix -->
    <g style="stroke:var(--night-hover);stroke-width:1">
      {Array.from({ length: gridCols + 1 }).map((_, i) => (
        <line x1={40 + i * cellW} y1="30" x2={40 + i * cellW} y2={height - 30} />
      ))}
      {Array.from({ length: gridRows + 1 }).map((_, i) => (
        <line x1="30" y1={40 + i * cellH} x2={width - 30} y2={40 + i * cellH} />
      ))}
    </g>

    <!-- Plat parcels -->
    {parcels.map((p) => (
      <rect
        x={p.x}
        y={p.y}
        width={p.w}
        height={p.h}
        style={`fill:${p.fill};stroke:${p.stroke};stroke-width:1.5;fill-opacity:${p.opacity}`}
      />
    ))}

    <!-- Framing baseline and accents -->
    <line x1="0" y1={height - 1} x2={width} y2={height - 1} style="stroke:var(--terracotta);stroke-width:2" />
    <circle cx={mode === "hero" ? width - 80 : width - 50} cy={60} r={mode === "hero" ? 28 : 18} style="fill:var(--sand);fill-opacity:0.85" />
  </svg>
</div>

<style>
  .blog-art {
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--night);
    border: var(--stroke-rule);
  }
  .blog-art.hero {
    height: clamp(200px, 28vw, 340px);
    border-bottom: 2px solid var(--terracotta);
  }
  .blog-art.card {
    height: 180px;
    border-bottom: 1px solid var(--c-edge);
  }
  .blog-art-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
