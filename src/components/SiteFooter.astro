---
import Mark from "./Mark.astro";
import { LEGAL } from "../data/routes";
import "../styles/site-footer.css";

interface Props { reviewed?: string; }
const { reviewed } = Astro.props;
const epoch = process.env.SOURCE_DATE_EPOCH ? parseInt(process.env.SOURCE_DATE_EPOCH, 10) * 1000 : Date.now();
const year = new Date(epoch).getUTCFullYear();

/**
 * ONE FOOTER. The homepage bundle is served this component's own markup by
 * tools/sync-homepage-masthead.mjs, the way it is already served the masthead,
 * so the styles live in a plain stylesheet and every class is prefixed. The
 * homepage used to end in a bundle-owned footer whose only links were three
 * same-page anchors, which meant the site's most-visited page linked to
 * neither the privacy policy nor the terms.
 */
const cols = [
  {
    head: "Platform",
    links: [
      { path: "/product", label: "Product" },
      { path: "/pricing", label: "Pricing" },
      { path: "/security", label: "Security" },
    ],
  },
  {
    head: "Company",
    links: [
      { path: "/about", label: "About" },
      { path: "/why-common-parcel", label: "Why Common Parcel" },
      { path: "/blog", label: "Blog" },
      { path: "/contact", label: "Contact" },
    ],
  },
  {
    head: "Legal",
    links: LEGAL,
  },
];
---
<footer class="site-footer">
  <div class="page sf-inner">
    <div>
      <span class="sf-lockup"><Mark size={38} fill="var(--paper)" beak="var(--amber)" /><span>Common Parcel</span></span>
      <p class="sf-addr">1420 Washington Blvd, Ste 301<br />Detroit, MI 48226</p>
      <a class="sf-mail" href="mailto:jesse@commonparcel.com">jesse@commonparcel.com</a>
    </div>
    <div class="sf-cols">
      {cols.map(c => (
        <div>
          <p class="sf-head">{c.head}</p>
          <ul>{c.links.map(l => <li><a href={l.path}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </div>
  <div class="page sf-baseline">
    <span>Common Parcel {year} · Made in Detroit</span>
    <span class="sf-legal">{LEGAL.map(l => <a href={l.path}>{l.label}</a>)}</span>
    {reviewed && <span>Reviewed {reviewed}</span>}
  </div>
</footer>
