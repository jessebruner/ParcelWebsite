---
/** Procedural landscape art. Painted once when near the viewport. */
export type SceneKey = "dusk" | "dawn" | "winter" | "street" | "storm" | "autumn" | "hilltop";

interface Props {
  mode?: "texture" | "band" | "scene";
  scene?: SceneKey;
  seed?: number;
  /** Where in the ramp the strip sits. 0 is night, 1 is the horizon. */
  crop?: number;
}
const { mode = "texture", scene = "dusk", seed = 7, crop } = Astro.props;
const band = mode !== "scene";
const h = mode === "band" ? 54 : 216;
---

<canvas
  class:list={["sky", mode]}
  width={384}
  height={h}
  aria-hidden="true"
  data-mode={mode}
  data-scene={scene}
  data-seed={seed}
  data-crop={crop ?? undefined}
></canvas>

<style>
  .sky { display: block; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .band {
    height: clamp(56px, 6vw, 84px);
    border-top: var(--stroke-edge);
    border-bottom: var(--stroke-edge);
  }
</style>

<script>
  import { Scene } from "../scripts/sky.js";
  const canvases = document.querySelectorAll<HTMLCanvasElement>("canvas.sky");
  let engine: Promise<typeof import("../scripts/scene-engine.js")> | undefined;
  async function paint(cv: HTMLCanvasElement) {
    if (cv.dataset.mode === "scene") {
      engine ??= import("../scripts/scene-engine.js");
      const { SceneEngine } = await engine;
      new SceneEngine(cv, cv.dataset.scene ?? "dusk", { w: cv.width, h: cv.height, seed: Number(cv.dataset.seed) || 7 }).draw(0.24);
    } else {
      new Scene(cv, { scene: cv.dataset.scene === "dawn" ? "dawn" : "dusk", seed: Number(cv.dataset.seed) || 7, band: true }).draw();
    }
  }
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) {
        observer.unobserve(entry.target);
        paint(entry.target as HTMLCanvasElement).catch(console.error);
      }
    }, { rootMargin: "240px" });
    canvases.forEach(cv => observer.observe(cv));
  } else canvases.forEach(cv => paint(cv).catch(console.error));
</script>
