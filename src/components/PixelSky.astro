---
/**
 * THE SKY. Three modes, and the distinction is load-bearing.
 *
 * ParcelHOA's own PixelSky.tsx states the rule and I broke it: behind working
 * text the sky is a TEXTURE, not a picture. Sky only, no treeline, no water, no
 * heron, painted once. A heron behind a page heading is the mark appearing
 * twice on one screen, and a scene stretched behind a hero is neither the
 * picture it was composed as nor a background.
 *
 *   texture  sky only, hero height, painted once. Behind headings.
 *   band     sky only, strip height, painted once. Between chapters.
 *   scene    the whole marsh, animated. The homepage hero, and nowhere else.
 *
 * The canvas is small and scaled with image-rendering: pixelated, which is where
 * the grid comes from. A CSS gradient would be the one soft edge in a system
 * whose argument is that it is drawn on a grid.
 */
interface Props {
  mode?: "texture" | "band" | "scene";
  scene?: "dusk" | "dawn";
  seed?: number;
  /** Where in the ramp the strip sits. 0 is night, 1 is the horizon. */
  crop?: number;
}
const { mode = "texture", scene = "dusk", seed = 7, crop } = Astro.props;
const band = mode !== "scene";
const h = mode === "band" ? 54 : 216;
---

<canvas
  class:list={["sky", mode]}
  width={384}
  height={h}
  aria-hidden="true"
  data-mode={mode}
  data-scene={scene}
  data-seed={seed}
  data-crop={crop ?? undefined}
></canvas>

<style>
  .sky { display: block; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .band {
    height: clamp(56px, 6vw, 84px);
    border-top: var(--stroke-edge);
    border-bottom: var(--stroke-edge);
  }
</style>

<script>
  import { Scene } from "../scripts/sky.js";

  const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
  const painted = new WeakSet<HTMLCanvasElement>();

  /*
   * A running scene redraws 82,944 pixels about fourteen times a second, for as
   * long as the page is open. The homepage gets away with two of them because
   * its hero is the first thing on screen; a closing band is not, and a phone
   * should not be painting a marsh nobody is looking at. So a scene runs only
   * while it is on screen, and stops when it leaves.
   *
   * A single frame is still painted immediately, so the section is never empty
   * and never fades in.
   */
  const running = new WeakMap<HTMLCanvasElement, { start(): void; stop(): void }>();
  const watcher = "IntersectionObserver" in window
    ? new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const scene = running.get(entry.target as HTMLCanvasElement);
          if (!scene) continue;
          if (entry.isIntersecting) scene.start();
          else scene.stop();
        }
      }, { rootMargin: "120px" })
    : null;

  function paint() {
    for (const cv of document.querySelectorAll<HTMLCanvasElement>("canvas.sky")) {
      if (painted.has(cv)) continue;
      painted.add(cv);
      const mode = cv.dataset.mode ?? "texture";
      const s = new Scene(cv, {
        scene: cv.dataset.scene === "dawn" ? "dawn" : "dusk",
        seed: Number(cv.dataset.seed) || 7,
        band: mode !== "scene",
      });
      s.draw();
      if (mode !== "scene" || reduce) continue;
      if (watcher) {
        running.set(cv, s);
        watcher.observe(cv);
      } else {
        s.start();
      }
    }
  }
  paint();
  addEventListener("load", paint);
</script>
