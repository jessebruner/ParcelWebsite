---
/**
 * THE STATUTORY DIGEST, AS THE PRODUCT DRAWS IT.
 *
 * A recreation of ParcelHOA's `src/components/parcel/StatuteDigest.tsx`, in the
 * Sheet's chrome from `Panel.astro`: a 1.5px ink edge, a night header carrying a
 * label and a figure, hairline rows, a footing that reconciles, a caption.
 * Enforcement tier, so the edge is the consequence stroke and the header is the
 * only dark thing in it.
 *
 * Three deliberate departures from the product's own component, all in the same
 * direction:
 *
 * **A table, not a list of flex rows.** Four columns of the same four kinds of
 * thing is a table, and a board reading down the citation column is the use it
 * is for.
 *
 * **No rounded corners.** The product's version carries `borderRadius: 4` in a
 * few places, which the design system does not allow anywhere. Copied as drawn
 * it would have brought that with it.
 *
 * **An unread row is chipped NOT READ, never "Governed by HOA Bylaws".** The
 * product labels its `none` rows that way, and it is the one conflation the
 * three-state fact model exists to prevent: a statute nobody has read is not a
 * statute that imposes nothing. The value cell prints nothing and the reason
 * sits under the label, which is what the data actually supports.
 */

export interface DigestRow {
  /** What a board would call the provision. From the product's own LABELS map. */
  label: string;
  /** What the statute says. Empty for a provision nobody has read. */
  value?: string;
  citation?: string;
  use: "runs" | "unread";
  /** The reason it is empty, or the caveat it carries. */
  because?: string;
  /** The verbatim passage the value rests on, where one is recorded. */
  quote?: string;
}

interface Props {
  label: string;
  note: string;
  rows: DigestRow[];
  footing: { label: string; value: string };
  caption: string;
}

const { label, note, rows, footing, caption } = Astro.props;
---

<figure class="sheet">
  <div class="head">
    <span class="lab">{label}</span>
    <span class="note">{note}</span>
  </div>

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th scope="col">Provision</th>
          <th scope="col">What the statute says</th>
          <th scope="col">Section</th>
          <th scope="col">Use</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <>
            <tr class:list={[{ dim: r.use === "unread" }]}>
              <th scope="row">
                {r.label}
                {r.because && <span class="why">{r.because}</span>}
              </th>
              <td class="val">{r.value ?? ""}</td>
              <td class="cite">{r.citation ?? ""}</td>
              <td>
                <span class:list={["chip", r.use]}>{r.use === "runs" ? "Runs" : "Not read"}</span>
              </td>
            </tr>
            {r.quote && (
              <tr class="ev">
                <td colspan="4">
                  <span class="evlab">The passage this rests on</span>
                  <blockquote>{r.quote}</blockquote>
                </td>
              </tr>
            )}
          </>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="3">{footing.label}</th>
          <td class="fv">{footing.value}</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .sheet { border: var(--stroke-consequence); background: var(--paper); margin: 0; }

  .head {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--s-3); padding: 11px 18px; background: var(--night);
  }
  .lab, .note {
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .lab { color: var(--on-dark-label); }
  .note { color: var(--sand); }

  .scroll-x { padding-inline: 18px; }
  table { min-width: 40em; }

  th[scope="col"] { padding-top: var(--s-4); }
  th[scope="col"]:last-child, td:last-child { padding-right: 0; text-align: right; }

  th[scope="row"] {
    font-family: var(--font-sans); font-size: var(--t-body); font-weight: 400;
    letter-spacing: 0; text-transform: none; color: var(--ink);
    border-bottom: var(--stroke-hairline);
    padding: var(--s-3) var(--s-4) var(--s-3) 0; vertical-align: top;
    max-width: 20em;
  }

  /* The recorded reason a field is empty, or the caveat a value carries. It is
     the most useful text in the row and the product treats it that way. */
  .why {
    display: block; margin-top: var(--s-1);
    font-family: var(--font-sans); font-size: var(--t-micro);
    line-height: 1.45; color: var(--ink-3); text-wrap: pretty;
  }

  .val {
    font-family: var(--font-mono); font-size: var(--t-mono-data);
    font-variant-numeric: tabular-nums; color: var(--ink); min-width: 11em;
  }
  .cite {
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.08em; color: var(--terracotta); white-space: nowrap;
  }

  .chip {
    display: inline-block; white-space: nowrap;
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.14em; text-transform: uppercase; padding: 3px 8px;
  }
  /* The two chips are the two consequence tiers, drawn as the system draws
     them. A provision that runs a clock is enforcement: a 1.5px ink edge on
     paper. A provision nobody has read is informational: a hairline, no weight.
     The product fills this chip with terracotta, which would put twelve filled
     brand marks in one table and make a routine row look like a warning. */
  .chip.runs { background: var(--paper); color: var(--ink); border: var(--stroke-consequence); }
  .chip.unread { background: transparent; color: var(--ink-3); border: var(--stroke-edge); }

  /* The evidence row. Plex Mono is evidence, and this is the one place on the
     page where the primary text itself appears. */
  /* Spanning all four columns makes this cell a `td:last-child`, which the rule
     above right-aligns for the chip column. Primary text reads left. */
  .ev > td {
    border-bottom: var(--stroke-hairline);
    padding: 0 0 var(--s-4);
    text-align: left;
  }
  .evlab {
    display: block; margin-bottom: var(--s-2);
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3);
  }
  .ev blockquote {
    margin: 0; border-left: var(--stroke-consequence); padding-left: var(--s-4);
    font-family: var(--font-mono); font-size: var(--t-mono-data);
    line-height: 1.6; color: var(--ink-2);
  }

  tfoot th[scope="row"] {
    border-top: var(--stroke-consequence); border-bottom: none;
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3);
    padding-block: var(--s-4);
  }
  tfoot td {
    border-top: var(--stroke-consequence); border-bottom: none;
    font-family: var(--font-mono); font-size: var(--t-title); letter-spacing: -0.02em;
    color: var(--terracotta); font-variant-numeric: tabular-nums;
    padding-block: var(--s-4);
  }

  figcaption {
    padding: 8px 18px 12px;
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3);
    border-top: var(--stroke-hairline);
  }
</style>
