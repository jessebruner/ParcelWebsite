---
const roles = [
  {
    slug: "resident",
    label: "Resident",
    title: "Their own home and account",
    description: "Residents use the portal for the lots the association has approved for them.",
    access: "Balances, statements, shared documents, ballots",
    actions: "Pay dues, submit requests, vote",
  },
  {
    slug: "officer",
    label: "Board officer",
    title: "Association-wide board work",
    description: "Officers can work with the records and decisions they need to run the association.",
    access: "Roster, ledgers, vendors, meetings, violations",
    actions: "Review, approve, correct, export",
  },
  {
    slug: "support",
    label: "Common Parcel support",
    title: "Separate access for technical help",
    description: "Support access uses an administrative console that is separate from normal customer access.",
    access: "Only what is needed for support",
    actions: "Recorded in the platform access log",
  },
];
---

<div class="roles" role="region" tabindex="0" aria-label="Examples of access by role. Scroll horizontally on small screens.">
  {roles.map((role) => (
    <article class="role-card">
      <div class:list={["role-avatar", `role-avatar--${role.slug}`]} aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <p class="t-label">{role.label}</p>
      <h3 class="t-title">{role.title}</h3>
      <p class="role-description">{role.description}</p>
      <dl>
        <div>
          <dt>Can access</dt>
          <dd>{role.access}</dd>
        </div>
        <div>
          <dt>Can do</dt>
          <dd>{role.actions}</dd>
        </div>
      </dl>
    </article>
  ))}
</div>

<style>
  .roles {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(272px, 84%);
    gap: var(--s-4);
    margin-top: clamp(28px, 4vw, 52px);
    padding-bottom: var(--s-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--terracotta) var(--c-hairline);
  }
  @media (min-width: 800px) {
    .roles { grid-auto-flow: initial; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; padding-bottom: 0; }
  }
  .role-card {
    min-height: 100%;
    padding: var(--s-6);
    border: var(--stroke-consequence);
    background: var(--card);
    scroll-snap-align: start;
  }
  .role-avatar {
    --role-color: var(--terracotta);
    display: grid;
    grid-template-columns: repeat(5, 8px);
    grid-template-rows: repeat(5, 8px);
    width: 56px;
    height: 56px;
    padding: 7px;
    border: var(--stroke-edge);
    background: var(--field);
    overflow: hidden;
    image-rendering: pixelated;
  }
  .role-avatar span {
    width: 8px;
    height: 8px;
    background: var(--role-color);
  }
  .role-avatar span:nth-child(1) { grid-column: 3; grid-row: 1; }
  .role-avatar span:nth-child(2) { grid-column: 2; grid-row: 2; }
  .role-avatar span:nth-child(3) { grid-column: 3; grid-row: 2; }
  .role-avatar span:nth-child(4) { grid-column: 4; grid-row: 2; }
  .role-avatar span:nth-child(5) { grid-column: 1; grid-row: 3; }
  .role-avatar span:nth-child(6) { grid-column: 2; grid-row: 3; }
  .role-avatar span:nth-child(7) { grid-column: 3; grid-row: 3; }
  .role-avatar span:nth-child(8) { grid-column: 4; grid-row: 3; }
  .role-avatar span:nth-child(9) { grid-column: 5; grid-row: 3; }
  .role-avatar span:nth-child(10) { grid-column: 2; grid-row: 4; background: var(--ink); }
  .role-avatar span:nth-child(11) { grid-column: 4; grid-row: 4; background: var(--ink); }
  .role-avatar--officer { --role-color: var(--plum); }
  .role-avatar--support { --role-color: var(--slate); }
  .role-card .t-label { margin-top: var(--s-5); }
  .role-card h3 { margin-top: var(--s-2); color: var(--ink); }
  .role-description { min-height: 4.8em; margin: var(--s-3) 0 0; color: var(--ink-body); }
  .role-card dl { margin: var(--s-5) 0 0; }
  .role-card dl > div { padding-block: var(--s-3); border-top: var(--stroke-hairline); }
  .role-card dt { color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-mono-label); letter-spacing: 0.12em; text-transform: uppercase; }
  .role-card dd { margin: var(--s-1) 0 0; color: var(--ink); font-size: var(--t-micro); line-height: 1.5; }
</style>
