---
interface Props { scene?: string; seed?: number; compact?: boolean; live?: boolean; }
const { compact = false } = Astro.props;
---
<section class:list={["page-intro", { compact }]}><div class="page"><slot /></div></section>
<style>
  .page-intro { padding-block: clamp(52px, 7vw, 104px) clamp(40px, 5vw, 72px); border-bottom: var(--stroke-edge); }
  .page-intro :global(h1) { max-width: 19ch; }
  .page-intro :global(.t-lede) { max-width: 37em; margin-top: 24px; color: var(--ink-2); }
  .page-intro :global(.actions) { margin-top: 30px; }
  .compact { padding-block: 56px; }
</style>
