---
/**
 * The hero, with the painted marsh behind it.
 *
 * Same construction as the homepage: the canvas fills the section, a low
 * gradient sits over it so text keeps its contrast against a sky that changes,
 * and the copy sits above both. Each page passes a different seed so the
 * treeline and the water are not the same picture twice.
 *
 * Linted at the hero surface where the page declares it, so nothing in the
 * slot may carry a digit, a counted quantity, or back-office vocabulary.
 */
import PixelSky from "./PixelSky.astro";

interface Props {
  eyebrow?: string;
  /** dusk is the default. dawn for the lighter, colder scene. */
  scene?: "dusk" | "dawn";
  /** Change it per page so no two heroes paint the same treeline. */
  seed?: number;
  /** Shorter hero for pages that are mostly body copy. */
  compact?: boolean;
}
const { eyebrow, scene = "dusk", seed = 7, compact = false } = Astro.props;
---

<section class:list={["hero on-ink", { compact }]}>
  <div class="art" aria-hidden="true">
    <PixelSky mode="texture" scene={scene} seed={seed} />
  </div>
  <div class="veil" aria-hidden="true"></div>
  <div class="page inner">
    {eyebrow && <p class="t-label">{eyebrow}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--night);
    color: var(--paper);
    overflow: hidden;
    padding-block: clamp(56px, 7vw, 116px) clamp(48px, 6vw, 96px);
  }
  .hero.compact { padding-block: clamp(44px, 5vw, 80px) clamp(40px, 4.5vw, 68px); }

  .art { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .art :global(canvas) { width: 100%; height: 100%; }

  /* Keeps text legible against a sky that moves through nineteen stops. */
  .veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(20, 18, 15, 0.42) 0%, rgba(20, 18, 15, 0.30) 100%);
  }

  .inner { position: relative; z-index: 2; }
  .hero :global(h1) { color: var(--paper); }
  .hero :global(.t-label) { color: var(--sand); }
  .hero :global(.t-lede) { color: var(--mist); max-width: 34em; margin-top: clamp(20px, 2.6vw, 34px); }
  .hero :global(.actions) { margin-top: clamp(24px, 3vw, 34px); }
</style>
