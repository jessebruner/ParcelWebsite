---
/**
 * The hero, with the painted marsh behind it.
 *
 * Same construction as the homepage: the canvas fills the section, a low
 * gradient sits over it so text keeps its contrast against a sky that changes,
 * and the copy sits above both. Each page passes a different seed so the
 * treeline and the water are not the same picture twice.
 *
 * Linted at the hero surface where the page declares it, so nothing in the
 * slot may carry a digit, a counted quantity, or back-office vocabulary.
 */
import type { SceneKey } from "../data/scenes.ts";
import PixelSky from "./PixelSky.astro";

interface Props {
  /** dusk is the default. dawn for the lighter, colder scene. */
  scene?: SceneKey;
  /** Change it per page so no two heroes paint the same treeline. */
  seed?: number;
  /** Shorter hero for pages that are mostly body copy. */
  compact?: boolean;
  /**
   * The whole marsh, moving, the way the homepage hero does it. Off by default:
   * a page that is mostly reading keeps the still texture behind its heading.
   *
   * PixelSky's own note reserved `scene` for the homepage, on the grounds that
   * a heron behind a page heading puts the mark on screen twice. That was our
   * rule, not the brief's, and the brief now asks for the homepage's motion on
   * every page. Recorded here rather than deleted, because the mark-twice
   * objection is still true and is a thing to look at once it is on screen.
   */
  live?: boolean;
}
const { scene = "dusk", seed = 7, compact = false, live = false } = Astro.props;
---

{/*
  No eyebrow. It used to render a small label above the h1, and on every
  feature page that label was a byte-for-byte copy of the page's own name while
  the h1 said something else. The page's name belongs in the heading.
*/}
<section class:list={["hero on-ink", { compact, live }]} data-scene={scene}>
  <div class="art" aria-hidden="true">
    <PixelSky mode={live ? "scene" : "texture"} scene={scene} seed={seed} />
  </div>
  <div class="veil" aria-hidden="true"></div>
  <div class="page inner">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--night);
    color: var(--paper);
    overflow: hidden;
    padding-block: clamp(56px, 7vw, 116px) clamp(48px, 6vw, 96px);
  }
  .hero.compact { padding-block: clamp(44px, 5vw, 80px) clamp(40px, 4.5vw, 68px); }
  /* A moving scene needs room to be a picture. The marsh is composed with the
     horizon at 54.6% of a 216-row canvas, and object-fit: cover on a short
     section crops away the treeline and the heron entirely. */
  .hero.live { padding-block: clamp(84px, 9.5vw, 156px) clamp(64px, 7vw, 108px); }

  .art { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .art :global(canvas) { width: 100%; height: 100%; }

  /* Keeps text legible against a sky that moves through nineteen stops. */
  .veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(20, 18, 15, 0.42) 0%, rgba(20, 18, 15, 0.30) 100%);
  }
  /*
   * A live hero is taller, so the copy crosses more of the ramp and can end up
   * sitting on the horizon, which is the brightest part of the picture: sand
   * at #F4CB9F under mist-coloured body text. A vertical veil alone cannot fix
   * that without flattening the sky it exists to show.
   *
   * So the copy side gets its own scrim, heaviest where the text is and gone by
   * the middle of the section, and the right two thirds keep the picture.
   */
  .hero.live .veil {
    background:
      linear-gradient(90deg, rgba(14, 12, 20, 0.80) 0%, rgba(14, 12, 20, 0.72) 46%, rgba(14, 12, 20, 0.30) 68%, rgba(14, 12, 20, 0) 84%),
      linear-gradient(180deg, rgba(20, 18, 15, 0.38) 0%, rgba(20, 18, 15, 0.30) 100%);
  }

  /*
   * Below the two-column breakpoint the copy spans the full width, so a scrim
   * that fades out to the right leaves the end of every line sitting on the
   * horizon — the brightest part of the dawn ramp, which tops out at --paper.
   * Measured there, the lede read 1.75:1 against a 4.5 requirement. On a narrow
   * screen the scrim runs down the page instead of across it, and the picture
   * is given back below the copy.
   */
  @media (max-width: 900px) {
    .hero.live .veil {
      background:
        linear-gradient(180deg, rgba(14, 12, 20, 0.86) 0%, rgba(14, 12, 20, 0.82) 52%, rgba(14, 12, 20, 0.58) 78%, rgba(14, 12, 20, 0.34) 100%);
    }
  }

  .inner { position: relative; z-index: 2; }
  .hero :global(h1) { color: var(--paper); }
  .hero :global(.t-lede) { color: var(--mist); max-width: 34em; margin-top: clamp(20px, 2.6vw, 34px); }
  .hero :global(.actions) { margin-top: clamp(24px, 3vw, 34px); }
</style>
