---
/**
 * The hero diagram for a feature page. One file per scene under ./scenes.
 *
 * These are diagrams, not screenshots. They are hidden from assistive
 * technology, so any text inside one reaches nobody — not a screen reader,
 * not a crawler. A scene that needs a sentence to be understood is a scene
 * that has not been drawn yet.
 */
import duesAndPayments from "./scenes/dues-and-payments.astro";
import collections from "./scenes/collections.astro";
import accountingAndBudgets from "./scenes/accounting-and-budgets.astro";
import rulesAndEnforcement from "./scenes/rules-and-enforcement.astro";
import meetingsAndVoting from "./scenes/meetings-and-voting.astro";
import documentsAndAnswers from "./scenes/documents-and-answers.astro";
import vendorsAndInsurance from "./scenes/vendors-and-insurance.astro";
import residentPortal from "./scenes/resident-portal.astro";
import recordsAndAudit from "./scenes/records-and-audit.astro";

interface Props { slug: string; }
const { slug } = Astro.props;

const SCENES: Record<string, any> = {
  "dues-and-payments": duesAndPayments,
  "collections": collections,
  "accounting-and-budgets": accountingAndBudgets,
  "rules-and-enforcement": rulesAndEnforcement,
  "meetings-and-voting": meetingsAndVoting,
  "documents-and-answers": documentsAndAnswers,
  "vendors-and-insurance": vendorsAndInsurance,
  "resident-portal": residentPortal,
  "records-and-audit": recordsAndAudit,
};

const TITLES: Record<string, string> = {
  "dues-and-payments": "Owner to association",
  collections: "Collections plan",
  "accounting-and-budgets": "Board budget",
  "rules-and-enforcement": "Before the fine",
  "meetings-and-voting": "Ballots in",
  "documents-and-answers": "Association library",
  "vendors-and-insurance": "Contract calendar",
  "resident-portal": "Resident view",
  "records-and-audit": "Board to board",
};

const Scene = SCENES[slug];
---

<div class:list={["feature-scene", `feature-scene--${slug}`]} aria-hidden="true">
  <div class="scene-top">
    <span class="scene-mark"><i></i><i></i><i></i></span>
    <span>{TITLES[slug] ?? "Common Parcel"}</span>
  </div>
  {Scene && <Scene />}
</div>

<style>
  .feature-scene {
    border: 1px solid var(--night-rule);
    background: var(--night-active);
    min-height: 320px;
    width: min(100%, 520px);
    justify-self: end;
    align-self: end;
    color: var(--paper);
    overflow: hidden;
  }
  .scene-top {
    min-height: 42px;
    border-bottom: 1px solid var(--night-rule);
    padding: 0 var(--s-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    color: var(--on-dark-label);
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .scene-mark { display: inline-flex; gap: 3px; }
  .scene-mark i { width: 5px; height: 5px; background: var(--on-dark-tile); }
  .scene-mark i:nth-child(2) { background: var(--amber); }

  /*
   * .scene-body belongs to the scene components, not to this one, so it has to
   * be global. Astro scopes a style block by stamping a hash onto the elements
   * in ITS OWN template and onto the selectors here; an element rendered by a
   * child component never receives that hash, so a plain `.scene-body` rule
   * written here silently matches nothing.
   *
   * That is exactly what happened when the nine scenes were pulled out of this
   * file into their own components. The check that the split was a no-op
   * compared the rendered TEXT of every page and found eight of nine identical
   * — and text cannot see a stylesheet detaching. Measured afterwards:
   * `.scene-body` had no `data-astro-cid-*` attribute at all and computed to
   * `display: block` where it had been a padded 278px box.
   */
  :global(.scene-body) { min-height: 278px; padding: clamp(20px, 3vw, 32px); }

  /* Payments */
  .payment-flow { display: grid; grid-template-columns: 1fr 34px 1.25fr 34px 1fr; align-items: center; }
  .flow-node { min-height: 138px; border: 1px solid var(--on-dark-tile-edge); background: var(--night); display: grid; place-items: center; align-content: center; gap: var(--s-4); padding: var(--s-3); text-align: center; }
  .flow-node--warm { border-color: var(--amber-edge); background: var(--plum); }
  .flow-node b, .flow-line { font-size: var(--t-micro); }
  .flow-line { display: flex; justify-content: space-evenly; }
  .flow-line i { width: 4px; height: 4px; background: var(--amber); }
  .pixel-person { width: 20px; height: 25px; border-top: 9px solid var(--paper); border-bottom: 12px solid var(--paper); }
  .pixel-card { width: 34px; height: 22px; border: 3px solid var(--paper); border-top-width: 7px; }
  .pixel-bank { width: 38px; height: 28px; border-bottom: 5px solid var(--paper); background: repeating-linear-gradient(90deg, transparent 0 6px, var(--paper) 6px 10px); position: relative; }
  .pixel-bank::before { content: ""; position: absolute; inset: -8px -3px auto; border-bottom: 7px solid var(--paper); border-inline: 8px solid transparent; }

  /* Collections */
  .timeline { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-2); align-content: center; }
  .timeline-rule { position: absolute; left: 10%; right: 10%; top: 50%; height: 2px; background: var(--on-dark-tile); }
  .timeline-step { position: relative; min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; text-align: center; }
  .timeline-step b { font-size: var(--t-micro); background: var(--night); border: 1px solid var(--on-dark-tile); padding: var(--s-2); min-width: 86px; }
  .timeline-step i { width: 12px; height: 12px; background: var(--paper); border: 3px solid var(--plum); z-index: 1; }
  .timeline-step:nth-child(4) i { background: var(--amber); }

  /* Budget */
  .budget { display: grid; grid-template-columns: 1.4fr 0.8fr; gap: var(--s-6); align-items: end; }
  .budget-chart { height: 170px; border-left: 1px solid var(--night-rule); border-bottom: 1px solid var(--night-rule); display: flex; align-items: end; gap: var(--s-4); padding: var(--s-4) var(--s-4) 0; }
  .budget-chart span { flex: 1; display: grid; grid-template-rows: 1fr auto; align-items: end; height: 100%; gap: var(--s-2); }
  .budget-chart i { height: var(--bar); background: var(--slate); border-top: 5px solid var(--mist); }
  .budget-chart span:nth-child(2) i { background: var(--plum); border-color: var(--amber); }
  .budget-chart b { font: 500 var(--t-mono-label)/1.3 var(--font-mono); color: var(--on-dark-label); text-align: center; }
  .ledger-lines { display: grid; gap: var(--s-3); align-self: stretch; align-content: center; }
  .ledger-lines i { height: 9px; background: var(--on-dark-tile); }
  .ledger-lines i:nth-child(2), .ledger-lines i:nth-child(4) { width: 68%; background: var(--slate); }
  .budget-total { grid-column: 1 / -1; border-top: 1px solid var(--night-rule); padding-top: var(--s-3); display: flex; justify-content: space-between; font-size: var(--t-micro); }
  .budget-total b { color: var(--amber); }

  /* Rules */
  .rule-review { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); align-items: center; }
  .rule-document { min-height: 206px; background: var(--paper); color: var(--ink); padding: var(--s-5); position: relative; }
  .document-tab { display: inline-block; background: var(--terracotta); color: var(--paper); font: 500 var(--t-mono-label)/1 var(--font-mono); padding: 7px 9px; text-transform: uppercase; }
  .rule-document i { display: block; height: 8px; background: var(--c-edge); margin-top: var(--s-3); }
  .rule-document i:nth-of-type(2) { width: 74%; }
  .rule-document i:nth-of-type(3) { width: 86%; }
  .rule-document b { display: block; border-top: var(--stroke-rule); margin-top: var(--s-5); padding-top: var(--s-3); color: var(--terracotta); font-size: var(--t-micro); }
  .review-column { display: grid; gap: var(--s-3); }
  .review-column > div { border: 1px solid var(--on-dark-tile-edge); background: var(--night); padding: var(--s-3); display: flex; justify-content: space-between; font-size: var(--t-micro); }
  .status { width: 10px; height: 10px; background: var(--slate); }
  .status--open { background: var(--amber); }
  .status--held { border: 2px solid var(--amber); background: transparent; }

  /* Meetings */
  .meeting { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--s-5); align-items: center; }
  .meeting-date { min-height: 206px; border: 1px solid var(--amber-edge); background: var(--plum); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: var(--s-2); }
  .meeting-date span, .meeting-date small { color: var(--mist); font-size: var(--t-micro); }
  .meeting-date b { font: 600 var(--t-figure)/1 var(--font-serif); color: var(--paper); }
  .ballot-stack { display: grid; gap: var(--s-3); }
  .ballot { border: 1px solid var(--on-dark-tile); background: var(--night); padding: var(--s-3); display: grid; grid-template-columns: 18px 1fr; align-items: center; gap: var(--s-3); }
  .ballot i { width: 14px; height: 14px; border: 2px solid var(--amber); }
  .ballot span { color: var(--mist); font-size: var(--t-micro); }
  .quorum { padding-top: var(--s-3); border-top: 1px solid var(--night-rule); display: grid; gap: var(--s-2); color: var(--mist); font-size: var(--t-micro); }
  .quorum i { height: 9px; background: var(--on-dark-tile); }
  .quorum b { display: block; width: 64%; height: 100%; background: var(--amber); }

  /* Documents */
  .documents { display: grid; gap: var(--s-5); align-content: center; }
  .search-box { border: 1px solid var(--amber-edge); background: var(--night); min-height: 48px; display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); color: var(--mist); font-size: var(--t-micro); }
  .search-pixel { width: 14px; height: 14px; border: 3px solid var(--amber); position: relative; }
  .search-pixel::after { content: ""; width: 8px; height: 3px; background: var(--amber); position: absolute; right: -7px; bottom: -5px; transform: rotate(45deg); }
  .document-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); }
  .document-grid > div { min-height: 144px; background: var(--paper); color: var(--ink); padding: var(--s-4); }
  .document-grid span { font-family: var(--font-serif); font-weight: 600; }
  .document-grid i { display: block; height: 7px; background: var(--c-edge); margin-top: var(--s-3); }
  .document-grid i:last-child { width: 62%; }

  /* Vendors */
  .vendors { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); align-items: center; }
  .vendor-calendar { border: 1px solid var(--on-dark-tile); background: var(--night); padding: var(--s-4); }
  .vendor-calendar > span { font-size: var(--t-micro); color: var(--mist); }
  .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; margin-top: var(--s-4); }
  .calendar-grid i { aspect-ratio: 1; background: var(--on-dark-tile); }
  .calendar-grid i.marked { background: var(--amber); outline: 2px solid var(--paper); outline-offset: 2px; }
  .contract-stack { display: grid; gap: var(--s-3); }
  .contract-stack div { background: var(--paper); color: var(--ink); padding: var(--s-3); border-left: 6px solid var(--terracotta); }
  .contract-stack b, .contract-stack span { display: block; }
  .contract-stack span { color: var(--ink-3); font: 500 var(--t-mono-label)/1.4 var(--font-mono); text-transform: uppercase; }

  /* Portal */
  .portal { padding: 0; display: grid; grid-template-columns: 58px 1fr; background: var(--paper); color: var(--ink); }
  .portal-sidebar { background: var(--night); border-right: 1px solid var(--night-rule); display: grid; align-content: start; justify-content: center; gap: var(--s-4); padding-top: var(--s-5); }
  .portal-sidebar i { width: 16px; height: 16px; background: var(--on-dark-tile); }
  .portal-sidebar i:first-child { background: var(--amber); }
  .portal-main { padding: var(--s-5); }
  .portal-greeting span, .portal-greeting b { display: block; }
  .portal-greeting span { color: var(--terracotta); font: 500 var(--t-mono-label)/1 var(--font-mono); text-transform: uppercase; }
  .portal-greeting b { margin-top: var(--s-2); font: 600 var(--t-title)/1.2 var(--font-serif); }
  .portal-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); margin-top: var(--s-6); }
  .portal-cards div { min-height: 112px; background: var(--field); border: var(--stroke-edge); padding: var(--s-3); display: grid; align-content: space-between; font-size: var(--t-micro); }
  .portal-cards i { height: 10px; background: var(--bisque-edge); }

  /* Records */
  .records { display: grid; grid-template-columns: 1.4fr 0.7fr; gap: var(--s-5); align-items: center; }
  .record-list { border-top: 1px solid var(--night-rule); }
  .record-list > div { border-bottom: 1px solid var(--night-rule); min-height: 48px; display: grid; grid-template-columns: 1fr 10px; align-items: center; gap: var(--s-3); }
  .record-list span { font-size: var(--t-micro); }
  .record-list i { width: 8px; height: 8px; background: var(--slate); }
  .record-list > div:last-child i { background: var(--amber); }
  .export-box { min-height: 154px; border: 1px dashed var(--amber-edge); display: grid; place-items: center; align-content: center; gap: var(--s-4); text-align: center; padding: var(--s-3); font-size: var(--t-micro); }
  .pixel-box { width: 38px; height: 30px; border: 4px solid var(--paper); border-top-width: 9px; }

  @media (max-width: 620px) {
    .feature-scene { min-height: 280px; }
    .scene-body { min-height: 238px; padding: var(--s-4); }
    .payment-flow { grid-template-columns: 1fr 20px 1fr 20px 1fr; }
    .flow-node { min-height: 116px; padding: var(--s-2); }
    .flow-node b { font-size: var(--t-mono-label); }
    .budget, .rule-review, .meeting, .vendors, .records { gap: var(--s-3); }
    .document-grid { gap: var(--s-2); }
    .document-grid > div { min-height: 122px; padding: var(--s-3); }
    .portal-cards { gap: var(--s-2); }
  }
</style>
