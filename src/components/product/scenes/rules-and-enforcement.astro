---
import FeatureIcon from "../FeatureIcon.astro";
import PropertyDrawing from "../PropertyDrawing.astro";
---
<div class="sheet request-sheet">
  <div class="property-preview"><PropertyDrawing fence /></div>
  <div class="request-body"><div class="sheet-heading"><span class="paper-title">Fence installation</span><span class="status pending">In review</span></div><p class="small-label request-address">Home improvement request · Lot 14</p>
  <div class="attachment"><FeatureIcon name="documents" /><span>Fence plan.pdf</span><span class="file-type">PDF</span></div><div class="attachment"><FeatureIcon name="documents" /><span>Property photo.jpg</span><span class="file-type">JPG</span></div>
  <div class="request-progress"><span class="done"><i>✓</i>Received</span><span class="reviewing"><i>2</i>Board review</span><span><i>3</i>Decision</span></div></div>
</div>
