---
/**
 * rules-and-enforcement — the hero diagram.
 *
 * Lifted verbatim from the nine-in-one FeatureScene so it can be rebuilt
 * without touching the other eight. It is still the static version.
 *
 * The shared chrome (.feature-scene, .scene-top, .scene-body) lives in
 * FeatureScene.astro and is inherited. Styles that belong only to this
 * scene belong in this file.
 */
---

<div class="rule-review scene-body">
      <div class="rule-document">
        <span class="document-tab">Declaration</span>
        <i></i><i></i><i></i><i></i>
        <b>Section reference</b>
      </div>
      <div class="review-column">
        <div><span>Owner response</span><i class="status status--open"></i></div>
        <div><span>Board review</span><i class="status"></i></div>
        <div><span>Decision</span><i class="status status--held"></i></div>
      </div>
    </div>
