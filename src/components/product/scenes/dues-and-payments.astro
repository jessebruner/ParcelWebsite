---
import FeatureIcon from "../FeatureIcon.astro";
---
<div class="sheet dues-sheet">
  <div class="sheet-heading"><span class="paper-title">October dues</span><span class="small-label">32 homes</span></div>
  <div class="amount-line"><span class="large-amount">$8,550</span><span class="small-label">collected</span></div>
  <div class="collection-track"><span></span><i></i></div>
  <div class="track-labels"><span>30 homes paid</span><span>$9,120 total</span></div>
  <div class="ledger-row"><span class="home-icon"><FeatureIcon name="resident" /></span><span><strong>Lot 08</strong><small>October dues</small></span><span class="row-amount">$285</span><span class="status paid">Paid</span></div>
  <div class="ledger-row"><span class="home-icon"><FeatureIcon name="resident" /></span><span><strong>Lot 14</strong><small>October dues</small></span><span class="row-amount">$285</span><span class="status pending">Due</span></div>
</div>
<div class="floating-note dues-note"><span class="note-icon"><FeatureIcon name="dues" /></span><span><strong>$570 still due</strong><small>2 owner accounts to follow up</small></span></div>
