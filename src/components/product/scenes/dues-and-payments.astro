---
/**
 * dues-and-payments — the hero diagram.
 *
 * Owner, Stripe, the association's bank. Three stations and no fourth, because
 * the claim the page makes is that the money never rests with Common Parcel,
 * and a diagram that drew us anywhere on this line would contradict the band
 * underneath it.
 *
 * The figures are pixel art on a 4px grid, drawn as SVG rects with crispEdges:
 * the owner is a house with a lit window (the same motif the hero landscapes
 * are built from), Stripe is a payment card with a chip, and the bank is a
 * vault door. The first cut of this scene drew the owner as a blob person,
 * Stripe as three literal stripes, and the bank as a clip-art temple; the
 * owner of the site called that out by name, so the pun and the temple do not
 * come back. Every rect sits on the integer grid — no half pixels.
 *
 * One authored moment, looping: a payment leaves the owner, crosses to Stripe,
 * crosses again, and the vault brightens as it lands. The figures inherit
 * currentColor so the landing animation only has to move `color`. Resting
 * state is the frame the scene holds under `prefers-reduced-motion: reduce` —
 * both payment squares parked at the left of their wire, everything legible.
 *
 * Three words carry meaning here and the rest is geometry. The block is
 * aria-hidden, so text inside it reaches nobody; the names are on the tiles
 * only because a name IS the picture in a flow diagram.
 *
 * Styles live in this file. FeatureScene.astro's <style> is scoped to
 * FeatureScene.astro, so its rules never reached this markup.
 */
---

<div class="dues-flow">
  <div class="dues-node">
    <span class="dues-figure">
      <!-- House: stepped roof, chimney, lit window, door. 13 x 11 grid. -->
      <svg class="px px--house" viewBox="0 0 13 11" aria-hidden="true">
        <rect x="10" y="0" width="1" height="2" fill="currentColor" />
        <rect x="5" y="0" width="3" height="1" fill="currentColor" />
        <rect x="4" y="1" width="5" height="1" fill="currentColor" />
        <rect x="3" y="2" width="7" height="1" fill="currentColor" />
        <rect x="2" y="3" width="9" height="1" fill="currentColor" />
        <rect x="3" y="4" width="7" height="7" fill="currentColor" />
        <rect x="4" y="5" width="2" height="2" class="px-amber" />
        <rect x="7" y="7" width="2" height="4" class="px-night" />
      </svg>
    </span>
    <b>Owner</b>
  </div>

  <span class="dues-wire"><i class="dues-pay dues-pay--a"></i></span>

  <div class="dues-node">
    <span class="dues-figure">
      <!-- Payment card: chip and two embossed number blocks. 12 x 8 grid. -->
      <svg class="px px--card" viewBox="0 0 12 8" aria-hidden="true">
        <rect x="0" y="0" width="12" height="8" fill="currentColor" />
        <rect x="2" y="2" width="2" height="2" class="px-amber" />
        <rect x="2" y="5" width="3" height="1" class="px-night" />
        <rect x="6" y="5" width="4" height="1" class="px-night" />
      </svg>
    </span>
    <b>Stripe</b>
  </div>

  <span class="dues-wire"><i class="dues-pay dues-pay--b"></i></span>

  <div class="dues-node">
    <span class="dues-figure dues-bank">
      <!-- A safe: body, inset door, dial with an amber pixel, handle, feet.
           12 x 11 grid. -->
      <svg class="px px--vault" viewBox="0 0 12 11" aria-hidden="true">
        <rect x="0" y="0" width="12" height="9" fill="currentColor" />
        <rect x="1" y="1" width="10" height="7" class="px-night" />
        <rect x="2" y="2" width="8" height="5" fill="currentColor" />
        <rect x="3" y="3" width="2" height="2" class="px-night" />
        <rect x="3" y="3" width="1" height="1" class="px-amber" />
        <rect x="7" y="3" width="1" height="3" class="px-night" />
        <rect x="1" y="9" width="2" height="2" fill="currentColor" />
        <rect x="9" y="9" width="2" height="2" fill="currentColor" />
      </svg>
    </span>
    <b>HOA bank</b>
  </div>
</div>

<style>
  .dues-flow {
    min-height: 278px;
    padding: clamp(18px, 2.6vw, 24px);
    display: grid;
    grid-template-columns: 1fr 52px 1fr 52px 1fr;
    align-content: center;
  }

  .dues-node {
    min-height: 190px;
    border: 1px solid var(--on-dark-tile-edge);
    background: var(--night);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--s-4);
    padding: var(--s-3);
  }
  .dues-node b {
    font: 500 var(--t-mono-label) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    white-space: nowrap;
  }

  .dues-figure {
    height: 52px;
    display: grid;
    align-content: center;
    justify-items: center;
    color: var(--sand);
  }
  .px { display: block; shape-rendering: crispEdges; }
  .px-amber { fill: var(--amber); }
  .px-night { fill: var(--night); }

  /* Whole pixels only: every SVG is its grid times a 4px unit. */
  .px--house { width: 52px; height: 44px; }
  .px--card { width: 48px; height: 32px; }
  .px--vault { width: 48px; height: 44px; }

  .dues-bank { animation: dues-land 3.4s linear infinite; }

  /* The wire between two stations, and the payment on it. */
  .dues-wire { position: relative; display: grid; align-content: center; }
  .dues-wire::before {
    content: "";
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--on-dark-label) 0 4px, transparent 4px 8px);
  }
  .dues-pay {
    position: absolute;
    top: 50%;
    margin-top: -4px;
    left: 0;
    width: 8px;
    height: 8px;
    background: var(--amber);
    animation-duration: 3.4s;
    animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
    animation-iteration-count: infinite;
  }
  .dues-pay--a { animation-name: dues-run-a; }
  .dues-pay--b { animation-name: dues-run-b; }

  @keyframes dues-run-a {
    0% { left: 0; opacity: 1; }
    26% { left: calc(100% - 8px); opacity: 1; }
    29%, 100% { left: calc(100% - 8px); opacity: 0; }
  }
  @keyframes dues-run-b {
    0%, 32% { left: 0; opacity: 0; }
    34% { left: 0; opacity: 1; }
    60% { left: calc(100% - 8px); opacity: 1; }
    63%, 100% { left: calc(100% - 8px); opacity: 0; }
  }
  /* The money lands. */
  @keyframes dues-land {
    0%, 60% { color: var(--sand); }
    66%, 78% { color: var(--paper); }
    86%, 100% { color: var(--sand); }
  }

  @media (max-width: 620px) {
    .dues-flow {
      min-height: 238px;
      padding: var(--s-3);
      grid-template-columns: 1fr 28px 1fr 28px 1fr;
    }
    .dues-node { min-height: 150px; gap: var(--s-3); padding: var(--s-2); }
    .dues-node b { letter-spacing: 0.04em; }
    .dues-figure { height: 46px; }
    /* Smaller unit, same grids: 3px per pixel. */
    .px--house { width: 39px; height: 33px; }
    .px--card { width: 36px; height: 24px; }
    .px--vault { width: 36px; height: 33px; }
  }
</style>
