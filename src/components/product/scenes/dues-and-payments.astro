---
/**
 * dues-and-payments — the hero diagram.
 *
 * Owner, Stripe, the association's bank. Three stations and no fourth, because
 * the claim the page makes is that the money never rests with Common Parcel,
 * and a diagram that drew us anywhere on this line would contradict the band
 * underneath it.
 *
 * One authored moment, looping: a payment leaves the owner, crosses to Stripe,
 * crosses again, and the bank brightens as it lands. Resting state is the
 * frame the scene holds under `prefers-reduced-motion: reduce` — both payment
 * squares parked at the left of their wire, everything legible, nothing
 * invisible.
 *
 * Three words carry meaning here and the rest is geometry. The block is
 * aria-hidden, so text inside it reaches nobody; the names are on the tiles
 * only because a name IS the picture in a flow diagram.
 *
 * Styles live in this file. FeatureScene.astro's <style> is scoped to
 * FeatureScene.astro, so its rules never reached this markup.
 */
---

<div class="dues-flow">
  <div class="dues-node">
    <span class="dues-figure dues-owner"></span>
    <b>Owner</b>
  </div>

  <span class="dues-wire"><i class="dues-pay dues-pay--a"></i></span>

  <div class="dues-node">
    <span class="dues-figure dues-stripe"></span>
    <b>Stripe</b>
  </div>

  <span class="dues-wire"><i class="dues-pay dues-pay--b"></i></span>

  <div class="dues-node">
    <span class="dues-figure dues-bank">
      <i class="cap-a"></i><i class="cap-b"></i><i class="cap-c"></i>
      <span class="dues-cols"><i></i><i></i><i></i><i></i></span>
      <i class="dues-plinth"></i>
    </span>
    <b>HOA bank</b>
  </div>
</div>

<style>
  .dues-flow {
    min-height: 278px;
    padding: clamp(18px, 2.6vw, 24px);
    display: grid;
    grid-template-columns: 1fr 52px 1fr 52px 1fr;
    align-content: center;
  }

  .dues-node {
    min-height: 190px;
    border: 1px solid var(--on-dark-tile-edge);
    background: var(--night);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--s-4);
    padding: var(--s-3);
  }
  .dues-node b {
    font: 500 var(--t-mono-label) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    white-space: nowrap;
  }

  /* Every figure is drawn from squares off the same 2px grid. */
  .dues-figure {
    height: 48px;
    display: grid;
    align-content: center;
    justify-items: center;
    color: var(--sand);
  }

  /* Owner: a head and a pair of shoulders. */
  .dues-owner { position: relative; width: 32px; height: 42px; }
  .dues-owner::before,
  .dues-owner::after { content: ""; position: absolute; left: 50%; background: currentColor; }
  .dues-owner::before { top: 2px; width: 12px; height: 12px; margin-left: -6px; }
  .dues-owner::after { top: 22px; width: 28px; height: 20px; margin-left: -14px; }

  /* Stripe: three bars, which is what the name says. */
  .dues-stripe {
    width: 34px;
    height: 31px;
    background: repeating-linear-gradient(180deg, currentColor 0 7px, transparent 7px 12px);
  }

  /* The bank: a stepped cornice, four columns, a plinth. Whole-pixel steps,
     because a smooth pediment is not what this brand draws. */
  .dues-bank {
    width: 52px;
    gap: 2px;
    animation: dues-land 3.4s linear infinite;
  }
  .dues-bank i { background: currentColor; }
  .dues-bank .cap-a { width: 16px; height: 4px; }
  .dues-bank .cap-b { width: 34px; height: 4px; }
  .dues-bank .cap-c { width: 52px; height: 4px; }
  .dues-cols { display: flex; gap: 8px; height: 18px; }
  .dues-cols i { width: 7px; height: 100%; }
  .dues-bank .dues-plinth { width: 52px; height: 6px; }

  /* The wire between two stations, and the payment on it. */
  .dues-wire { position: relative; display: grid; align-content: center; }
  .dues-wire::before {
    content: "";
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--on-dark-label) 0 4px, transparent 4px 8px);
  }
  .dues-pay {
    position: absolute;
    top: 50%;
    margin-top: -4px;
    left: 0;
    width: 8px;
    height: 8px;
    background: var(--amber);
    animation-duration: 3.4s;
    animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
    animation-iteration-count: infinite;
  }
  .dues-pay--a { animation-name: dues-run-a; }
  .dues-pay--b { animation-name: dues-run-b; }

  @keyframes dues-run-a {
    0% { left: 0; opacity: 1; }
    26% { left: calc(100% - 8px); opacity: 1; }
    29%, 100% { left: calc(100% - 8px); opacity: 0; }
  }
  @keyframes dues-run-b {
    0%, 32% { left: 0; opacity: 0; }
    34% { left: 0; opacity: 1; }
    60% { left: calc(100% - 8px); opacity: 1; }
    63%, 100% { left: calc(100% - 8px); opacity: 0; }
  }
  /* The money lands. */
  @keyframes dues-land {
    0%, 60% { color: var(--sand); }
    66%, 78% { color: var(--paper); }
    86%, 100% { color: var(--sand); }
  }

  @media (max-width: 620px) {
    .dues-flow {
      min-height: 238px;
      padding: var(--s-3);
      grid-template-columns: 1fr 28px 1fr 28px 1fr;
    }
    .dues-node { min-height: 150px; gap: var(--s-3); padding: var(--s-2); }
    .dues-node b { letter-spacing: 0.04em; }
    .dues-figure { height: 42px; }
    .dues-owner { width: 28px; height: 38px; }
    .dues-owner::before { top: 2px; width: 10px; height: 10px; margin-left: -5px; }
    .dues-owner::after { top: 20px; width: 24px; height: 18px; margin-left: -12px; }
    .dues-stripe { width: 28px; height: 26px; background: repeating-linear-gradient(180deg, currentColor 0 6px, transparent 6px 10px); }
    .dues-bank { width: 42px; }
    .dues-bank .cap-a { width: 14px; }
    .dues-bank .cap-b { width: 28px; }
    .dues-bank .cap-c, .dues-bank .dues-plinth { width: 42px; }
    .dues-cols { gap: 6px; height: 15px; }
    .dues-cols i { width: 6px; }
  }
</style>
