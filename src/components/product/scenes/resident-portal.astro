---
/**
 * resident-portal — the hero diagram.
 *
 * A PORTAL BEING USED, NOT A PORTAL BEING POINTED AT. The first pass kept a
 * persistent row of three cards and underlined whichever one the rail was on.
 * Jesse's note on it: "I would rather the side nav item change and the whole
 * 'page' changes in the illustration." So that is the scene now: the rail
 * carries four pixel icons — home, dues, requests, documents — a selection
 * frame walks them on a four-stop clock, and the whole main pane swaps to
 * that section's page: balance, then a paid assessment, then an ARC request
 * in review, then the document library. Four pages an owner actually opens
 * the portal for, each with a real example state instead of wireframe bars.
 *
 * Two things move on one clock: the frame on the rail, and the cross-fade
 * between pages. Nothing else animates.
 *
 * The block is aria-hidden, so the words inside reach nobody by ear; they are
 * there because a portal with no content in it is a wireframe, and the owner
 * has seen enough wireframes.
 *
 * REST IS THE LAST KEYFRAME. tokens.css answers prefers-reduced-motion with
 * `animation-duration: 0.001ms !important`, which lands every animation on
 * its 100% frame. The base styles, the 100% frame, and the explicit
 * reduced-motion rule below all agree: home page visible, frame on the home
 * icon. A still scene is the scene at rest, not mid-fade.
 *
 * No <script>: pure CSS needs no IntersectionObserver.
 *
 * The shared chrome (.feature-scene, .scene-top) lives in FeatureScene.astro.
 * .scene-body is redefined here because Astro scopes that file's styles to
 * that file's own markup, and this markup is not in it.
 */
---

<div class="portal scene-body">
  <div class="rail">
    <span class="cursor"></span>
    <span class="ri">
      <!-- Home -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="3" y="0" width="2" height="1" fill="currentColor" />
        <rect x="2" y="1" width="4" height="1" fill="currentColor" />
        <rect x="1" y="2" width="6" height="1" fill="currentColor" />
        <rect x="1" y="3" width="6" height="5" fill="currentColor" />
        <rect x="3" y="5" width="2" height="3" class="px-night" />
      </svg>
    </span>
    <span class="ri">
      <!-- Dues: payment card -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="0" y="1" width="8" height="6" fill="currentColor" />
        <rect x="1" y="2" width="2" height="2" class="px-night" />
        <rect x="1" y="5" width="4" height="1" class="px-night" />
      </svg>
    </span>
    <span class="ri">
      <!-- Requests: a form -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="1" y="0" width="6" height="8" fill="currentColor" />
        <rect x="2" y="2" width="4" height="1" class="px-night" />
        <rect x="2" y="4" width="4" height="1" class="px-night" />
        <rect x="2" y="6" width="2" height="1" class="px-night" />
      </svg>
    </span>
    <span class="ri">
      <!-- Documents: a folder -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="0" y="1" width="3" height="2" fill="currentColor" />
        <rect x="0" y="2" width="8" height="5" fill="currentColor" />
        <rect x="1" y="4" width="6" height="1" class="px-night" />
      </svg>
    </span>
  </div>

  <div class="main">
    <section class="pg pg--home">
      <span class="pt">Balance</span>
      <b class="ph">$285</b>
      <span class="pl"><i class="dot"></i>Payment received · $95</span>
    </section>

    <section class="pg pg--dues">
      <span class="pt">Dues</span>
      <b class="ph">$95</b>
      <span class="pl"><i class="dot"></i>March assessment · Paid March 1</span>
    </section>

    <section class="pg pg--req">
      <span class="pt">Requests</span>
      <b class="ph ph--word">Fence</b>
      <span class="pl"><i class="dot dot--open"></i>Submitted February 12 · In&nbsp;review</span>
    </section>

    <section class="pg pg--docs">
      <span class="pt">Documents</span>
      <span class="doc"><i class="dot"></i>CC&amp;Rs <em>2019</em></span>
      <span class="doc"><i class="dot"></i>Bylaws <em>2019</em></span>
      <span class="doc"><i class="dot"></i>Budget <em>2026</em></span>
    </section>
  </div>
</div>

<style>
  .portal {
    --pitch: 32px;
    min-height: 278px;
    padding: 0;
    display: grid;
    grid-template-columns: 58px 1fr;
    background: var(--paper);
    color: var(--ink);
  }

  .rail {
    position: relative;
    background: var(--night);
    border-right: 1px solid var(--night-rule);
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding: var(--s-5) 21px 0;
  }
  .ri { display: block; width: 16px; height: 16px; color: var(--on-dark-label); }
  .ri svg { display: block; width: 16px; height: 16px; shape-rendering: crispEdges; }
  .px-night { fill: var(--night); }

  /* The cursor is a selection frame around the icon the walk is on, so the
     icon stays legible inside it. */
  .cursor {
    position: absolute;
    top: calc(var(--s-5) - 4px);
    left: 17px;
    width: 24px;
    height: 24px;
    border: 2px solid var(--amber);
    box-sizing: border-box;
    animation: rail-walk 10.4s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  /* Pages stack in one cell and cross-fade; base state is the rest state:
     home visible, the rest hidden. */
  .main { display: grid; padding: var(--s-5); }
  .pg {
    grid-area: 1 / 1;
    display: grid;
    align-content: center;
    gap: var(--s-3);
    opacity: 0;
  }
  .pg--home { opacity: 1; animation: pg-a 10.4s linear infinite; }
  .pg--dues { animation: pg-b 10.4s linear infinite; }
  .pg--req { animation: pg-c 10.4s linear infinite; }
  .pg--docs { animation: pg-d 10.4s linear infinite; }

  .pt {
    font: 500 var(--t-mono-label)/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .ph {
    font: 600 clamp(28px, 3.2vw, 40px)/1 var(--font-serif);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .ph--word { letter-spacing: -0.01em; }
  .pl {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-2);
    font: 500 13px/1.35 var(--font-sans);
    color: var(--ink-2);
  }

  /* A pixel status square: filled amber is settled, outlined is still open. */
  .dot { flex: none; width: 8px; height: 8px; background: var(--amber); }
  .dot--open { background: transparent; border: 2px solid var(--amber); box-sizing: border-box; }

  /* The document library: three real files, in the site's own list voice. */
  .doc {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-bottom: var(--stroke-hairline);
    font: 500 13px/1.35 var(--font-sans);
    color: var(--ink);
  }
  .doc em {
    margin-left: auto;
    font: 500 var(--t-mono-label)/1 var(--font-mono);
    font-style: normal;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  /* Four stops, one clock. Dwell, then move; 100% is home again. */
  @keyframes rail-walk {
    0%, 19% { transform: translateY(0); }
    25%, 44% { transform: translateY(var(--pitch)); }
    50%, 69% { transform: translateY(calc(2 * var(--pitch))); }
    75%, 94% { transform: translateY(calc(3 * var(--pitch))); }
    100% { transform: translateY(0); }
  }
  @keyframes pg-a {
    0%, 19% { opacity: 1; }
    25%, 94% { opacity: 0; }
    100% { opacity: 1; }
  }
  @keyframes pg-b {
    0%, 19% { opacity: 0; }
    25%, 44% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes pg-c {
    0%, 44% { opacity: 0; }
    50%, 69% { opacity: 1; }
    75%, 100% { opacity: 0; }
  }
  @keyframes pg-d {
    0%, 69% { opacity: 0; }
    75%, 94% { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor, .pg { animation: none; }
  }

  @media (max-width: 620px) {
    .portal { min-height: 238px; grid-template-columns: 46px 1fr; }
    .rail { padding: var(--s-4) 15px 0; }
    .cursor { top: calc(var(--s-4) - 4px); left: 11px; }
    .main { padding: var(--s-4); }
    .pl, .doc { font-size: 12px; }
  }
</style>
