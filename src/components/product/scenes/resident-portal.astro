---
/**
 * resident-portal — the hero diagram.
 *
 * THE COMPOSITION IS THE ONE THE OWNER APPROVED: a dark rail on the left, a
 * balance figure at the top, three cards under it, a cursor that walks the
 * rail while an amber tab tracks the card it lands on. His one ask was "an
 * animation of the actual resident portal going through" — and the first cut
 * answered it with four blank rail squares and grey-bar wireframe cards,
 * which he later flagged as placeholder-grade. So the geometry now shows the
 * portal: the rail carries pixel icons for home, dues, requests, and
 * documents (8×8 grids, drawn as SVG rects with crispEdges), and the cards
 * carry the three things an owner actually opens the portal for, each with a
 * real example state. Same clock, same two movements, nothing else animates.
 *
 * The block is aria-hidden, so the words inside reach nobody by ear; they are
 * there because a portal with no content in it is a wireframe, and the owner
 * has seen enough wireframes.
 *
 * REST IS THE LAST KEYFRAME. tokens.css answers prefers-reduced-motion with
 * `animation-duration: 0.001ms !important`, which lands every animation on its
 * 100% frame, so 100% is the walk's starting position and a still scene is the
 * scene at rest rather than mid-stride.
 *
 * No <script>: pure CSS needs no IntersectionObserver.
 *
 * The shared chrome (.feature-scene, .scene-top) lives in FeatureScene.astro.
 * .scene-body is redefined here because Astro scopes that file's styles to
 * that file's own markup, and this markup is not in it.
 */
---

<div class="portal scene-body">
  <div class="rail">
    <span class="cursor"></span>
    <span class="ri">
      <!-- Home -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="3" y="0" width="2" height="1" fill="currentColor" />
        <rect x="2" y="1" width="4" height="1" fill="currentColor" />
        <rect x="1" y="2" width="6" height="1" fill="currentColor" />
        <rect x="1" y="3" width="6" height="5" fill="currentColor" />
        <rect x="3" y="5" width="2" height="3" class="px-night" />
      </svg>
    </span>
    <span class="ri">
      <!-- Dues: payment card -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="0" y="1" width="8" height="6" fill="currentColor" />
        <rect x="1" y="2" width="2" height="2" class="px-night" />
        <rect x="1" y="5" width="4" height="1" class="px-night" />
      </svg>
    </span>
    <span class="ri">
      <!-- Requests: a form -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="1" y="0" width="6" height="8" fill="currentColor" />
        <rect x="2" y="2" width="4" height="1" class="px-night" />
        <rect x="2" y="4" width="4" height="1" class="px-night" />
        <rect x="2" y="6" width="2" height="1" class="px-night" />
      </svg>
    </span>
    <span class="ri">
      <!-- Documents: a folder -->
      <svg viewBox="0 0 8 8" aria-hidden="true">
        <rect x="0" y="1" width="3" height="2" fill="currentColor" />
        <rect x="0" y="2" width="8" height="5" fill="currentColor" />
        <rect x="1" y="4" width="6" height="1" class="px-night" />
      </svg>
    </span>
  </div>

  <div class="main">
    <div class="figure">
      <span>Balance</span>
      <b>$285</b>
    </div>

    <div class="cards">
      <div>
        <span class="ct">Dues</span>
        <b class="cv">Paid · March 1</b>
      </div>
      <div>
        <span class="ct">Requests</span>
        <b class="cv">Fence · In&nbsp;review</b>
      </div>
      <div>
        <span class="ct">Documents</span>
        <b class="cv">CC&amp;Rs · Bylaws</b>
      </div>
      <span class="tab"></span>
    </div>
  </div>
</div>

<style>
  .portal {
    --pitch: 32px;
    --cg: var(--s-3);
    min-height: 278px;
    padding: 0;
    display: grid;
    grid-template-columns: 58px 1fr;
    background: var(--paper);
    color: var(--ink);
  }

  .rail {
    position: relative;
    background: var(--night);
    border-right: 1px solid var(--night-rule);
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding: var(--s-5) 21px 0;
  }
  .ri { display: block; width: 16px; height: 16px; color: var(--on-dark-label); }
  .ri svg { display: block; width: 16px; height: 16px; shape-rendering: crispEdges; }
  .px-night { fill: var(--night); }

  /* The cursor is a selection frame around the icon the walk is on, so the
     icon stays legible inside it. */
  .cursor {
    position: absolute;
    top: calc(var(--s-5) - 4px);
    left: 17px;
    width: 24px;
    height: 24px;
    border: 2px solid var(--amber);
    box-sizing: border-box;
    animation: rail-walk 7.8s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  .main { padding: var(--s-5); display: grid; align-content: space-between; gap: var(--s-6); }

  .figure { display: grid; gap: var(--s-2); }
  .figure span {
    font: 500 var(--t-mono-label)/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .figure b {
    font: 600 clamp(28px, 3.2vw, 40px)/1 var(--font-serif);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .cards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--cg);
    padding-bottom: 11px;
  }
  .cards > div {
    min-height: 92px;
    background: var(--field);
    border: var(--stroke-edge);
    padding: var(--s-3);
    display: grid;
    align-content: space-between;
    gap: var(--s-4);
  }
  .ct {
    font: 500 var(--t-mono-label)/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .cv {
    font: 500 13px/1.35 var(--font-sans);
    color: var(--ink);
  }

  /* Which card the rail is on. Moves with the cursor, on the same clock. */
  .tab {
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc((100% - 2 * var(--cg)) / 3);
    height: 3px;
    background: var(--amber);
    animation: card-walk 7.8s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  @keyframes rail-walk {
    0%, 25% { transform: translateY(0); }
    33%, 58% { transform: translateY(var(--pitch)); }
    66%, 91% { transform: translateY(calc(2 * var(--pitch))); }
    100% { transform: translateY(0); }
  }
  @keyframes card-walk {
    0%, 25% { transform: translateX(0); }
    33%, 58% { transform: translateX(calc(100% + var(--cg))); }
    66%, 91% { transform: translateX(calc(200% + 2 * var(--cg))); }
    100% { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor, .tab { animation: none; }
  }

  @media (max-width: 620px) {
    .portal { min-height: 238px; grid-template-columns: 46px 1fr; --cg: var(--s-2); }
    .rail { padding: var(--s-4) 15px 0; }
    .cursor { top: calc(var(--s-4) - 4px); left: 11px; }
    .main { padding: var(--s-4); gap: var(--s-5); }
    .cards > div { min-height: 76px; padding: var(--s-2); }
    .cv { font-size: 12px; }
  }
</style>
