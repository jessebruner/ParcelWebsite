---
import FeatureIcon from "../FeatureIcon.astro";
import PropertyDrawing from "../PropertyDrawing.astro";
import Mark from "../../Mark.astro";
---
<div class="resident-layout"><div class="resident-device"><div class="device-speaker"></div><div class="portal-header"><Mark size={20} /><span>Autumn Ridge</span></div><div class="portal-property"><PropertyDrawing fence /></div><div class="portal-body"><span class="portal-greeting">Your account</span><span class="small-label">Lot 14</span><div class="portal-balance"><small>October dues</small><strong>$285</strong><span>Due October 1</span></div><div class="portal-link"><FeatureIcon name="documents" /><span>Association documents</span><span>›</span></div><div class="portal-link"><FeatureIcon name="rules" /><span>Your requests</span><span>›</span></div></div></div><div class="resident-request"><span class="note-icon"><FeatureIcon name="rules" /></span><strong>Fence request</strong><span class="status pending">In board review</span><small>Follow the status<br />from your account.</small></div></div>
