---
/**
 * resident-portal — the hero diagram.
 *
 * Lifted verbatim from the nine-in-one FeatureScene so it can be rebuilt
 * without touching the other eight. It is still the static version.
 *
 * The shared chrome (.feature-scene, .scene-top, .scene-body) lives in
 * FeatureScene.astro and is inherited. Styles that belong only to this
 * scene belong in this file.
 */
---

<div class="portal scene-body">
      <div class="portal-sidebar"><i></i><i></i><i></i><i></i></div>
      <div class="portal-main">
        <div class="portal-greeting"><span>Resident home</span><b>Your association at a glance</b></div>
        <div class="portal-cards">
          <div><span>Balance</span><i></i></div>
          <div><span>Requests</span><i></i></div>
          <div><span>Documents</span><i></i></div>
        </div>
      </div>
    </div>
