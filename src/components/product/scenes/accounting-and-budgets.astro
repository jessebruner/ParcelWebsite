---
/**
 * accounting-and-budgets — the hero diagram.
 *
 * Lifted verbatim from the nine-in-one FeatureScene so it can be rebuilt
 * without touching the other eight. It is still the static version.
 *
 * The shared chrome (.feature-scene, .scene-top, .scene-body) lives in
 * FeatureScene.astro and is inherited. Styles that belong only to this
 * scene belong in this file.
 */
---

<div class="budget scene-body">
      <div class="budget-chart">
        <span style="--bar: 54%"><i></i><b>Operating</b></span>
        <span style="--bar: 76%"><i></i><b>Reserve</b></span>
        <span style="--bar: 63%"><i></i><b>Actual</b></span>
      </div>
      <div class="ledger-lines"><i></i><i></i><i></i><i></i></div>
      <div class="budget-total"><span>Budget view</span><b>Board review</b></div>
      <p class="scene-note">Illustrative budget view.</p>
    </div>
