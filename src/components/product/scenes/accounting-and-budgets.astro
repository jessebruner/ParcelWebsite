---
import FeatureIcon from "../FeatureIcon.astro";
---
<div class="sheet budget-sheet">
  <div class="sheet-heading"><span class="paper-title">September budget</span><span class="small-label">2026</span></div>
  <div class="budget-totals"><div><small>Spent this month</small><strong>$2,340</strong></div><div><small>Monthly budget</small><strong>$2,550</strong></div></div>
  <div class="chart-legend"><span><i class="spent-key"></i>Actual spending</span><span><i></i>Budget</span></div>
  <div class="budget-chart">{[{name:"Landscaping",spent:"$1,120",budget:"$1,200",width:93.33},{name:"Insurance",spent:"$900",budget:"$900",width:100},{name:"Repairs",spent:"$320",budget:"$450",width:71.11}].map(row => <div class="chart-row"><div><strong>{row.name}</strong><span>{row.spent} <small>/ {row.budget}</small></span></div><div class="budget-track"><span style={`width:${row.width}%`}></span></div></div>)}</div>
  <div class="budget-result"><FeatureIcon name="check" /><span><strong>$210 under budget</strong><small>See where the difference comes from.</small></span></div>
</div>
