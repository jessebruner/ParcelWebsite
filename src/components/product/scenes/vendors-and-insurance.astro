import FeatureIcon from "../FeatureIcon.astro";
import PropertyDrawing from "../PropertyDrawing.astro";
---
<div class="sheet vendor-sheet"><div class="vendor-landscape"><PropertyDrawing /></div><div class="vendor-body"><div class="sheet-heading"><span class="paper-title">Landscaping agreement</span><span class="file-type">PDF</span></div><div class="vendor-dates"><div><small>Review by</small><strong>Sep 15</strong></div><span class="date-arrow">→</span><div><small>Renews</small><strong>Oct 01</strong></div></div><div class="date-track"><span></span><i></i></div><div class="vendor-file"><FeatureIcon name="documents" /><span><strong>Insurance certificate</strong><small>On file · Expires Dec 31, 2026</small></span></div></div></div>
<div class="floating-note renewal-note"><span class="calendar-leaf"><small>SEP</small><strong>15</strong></span><span><strong>Review the renewal</strong><small>A date your board can plan around.</small></span></div>
