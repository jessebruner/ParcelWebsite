---
/**
 * meetings-and-voting — the hero diagram.
 *
 * Rebuilt from nothing. The thing it replaced was a stack of labelled cards
 * that said "Annual meeting / Vote / Agenda / Ballot received / Ballot
 * reviewed / Quorum" and drew none of them.
 *
 * ONE IDEA: ballots come in across the plat until the count crosses quorum.
 * The plat is the brand's own motif (Plat.astro: lots as tiles, each with a
 * bottom edge one eleventh of its size) so the picture is made of the thing
 * the association is made of.
 *
 * VOTED is a fixed list, not a random draw, so every build paints the same
 * turnout. Thirty of forty-eight lots vote, which is what a real annual
 * meeting looks like, and the meter stops just past the notch rather than at
 * the end of the bar.
 *
 * One word, and the word is the meter's name rather than a caption.
 */
const LOTS = 48;
const VOTED = new Set([
  0, 1, 3, 4, 6, 7, 9, 10, 11,
  12, 14, 15, 16, 18, 20, 21, 23,
  24, 25, 27, 28, 30, 31, 33, 34, 35,
  37, 39, 42, 45,
]);
const CELLS = Array.from({ length: LOTS }, (_, i) => i);
---

<div class="poll scene-body">
  <div class="poll-plat">
    <div class="poll-grid">{CELLS.map(() => <i></i>)}</div>
    <div class="poll-grid poll-grid--cast">
      {CELLS.map((i) => <i class:list={{ voted: VOTED.has(i) }}></i>)}
    </div>
  </div>

  <div class="poll-meter">
    <span class="poll-word">Quorum</span>
    <span class="poll-bar">
      <span class="poll-fill"></span>
      <span class="poll-notch"></span>
    </span>
  </div>
</div>

<style>
  /* .scene-body's rule lives in the parent and no longer reaches a child
     component, so the scene carries its own box. */
  .poll {
    min-height: 278px;
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    grid-template-rows: auto auto;
    gap: var(--s-6);
    align-content: center;
  }

  .poll-plat { position: relative; }
  .poll-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 5px;
  }
  /* The lot, from Plat.astro: a tile with a bottom edge one eleventh of it. */
  .poll-grid i {
    aspect-ratio: 1;
    background: linear-gradient(to bottom, var(--on-dark-tile-edge) 0 90.909%, var(--bank) 90.909% 100%);
  }
  .poll-grid--cast {
    position: absolute;
    inset: 0;
    clip-path: inset(0 100% 0 0);
  }
  .poll-grid--cast i { background: none; }
  .poll-grid--cast i.voted {
    background: linear-gradient(to bottom, var(--amber) 0 90.909%, var(--amber-edge) 90.909% 100%);
  }

  .poll-meter {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--s-4);
  }
  .poll-word {
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-label);
  }
  .poll-bar {
    position: relative;
    display: block;
    height: 14px;
    background: var(--on-dark-tile-edge);
  }
  .poll-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--amber);
  }
  /* Where quorum is. It is a mark on the bar, so nothing has to say so. */
  .poll-notch {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 50%;
    width: 2px;
    background: var(--on-dark-label);
  }

  .poll-grid--cast { animation: poll-cast 7s infinite; }
  .poll-fill { animation: poll-rise 7s infinite; }
  .poll-notch { animation: poll-reach 7s infinite; }
  .poll-word { animation: poll-name 7s infinite; }

  @keyframes poll-cast {
    0% { clip-path: inset(0 100% 0 0); }
    6% { clip-path: inset(0 100% 0 0); animation-timing-function: steps(12, end); }
    54%, 92.9% { clip-path: inset(0 0 0 0); }
    93%, 100% { clip-path: inset(0 100% 0 0); }
  }
  @keyframes poll-rise {
    0% { width: 0; }
    6% { width: 0; animation-timing-function: steps(12, end); }
    54%, 92.9% { width: 62.5%; }
    93%, 100% { width: 0; }
  }
  @keyframes poll-reach {
    0%, 47.9% { background: var(--on-dark-label); }
    48%, 92.9% { background: var(--paper); }
    93%, 100% { background: var(--on-dark-label); }
  }
  @keyframes poll-name {
    0%, 47.9% { color: var(--on-dark-label); }
    48%, 92.9% { color: var(--sand); }
    93%, 100% { color: var(--on-dark-label); }
  }

  @media (max-width: 620px) {
    .poll { min-height: 238px; padding: var(--s-4); gap: var(--s-5); }
    .poll-grid { gap: 4px; }
  }

  /* Reduced motion holds the finished state: the ballots are in and the count
     is past the notch. */
  @media (prefers-reduced-motion: reduce) {
    .poll-grid--cast,
    .poll-fill,
    .poll-notch,
    .poll-word { animation: none; }
    .poll-grid--cast { clip-path: inset(0 0 0 0); }
    .poll-fill { width: 62.5%; }
    .poll-notch { background: var(--paper); }
    .poll-word { color: var(--sand); }
  }
</style>
