---
import FeatureIcon from "../FeatureIcon.astro";
---
<div class="meeting-date"><span class="date-square"><small>SEP</small><strong>09</strong></span><span><strong>Board meeting</strong><small>Wednesday · 6:30 p.m.</small></span></div>
<div class="sheet agenda-sheet"><div class="sheet-heading"><span class="paper-title">Meeting agenda</span><span class="small-label">3 items</span></div><div class="agenda-item"><span>01</span><strong>Financial report</strong></div><div class="agenda-item"><span>02</span><strong>Landscaping contract</strong></div><div class="agenda-item"><span>03</span><strong>Next meeting date</strong></div><div class="attendance"><div class="attendee-marks">{[1,2,3,4,5,6,7].map(n => <i class:list={{attending:n<=5}}></i>)}</div><span><strong>5 of 7</strong> board members attending</span></div></div>
<div class="floating-note minutes-note"><span class="note-icon"><FeatureIcon name="documents" /></span><span><strong>Meeting minutes</strong><small>Draft ready for board review</small></span></div>
