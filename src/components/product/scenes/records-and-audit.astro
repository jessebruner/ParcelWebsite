---
/**
 * records-and-audit — the hero diagram.
 *
 * Lifted verbatim from the nine-in-one FeatureScene so it can be rebuilt
 * without touching the other eight. It is still the static version.
 *
 * The shared chrome (.feature-scene, .scene-top, .scene-body) lives in
 * FeatureScene.astro and is inherited. Styles that belong only to this
 * scene belong in this file.
 */
---

<div class="records scene-body">
      <div class="record-list">
        <div><span>Meeting decision</span><i></i></div>
        <div><span>Board approval</span><i></i></div>
        <div><span>Document update</span><i></i></div>
        <div><span>Association export</span><i></i></div>
      </div>
      <div class="export-box"><span class="pixel-box"></span><b>Export package</b></div>
      <p class="scene-note">Illustrative association records.</p>
    </div>
