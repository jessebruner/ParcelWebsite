---
import FeatureIcon from "../FeatureIcon.astro";
---
<div class="archive-tab"><FeatureIcon name="records" /><span>Association records</span></div>
<div class="sheet archive-sheet"><div class="sheet-heading"><span class="paper-title">Ready for the next board.</span></div><div class="archive-row"><span class="document-tile"><FeatureIcon name="documents" /></span><span><strong>Board minutes.pdf</strong><small>September 9, 2026</small></span><span class="file-type">PDF</span></div><div class="archive-row"><span class="document-tile"><FeatureIcon name="books" /></span><span><strong>2026 budget.csv</strong><small>Annual association budget</small></span><span class="file-type">CSV</span></div><div class="archive-row"><span class="document-tile"><FeatureIcon name="documents" /></span><span><strong>Insurance policy.pdf</strong><small>Current policy document</small></span><span class="file-type">PDF</span></div></div>
<div class="export-connector"><span></span><FeatureIcon name="download" /><span></span></div><div class="archive-export"><span class="export-icon"><FeatureIcon name="records" /></span><span><strong>Records export</strong><small>A copy the board can keep.</small></span></div>
