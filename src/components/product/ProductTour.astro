---
const panels = [
  { id: "dues", label: "Collect dues online", title: "See who has paid and what’s still due.", text: "Give owners a place to check their balance and pay online. Your board can review invoices, payments, and unpaid balances by lot. Online payments require the association’s connected payment account.", link: "/product/dues-and-payments", linkLabel: "See dues and payments" },
  { id: "documents", label: "Answer resident questions", title: "Get answers from your HOA documents.", text: "Ask a question about your bylaws, declaration, or rules. Common Parcel finds the relevant passage so you can read the answer and check the original without searching every document yourself.", link: "/product/documents-and-answers", linkLabel: "See documents and answers" },
  { id: "meetings", label: "Run board meetings", title: "Have the agenda, votes, and minutes ready.", text: "Plan meetings and keep attendance, voting records, and minutes in one place. When someone asks what the board decided, the record is easy to find.", link: "/product/meetings-and-voting", linkLabel: "See meetings and voting" },
];
---
<div class="tour" data-tour>
  <div class="tour-tabs" aria-label="Explore common board tasks">
    {panels.map((panel, i) => <button type="button" id={`tab-${panel.id}`} aria-controls={`panel-${panel.id}`} data-tab={i}>{panel.label}<span aria-hidden="true">↗</span></button>)}
  </div>
  {panels.map((panel, i) => <div class="tour-panel" id={`panel-${panel.id}`} data-panel={i}>
    <div class="tour-copy"><h3>{panel.title}</h3><p>{panel.text}</p><a class="text-link" href={panel.link}>{panel.linkLabel}<span aria-hidden="true">→</span></a></div>
    <div class="example">
      <div class="example-caption"><span>Example association</span><span>Illustration</span></div>
      {panel.id === "dues" && <div class="example-body">
        <div class="example-title"><span>Autumn Ridge</span><span class="small">Dues overview</span></div>
        <div class="balance"><span>Collected this month</span><strong>$8,550<span>.00</span></strong><p>30 of 32 lots paid</p></div>
        <div class="progress" aria-hidden="true"><span></span></div>
        <div class="example-row"><span>Lot 12 <small>September dues</small></span><span class="status">Paid</span><b>$285.00</b></div>
        <div class="example-row"><span>Lot 14 <small>September dues</small></span><span class="status pending">Due</span><b>$285.00</b></div>
        <div class="example-foot">A clear record for the board and each resident.</div>
      </div>}
      {panel.id === "documents" && <div class="example-body">
        <div class="example-title"><span>Association documents</span><span class="small">Question & source</span></div>
        <div class="sample-question">When are our annual dues due?</div>
        <p class="sample-answer">The sample declaration sets the due date at January 1.</p>
        <blockquote><span class="small">Sample declaration · Page 6</span>“The annual assessment shall be due and payable on the first day of January.”</blockquote>
        <div class="example-foot">Read the source before relying on an answer.</div>
      </div>}
      {panel.id === "meetings" && <div class="example-body">
        <div class="example-title"><span>September board meeting</span><span class="small">Meeting records</span></div>
        <p class="sample-answer">The agenda and the decisions, together.</p>
        {[["Meeting agenda", "Budget review and landscaping contract"], ["Attendance and votes", "Record who attended and how they voted"], ["Meeting minutes", "Decisions saved for the board to review"]].map(([title, sub]) => <div class="record-row"><span class="file-icon" aria-hidden="true">≡</span><span><b>{title}</b><small>{sub}</small></span><span aria-hidden="true">↗</span></div>)}
        <div class="example-foot">Review and approve minutes under your association’s rules.</div>
      </div>}
    </div>
  </div>)}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-tour]").forEach(tour => {
    const tabs = Array.from(tour.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(tour.querySelectorAll<HTMLElement>("[data-panel]"));
    tour.querySelector(".tour-tabs")!.setAttribute("role", "tablist");
    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => { tab.setAttribute("role", "tab"); tab.setAttribute("aria-selected", String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; panel.setAttribute("role", "tabpanel"); panel.setAttribute("aria-labelledby", tabs[i].id); panel.tabIndex = 0; });
      if (focus) tabs[index].focus();
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", event => {
        let next = i;
        if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (i + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault(); select(next, true);
      });
    });
    tour.dataset.enhanced = "true";
    select(0);
  });
</script>
<style>
  .tour[data-enhanced] .tour-tabs { display: flex; }
  .tour-tabs { display: none; border-bottom: var(--stroke-edge); gap: 32px; }
  .tour-tabs button { padding: 18px 0; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--ink-3); font-size: 17px; text-align: left; display: flex; align-items: center; gap: 28px; min-height: 56px; }
  .tour-tabs button[aria-selected="true"] { color: var(--terracotta); border-bottom-color: var(--terracotta); }
  .tour-tabs button:hover { color: var(--terracotta); }
  .tour[data-enhanced] .tour-panel:not([hidden]) { animation: panel-in .22s ease-out; }
  @keyframes panel-in { from { opacity: .5; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  .tour-panel { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 7vw, 100px); align-items: center; padding-top: 48px; }
  .tour-copy h3 { font: 450 clamp(28px, 3vw, 40px)/1.22 var(--font-serif); letter-spacing: -.035em; margin: 0; max-width: 20ch; }
  .tour-copy > p:not(.eyebrow) { max-width: 36em; color: var(--ink-2); margin-block: 22px; }
  .tour-copy a { font-size: 15px; }
  .example { background: var(--card); border: var(--stroke-edge); min-width: 0; }
  .example-caption { display: flex; justify-content: space-between; gap: 12px; padding: 11px 22px; background: var(--field); border-bottom: var(--stroke-edge); font: 400 12px/1.6 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .example-body { padding: 24px 28px 0; min-height: 365px; }
  .example-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 20px; border-bottom: var(--stroke-edge); font-weight: 600; font-size: 15px; }
  .small, small { font-size: 12px; color: var(--ink-3); font-weight: 400; }
  .balance { margin-top: 22px; } .balance > span { font-size: 13px; color: var(--ink-3); }
  .balance strong { display: block; font: 500 42px/1.25 var(--font-sans); letter-spacing: -.04em; color: var(--ink); }
  .balance strong span { font-size: 25px; color: var(--ink-3); }
  .balance p { margin: 6px 0 12px; font-size: 12px; }
  .progress { height: 5px; background: var(--field); margin-bottom: 18px; }.progress span { height: 100%; width: 93.75%; display: block; background: var(--terracotta); }
  .example-row { display: flex; align-items: center; gap: 16px; padding: 12px 0; border-top: var(--stroke-rule); font-size: 13px; }.example-row > span:first-child { margin-right: auto; }.example-row small { display: block; }.example-row b { font: 400 12px var(--font-mono); }
  .status { background: var(--field); color: var(--ink-2); padding: 2px 8px; font-size: 12px; }.pending { background: var(--held); color: var(--terracotta); }
  .example-foot { border-top: var(--stroke-edge); padding: 14px 0; font-size: 12px; color: var(--ink-3); margin-top: 14px; }
  .sample-question { margin-top: 22px; padding: 12px 16px; background: var(--field); font-size: 15px; }.sample-answer { font-size: 16px; }
  blockquote { border-left: 2px solid var(--terracotta); margin: 20px 0; padding: 0 0 0 18px; font: 400 17px/1.6 var(--font-serif); } blockquote .small { display: block; font: 400 12px/1.6 var(--font-mono); margin-bottom: 8px; }
  .record-row { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-top: var(--stroke-rule); font-size: 14px; }.record-row small { display: block; }.record-row > span:last-child { margin-left: auto; }.file-icon { color: var(--terracotta); border: var(--stroke-edge); width: 30px; height: 36px; text-align: center; font-size: 22px; }
  @media(max-width: 760px) { .tour-tabs { gap: 14px; }.tour-tabs button { font-size: 14px; flex: 1; gap: 6px; }.tour-tabs button span { display: none; }.tour-panel { grid-template-columns: 1fr; gap: 28px; padding-top: 28px; }.tour-copy h3 { max-width: 26ch; }.example-body { padding-inline: 20px; min-height: 0; }.example-title { flex-wrap: wrap; }.example-row { gap: 10px; } }
</style>
