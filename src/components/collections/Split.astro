---
/**
 * A SPLIT ROW: an exhibit on one side, the argument on the other.
 *
 * Stack two of these with `flip` on the second and the eye crosses the page
 * instead of running down one gutter, which is what stops a long feature page
 * reading as a list. Below 900px it stacks and the exhibit always follows its
 * own prose, because a chart above the sentence that explains it is a chart
 * nobody reads.
 *
 * The exhibit goes in the `figure` slot. Everything else is the default slot.
 */
interface Props {
  /** Puts the exhibit on the left and the prose on the right. */
  flip?: boolean;
}
const { flip = false } = Astro.props;
---

<div class:list={["split", { flip }]}>
  <div class="say"><slot /></div>
  <div class="fig"><slot name="figure" /></div>
</div>

<style>
  .split { display: grid; gap: var(--s-8); align-items: start; }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(40px, 5vw, 80px);
    }
    .split.flip > .say { order: 2; }
    .split.flip > .fig { order: 1; }
  }

  .say { min-width: 0; max-width: var(--read); }
  .say > * + * { margin-top: var(--s-4); }
  .fig { min-width: 0; }

  /* Sub-heads inside a split are the name of a thing, so Literata, and they sit
     one step under the section's own heading. */
  .say :global(h3) { color: var(--ink); }
  .say :global(p) { margin: 0; text-wrap: pretty; }
</style>
