---
/**
 * THE AGING CHART, PORTED FROM THE PRODUCT.
 *
 * A recreation of ParcelHOA's src/components/parcel/charts/AgingBarChart.tsx:
 * the same three buckets, the same status wording, the same lot count and the
 * same dollar figures. Showing the real chart is the point. A diagram invented
 * for a marketing page would be a picture of software that does not exist.
 *
 * Three deliberate departures, each because the original breaks a rule this
 * site is held to:
 *
 *   1. No border-radius. The original rounds the bar by 3px and draws the
 *      legend markers as circles at 50%. Both are gone. The markers are square
 *      with a bottom edge one eleventh of their height, which is the tile motif
 *      and is what a lot looks like everywhere else in this system.
 *
 *   2. Clay fills, it never sets text. The original sets the overdue figure to
 *      `color: var(--clay)`, which fails contrast as a foreground. Here clay
 *      fills the first bar segment and the figure is terracotta.
 *
 *   3. The bar reconciles. The original sizes the paid segment by share of lots
 *      and each overdue segment by share of dollars with a 4% floor, so with its
 *      own default data the segments total about 109% and the last one is
 *      clipped by overflow: hidden. Here the bar is one basis, dollars, summing
 *      to the footing beneath it. Every list in this system ends in a footing
 *      whose numbers reconcile to the rows above it, and a bar is a list.
 */

interface Bucket {
  /** Verbatim from DEFAULT_OVERDUE_BUCKETS. */
  label: string;
  statusTag: string;
  amount: number;
  /** A fill token. Never used to set text. */
  fill: string;
  /** The matching edge token, for the tile's bottom edge. */
  edge: string;
}

interface Props {
  buckets?: Bucket[];
  totalLots?: number;
  overdueCount?: number;
  caption?: string;
}

const DEFAULT_BUCKETS: Bucket[] = [
  { label: "30 days late", statusTag: "Friendly reminder sent", amount: 175, fill: "var(--clay)", edge: "var(--clay-edge)" },
  { label: "60 days late", statusTag: "Late fee and interest accruing", amount: 175, fill: "var(--terracotta)", edge: "var(--board-edge)" },
  { label: "90+ days late", statusTag: "Statutory lien notice eligible", amount: 1035, fill: "var(--amber)", edge: "var(--amber-edge)" },
];

const {
  buckets = DEFAULT_BUCKETS,
  totalLots = 118,
  overdueCount = 3,
  caption = "Sample data, drawn the way the dashboard draws it",
} = Astro.props;

const total = buckets.reduce((sum, b) => sum + b.amount, 0);
const pct = (n: number) => (n / total) * 100;
const money = (n: number) => `$${n.toLocaleString("en-US")}`;
---

<figure class="chart">
  <div class="head">
    <div>
      <p class="lab">Overdue dues and late accounts</p>
      <p class="sub">{overdueCount} of {totalLots} lots behind on dues</p>
    </div>
    <p class="figure">{money(total)} overdue</p>
  </div>

  <div class="bar" role="img" aria-label={`Overdue balance of ${money(total)}, split across ${buckets.length} age buckets: ${buckets.map((b) => `${b.label}, ${money(b.amount)}`).join("; ")}.`}>
    {buckets.map((b) => (
      <span style={`flex-grow:${pct(b.amount)}; background:${b.fill}`}></span>
    ))}
  </div>

  <ul>
    {buckets.map((b) => (
      <li>
        {/* Order matters: the amount has to be placed before the tag, or grid
            auto-placement puts the tag on row two and pushes the amount to a
            row of its own instead of setting it against the bucket name. */}
        <span class="tile" aria-hidden="true" style={`background:${b.fill}; border-bottom:1px solid ${b.edge}`}></span>
        <span class="name">{b.label}</span>
        <span class="amt">{money(b.amount)}</span>
        <span class="tag">{b.statusTag}</span>
      </li>
    ))}
  </ul>

  <div class="foot">
    <span>Overdue total</span>
    <span class="fv">{money(total)}</span>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chart {
    margin: 0;
    border: var(--stroke-consequence);
    background: var(--card);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-5) var(--s-4);
  }
  .lab {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .sub { margin: var(--s-2) 0 0; font-size: var(--t-micro); color: var(--ink-2); }
  .figure {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--t-title);
    letter-spacing: -0.02em;
    color: var(--terracotta);
    white-space: nowrap;
  }

  /*
   * Segmented rather than butted together, and every segment carries its own
   * 1px ink outline.
   *
   * A butted stacked bar needs one divider colour that reads against all three
   * fills, and there is no such token here: ink is 2.12:1 against terracotta,
   * paper is 1.92:1 against amber, and clay against terracotta is 1.80:1 with no
   * divider at all. An ink outline on each segment is 14.04:1 against the card
   * showing through the gap, so every boundary clears the 3:1 that a meaningful
   * graphic owes, whatever the fills are.
   *
   * flex-grow with a zero basis, not width percentages, so the two 2px gaps come
   * off the total before the proportions are struck rather than pushing the last
   * segment past the end. The original chart sized segments on two different
   * bases with a floor and totalled about 109%.
   */
  .bar {
    display: flex;
    gap: 2px;
    height: 18px;
    margin: 0 var(--s-5);
  }
  .bar > span {
    flex-basis: 0;
    min-width: 3px;
    border: 1px solid var(--ink);
  }

  ul {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0 var(--s-5);
  }
  ul > li {
    display: grid;
    grid-template-columns: 11px minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--s-3);
    row-gap: 2px;
    padding-block: var(--s-3);
    border-bottom: var(--stroke-hairline);
  }
  ul > li:last-child { border-bottom: none; }

  .tile { width: 11px; height: 11px; align-self: center; }
  .name { font-weight: 600; color: var(--ink); }
  .amt {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--t-mono-data);
    color: var(--ink);
    white-space: nowrap;
    text-align: right;
  }
  /* The status wording is the redundant carrier: the buckets are separable
     without reading a single fill. */
  .tag {
    grid-column: 2 / 4;
    font-size: var(--t-micro);
    color: var(--ink-3);
  }

  .foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin: 0 var(--s-5);
    padding: var(--s-3) 0;
    border-top: var(--stroke-consequence);
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .fv {
    font-size: var(--t-title);
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--terracotta);
    font-variant-numeric: tabular-nums;
  }

  figcaption {
    padding: var(--s-3) var(--s-5) var(--s-4);
    border-top: var(--stroke-hairline);
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
