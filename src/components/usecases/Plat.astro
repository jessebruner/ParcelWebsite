---
/**
 * A PLAT: LOTS AS TILES, ONE TILE PER DOOR.
 *
 * Ported from ParcelHOA's src/components/parcel/Tile.tsx and the `.tile` block
 * in its globals.css rather than approximated. What is carried across:
 *
 *   · A tile is square and its bottom edge is one eleventh of its size, snapped
 *     to whole pixels. That edge is the whole difference between a tile and a
 *     coloured cell, and a soft edge would read as a shadow.
 *   · The field gap is 4px at the 22px tile, which is two elevenths of the
 *     tile. Held at that ratio for the smaller sizes this page needs: a fixed
 *     4px gap around a 7px tile is a grid of gaps with tiles in it.
 *   · No radius. No shadow. Ever.
 *
 * Both are computed here in whole pixels rather than with CSS round(), so the
 * geometry is exact and does not depend on the browser supporting it.
 *
 * ONLY THE `current` STATE IS DRAWN, and that is deliberate. Tile.tsx has four,
 * and three of them report something about a real lot: a clock advancing, an
 * escalation waiting on a board vote, a lot a person deliberately froze. This
 * page has no lots, so a notched tile here would be inventing a status. These
 * plats say how many doors and nothing else, which is also why they are
 * aria-hidden and the count sits in text beside them.
 */
interface Props {
  cols: number;
  rows: number;
  /** Tile edge in px above 900px, where the card is wide. */
  size: number;
  /** Tile edge in px at 900px and below. */
  small: number;
}
const { cols, rows, size, small } = Astro.props;

const edge = (s: number) => Math.max(1, Math.round(s / 11));
const gap = (s: number) => Math.max(1, Math.round((s * 2) / 11));
const vars = [
  `--cols:${cols}`,
  `--t:${size}px`, `--e:${edge(size)}px`, `--g:${gap(size)}px`,
  `--t-sm:${small}px`, `--e-sm:${edge(small)}px`, `--g-sm:${gap(small)}px`,
].join(";");
---

<div class="plat" aria-hidden="true" style={vars}>
  {Array.from({ length: cols * rows }, () => <span class="tile"></span>)}
</div>

<style>
  .plat {
    --tile: var(--t-sm);
    --edge: var(--e-sm);
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--tile));
    gap: var(--g-sm);
    width: max-content;
  }
  @media (min-width: 901px) {
    .plat { --tile: var(--t); --edge: var(--e); gap: var(--g); }
  }

  .tile {
    display: block;
    box-sizing: border-box;
    width: var(--tile);
    height: var(--tile);
    background: var(--bisque);
    border-bottom: var(--edge) solid var(--bisque-edge);
  }
</style>
