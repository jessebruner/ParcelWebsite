---
/**
 * The heron. The identity motif, and nothing else.
 *
 * Same 48x48 pixel mask as the favicon and the app icon. The band is the
 * identity, the tile is status, and they never share a surface. Do not use this
 * to decorate a section.
 */
interface Props { size?: number; fill?: string; beak?: string; }
const { size = 34, fill = "var(--ink)", beak = "var(--terracotta)" } = Astro.props;
---
{/*
  The colours go in style, not in the fill attribute, and the reason is worth a
  note because the wrong form fails silently.

  Both props are token references. SVG2 says presentation attributes "are
  parsed as CSS values, not declarations", and var() substitution is defined
  over declarations, so fill="var(--paper)" is most likely never substituted:
  the attribute is invalid and fill falls back to black. In the footer lockup
  that is a black heron on --night, which is an invisible logo, and on light
  surfaces --ink is nearly black so the same bug would look almost right.

  I have not seen this in a browser. Nobody on this team has one, which is
  exactly why the attribute form is the wrong bet: a style attribute holds real
  declarations, var() resolves there without argument, and it is correct
  whichever way the attribute question goes.
*/}
<svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" style={`flex:0 0 auto;fill:${fill}`}>
  <rect x="24" y="4" width="9" height="6"></rect>
  <rect x="33" y="6" width="12" height="3" style={`fill:${beak}`}></rect>
  <rect x="25" y="10" width="5" height="10"></rect>
  <rect x="12" y="20" width="21" height="11"></rect>
  <rect x="18" y="31" width="3" height="13"></rect>
  <rect x="14" y="44" width="8" height="2"></rect>
  <rect x="25" y="31" width="3" height="6"></rect>
  <rect x="28" y="37" width="5" height="3"></rect>
</svg>
