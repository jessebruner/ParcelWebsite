---
import { price, money, type Bracket } from "./brackets";

interface Props {
  brackets: Bracket[];
  minimum: number;
  lots?: number;
  includes?: string[];
}

/**
 * This calculator mirrors the homepage pricing widget so the two never
 * disagree: the same 4-to-1,000-lot logarithmic track (4 × 250^(t/200)),
 * the same snap grid, the same whole-dollar figure. The homepage caps its
 * slider at 1,000 lots; so does this one, and the number field accepts up
 * to 5,000 for the associations past the cap. Exact cents live in the
 * rate-card table inside the expander; the big figure rounds to the dollar
 * the way the homepage does.
 */
const STEPS = 200;
const S_MIN = 4;
const S_MAX = 1000;
const FACTOR = S_MAX / S_MIN;
const toPos = (n: number) =>
  Math.max(0, Math.min(STEPS, Math.round((STEPS * Math.log(n / S_MIN)) / Math.log(FACTOR))));

const { brackets, minimum, lots = 4, includes = [] } = Astro.props;
const p = price(brackets, lots, minimum);
const cfg = JSON.stringify({ brackets, minimum });
const dollars = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
const count = (n: number) => `${n.toLocaleString("en-US")} ${n === 1 ? "lot" : "lots"}`;
const startPos = toPos(lots);
const startPct = (100 * startPos) / STEPS;
---

<div class="pc" data-calc data-cfg={cfg}>
  <div class="pc-grid">
    <div class="pc-main">
      <span class="pc-total-label">Monthly software price</span>
      <p class="pc-out">
        <span class="pc-figure" data-total aria-hidden="true">{dollars(p.total)}</span>
      </p>
      <p class="pc-meta" aria-hidden="true">
        Per month · <span data-perlot>{money(p.perLot)}</span> per lot
      </p>
      <span class="pc-sr" data-total-sr aria-live="polite" aria-atomic="true">
        {dollars(p.total)} per month, {money(p.perLot)} per lot
      </span>
      <p class="pc-floor" data-floor hidden={!p.floored}>
        The rate card adds to <span data-raw>{money(p.raw)}</span>. The {money(minimum, 0)} monthly minimum applies.
      </p>

      <hr class="pc-rule" />

      <div class="pc-size-head">
        <label class="pc-label" for="lots">Association size</label>
        <span class="pc-count">
          <input
            id="lots"
            class="pc-input"
            type="number"
            min="1"
            max="5000"
            step="1"
            value={lots}
            inputmode="numeric"
            autocomplete="off"
            aria-describedby="lots-hint"
            data-count-input
          />
          <span aria-hidden="true">lots</span>
        </span>
      </div>

      <div class="pc-slider">
        <div class="pc-track" aria-hidden="true">
          <div class="pc-fill" data-fill style={`width: calc(${startPct}% + ${15 - 0.3 * startPct}px)`}></div>
        </div>
        <div class="pc-ticks" aria-hidden="true">
          {[0, 25, 50, 75, 100].map((t) => <span style={`left: ${t}%`}></span>)}
        </div>
        <input
          class="pc-range"
          type="range"
          min="0"
          max={STEPS}
          step="1"
          value={startPos}
          aria-label="Association lot count"
          aria-valuemin={S_MIN}
          aria-valuemax={S_MAX}
          aria-valuenow={lots}
          aria-valuetext={count(lots)}
          data-range
        />
      </div>
      <div class="pc-ends" aria-hidden="true">
        <span>4 lots</span>
        <span class="pc-drag">← drag →</span>
        <span>1,000</span>
      </div>
    </div>

    <aside class="pc-includes" aria-label="What the price includes">
      <span class="pc-includes-label">Everything included</span>
      <ul class="pc-includes-list">
        {includes.map((item, i) => (
          <li style={`--d: ${i * 35}ms`}>
            <span class="pc-check" aria-hidden="true">✓</span>
            {item}
          </li>
        ))}
      </ul>
      <p class="pc-includes-note">Monthly billing. No setup fee. No feature tiers.</p>
    </aside>
  </div>

  <details class="pc-details">
    <summary>
      <span class="pc-sum-label">How this price is calculated</span>
      <span class="pc-sum-mark" aria-hidden="true"></span>
    </summary>
    <div class="pc-sheet">
      <div class="pc-head">
        <span class="pc-head-label" id="pc-working">Graduated rate card</span>
        <span class="pc-head-note" data-count>{count(p.lots)}</span>
      </div>

      <div class="pc-scroll">
        <table aria-labelledby="pc-working">
          <thead>
            <tr>
              <th scope="col">Lots in band</th>
              <th scope="col">Rate</th>
              <th scope="col">Your lots</th>
              <th scope="col">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {p.bands.map((b, i) => (
              <tr class:list={["pc-row", { "is-empty": b.lots === 0 }]} data-band={i}>
                <th scope="row">{b.label}</th>
                <td class="num">{money(b.rate)}</td>
                <td class="num" data-band-lots>{b.lots.toLocaleString("en-US")}</td>
                <td class="num" data-band-amount>{money(b.amount)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Rate card total</th>
              <td></td>
              <td class="num" data-foot-lots>{p.lots.toLocaleString("en-US")}</td>
              <td class="num" data-foot-raw>{money(p.raw)}</td>
            </tr>
            <tr data-floor-row hidden={!p.floored}>
              <th scope="row">Monthly minimum</th>
              <td></td>
              <td></td>
              <td class="num">{money(minimum)}</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="pc-sheet-note" id="lots-hint">
        Count each unit that owes an assessment. Common areas do not count. The big figure rounds
        to the dollar; this card is the exact arithmetic.
      </p>
    </div>
  </details>
</div>

<style>
  .pc { border: 1.5px solid var(--on-dark-tile); background: var(--night-hover); }
  .pc-grid { display: grid; gap: clamp(28px, 4vw, 56px); padding: clamp(24px, 4vw, 56px); }
  @media (min-width: 900px) {
    .pc-grid { grid-template-columns: minmax(22em, 1.2fr) minmax(16em, 0.8fr); align-items: stretch; }
  }

  .pc-total-label, .pc-meta, .pc-ends, .pc-includes-label, .pc-head-label, .pc-head-note {
    font-family: var(--font-mono); font-size: var(--t-mono-label); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .pc-total-label { color: var(--on-dark-label); }
  .pc-out { margin: var(--s-3) 0 0; }
  .pc-figure {
    display: inline-block; min-width: 4ch; color: var(--amber); font-family: var(--font-mono);
    font-size: clamp(64px, 9vw, 124px); font-variant-numeric: tabular-nums; letter-spacing: -0.06em; line-height: 0.86;
  }
  .pc-meta { margin: var(--s-4) 0 0; color: var(--on-dark-label); }
  .pc-meta [data-perlot] { color: var(--paper); font-variant-numeric: tabular-nums; }
  .pc-floor { max-width: 40ch; margin: var(--s-3) 0 0; color: var(--mist); font-size: var(--t-micro); line-height: 1.5; }
  .pc-floor[hidden] { display: none; }
  .pc-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  .pc-rule { margin: clamp(24px, 3vw, 40px) 0; border: 0; border-top: 1px solid var(--on-dark-rule); }

  .pc-size-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); }
  .pc-label {
    color: var(--on-dark-label); font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .pc-count {
    display: inline-flex; align-items: baseline; justify-content: space-between; gap: var(--s-2);
    flex: none; width: 128px; box-sizing: border-box; padding: 5px 13px;
    border: 1.5px solid var(--amber); background: var(--paper);
  }
  .pc-input {
    width: 5ch; min-height: 32px; padding: 0; border: 0; background: transparent; color: var(--ink);
    font-family: var(--font-mono); font-size: var(--t-title); font-variant-numeric: tabular-nums;
  }
  .pc-input:focus-visible { outline: none; }
  .pc-count:focus-within { outline: 2px solid var(--amber); outline-offset: 2px; }
  .pc-count > span { color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-mono-label); letter-spacing: 0.14em; text-transform: uppercase; }
  .pc-input::-webkit-outer-spin-button, .pc-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pc-input[type="number"] { -moz-appearance: textfield; appearance: textfield; }

  /* The slider is built like the homepage's: a bordered 14px channel, a
     bisque fill that ends in an amber edge, hairline ticks below, and a
     terracotta thumb with three grip lines. */
  .pc-slider { position: relative; height: 44px; margin-top: var(--s-4); }
  .pc-track {
    position: absolute; left: 0; right: 0; top: 15px; height: 14px;
    background: rgba(251, 248, 244, 0.08); border: 1px solid var(--on-dark-rule); box-sizing: border-box;
  }
  .pc-fill {
    position: absolute; left: 0; top: 0; bottom: 0; max-width: 100%;
    background: var(--bisque); border-right: 1.5px solid var(--amber);
  }
  .pc-ticks span {
    position: absolute; top: 31px; width: 1px; height: 6px;
    background: var(--on-dark-rule); transform: translateX(-0.5px);
  }
  .pc-range {
    -webkit-appearance: none; appearance: none;
    position: absolute; inset: 0; width: 100%; height: 44px; margin: 0;
    background: transparent; cursor: pointer;
  }
  .pc-range::-webkit-slider-runnable-track { height: 44px; background: transparent; }
  .pc-range::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 30px; height: 28px; margin-top: 8px; border: 0; border-radius: 0;
    background-color: var(--terracotta);
    background-image: linear-gradient(
      to right,
      transparent 9px, rgba(251, 248, 244, 0.75) 9px, rgba(251, 248, 244, 0.75) 10.5px,
      transparent 10.5px, transparent 14.25px, rgba(251, 248, 244, 0.75) 14.25px, rgba(251, 248, 244, 0.75) 15.75px,
      transparent 15.75px, transparent 19.5px, rgba(251, 248, 244, 0.75) 19.5px, rgba(251, 248, 244, 0.75) 21px,
      transparent 21px
    );
    background-size: 30px 12px; background-position: center; background-repeat: no-repeat;
    transition: box-shadow 140ms ease;
  }
  .pc-range:hover::-webkit-slider-thumb, .pc-range:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 5px rgba(232, 168, 124, 0.22);
  }
  .pc-range::-moz-range-track { height: 44px; background: transparent; }
  .pc-range::-moz-range-thumb {
    width: 30px; height: 28px; border: 0; border-radius: 0;
    background-color: var(--terracotta);
    background-image: linear-gradient(
      to right,
      transparent 9px, rgba(251, 248, 244, 0.75) 9px, rgba(251, 248, 244, 0.75) 10.5px,
      transparent 10.5px, transparent 14.25px, rgba(251, 248, 244, 0.75) 14.25px, rgba(251, 248, 244, 0.75) 15.75px,
      transparent 15.75px, transparent 19.5px, rgba(251, 248, 244, 0.75) 19.5px, rgba(251, 248, 244, 0.75) 21px,
      transparent 21px
    );
    background-size: 30px 12px; background-position: center; background-repeat: no-repeat;
    transition: box-shadow 140ms ease;
  }
  .pc-range:hover::-moz-range-thumb, .pc-range:focus-visible::-moz-range-thumb {
    box-shadow: 0 0 0 5px rgba(232, 168, 124, 0.22);
  }
  .pc-range:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; }

  .pc-ends { display: flex; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-2); color: var(--on-dark-label); }
  .pc-drag { color: var(--amber); }

  .pc-includes {
    display: flex; flex-direction: column; box-sizing: border-box; min-width: 0;
    background: rgba(251, 248, 244, 0.05); border: 1.5px solid var(--on-dark-rule);
    padding: clamp(20px, 2.6vw, 32px);
  }
  .pc-includes-label { color: var(--amber); }
  .pc-includes-list { list-style: none; margin: var(--s-4) 0 0; padding: 0; flex: 1; }
  .pc-includes-list li {
    display: flex; align-items: baseline; gap: var(--s-3); padding-block: 5px;
    color: var(--mist); font-size: var(--t-micro); line-height: 1.45;
  }
  .pc-check { color: var(--amber); font-family: var(--font-mono); font-size: var(--t-mono-data); }
  .pc-includes-note {
    margin: var(--s-4) 0 0; padding-top: var(--s-4); border-top: 1px solid var(--on-dark-rule);
    color: var(--on-dark-label); font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.8;
  }

  /* Reveal: the card eases up once, list rows follow in a quiet stagger.
     The hidden start state only exists once the script adds .js-reveal, so
     a visitor without JavaScript always sees the card. */
  @media (prefers-reduced-motion: no-preference) {
    .pc.js-reveal { opacity: 0; transform: translateY(14px); transition: opacity 500ms ease, transform 500ms ease; }
    .pc.js-reveal.is-in { opacity: 1; transform: none; }
    .pc.js-reveal .pc-includes-list li { opacity: 0; transform: translateY(6px); transition: opacity 360ms ease var(--d, 0ms), transform 360ms ease var(--d, 0ms); }
    .pc.js-reveal.is-in .pc-includes-list li { opacity: 1; transform: none; }
  }

  .pc-details { border-top: 1px solid var(--on-dark-rule); }
  .pc-details summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    min-height: 52px; padding: 14px clamp(24px, 4vw, 56px); color: var(--paper);
    font-family: var(--font-sans); font-weight: 650; cursor: pointer; list-style: none;
  }
  .pc-details summary::-webkit-details-marker { display: none; }
  .pc-details summary:hover { background: var(--night-hover); }
  .pc-details[open] summary { border-bottom: 1px solid var(--on-dark-rule); }
  .pc-sum-mark { position: relative; width: 14px; height: 14px; flex: none; }
  .pc-sum-mark::before, .pc-sum-mark::after {
    content: ""; position: absolute; background: var(--amber); transition: transform 160ms ease;
  }
  .pc-sum-mark::before { left: 0; top: 6px; width: 14px; height: 2px; }
  .pc-sum-mark::after { left: 6px; top: 0; width: 2px; height: 14px; }
  .pc-details[open] .pc-sum-mark::after { transform: scaleY(0); }
  .pc-sheet { margin: clamp(20px, 3vw, 40px); border: var(--stroke-consequence); background: var(--paper); }
  .pc-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: 11px 18px; background: var(--field); }
  .pc-head-label { color: var(--ink-2); }
  .pc-head-note { color: var(--terracotta); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pc-scroll { overflow-x: auto; padding: var(--s-2) 18px var(--s-4); }
  .pc-sheet th[scope="col"]:not(:first-child), .pc-sheet td { text-align: right; }
  .pc-sheet tbody th[scope="row"] {
    padding: var(--s-3) var(--s-4) var(--s-3) 0; border-bottom: var(--stroke-hairline); color: var(--ink);
    font-family: var(--font-sans); font-size: var(--t-body); font-weight: 400; letter-spacing: 0; text-transform: none; white-space: nowrap;
  }
  .pc-row.is-empty th, .pc-row.is-empty td { color: var(--ink-3); }
  .pc-sheet tfoot th, .pc-sheet tfoot td { padding-top: var(--s-3); border-top: var(--stroke-consequence); border-bottom: 0; }
  .pc-sheet tfoot th[scope="row"] {
    color: var(--ink); font-family: var(--font-sans); font-size: var(--t-body); font-weight: 650; letter-spacing: 0; text-transform: none;
  }
  .pc-sheet tfoot tr[hidden] { display: none; }
  .pc-sheet-note { margin: 0; padding: var(--s-4) 18px; border-top: var(--stroke-hairline); color: var(--ink-2); font-size: var(--t-micro); line-height: 1.5; }

  @media (max-width: 560px) {
    .pc-size-head { align-items: start; flex-direction: column; gap: var(--s-3); }
    .pc-sheet { margin-inline: var(--s-3); }
  }
</style>

<script>
  import { price, money, clampLots, type Bracket } from "./brackets";

  interface Cfg { brackets: Bracket[]; minimum: number; }

  // Mirrors the homepage widget exactly: 4 × 250^(t/200), snapped to 1s
  // under 20 lots, 5s under 100, 10s above, capped at 1,000 on the track.
  const STEPS = 200;
  const S_MIN = 4;
  const S_MAX = 1000;
  const LN = Math.log(S_MAX / S_MIN);
  const toPos = (lots: number) =>
    Math.max(0, Math.min(STEPS, Math.round((STEPS * Math.log(lots / S_MIN)) / LN)));
  const toLots = (pos: number) => {
    const raw = S_MIN * Math.exp((LN * pos) / STEPS);
    const snapped = raw < 20 ? Math.round(raw) : raw < 100 ? Math.round(raw / 5) * 5 : Math.round(raw / 10) * 10;
    return Math.max(S_MIN, Math.min(S_MAX, snapped));
  };
  const dollars = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;

  const root = document.querySelector<HTMLElement>("[data-calc]");
  if (root) {
    const cfg: Cfg = JSON.parse(root.dataset.cfg!);
    const input = root.querySelector<HTMLInputElement>("[data-count-input]")!;
    const range = root.querySelector<HTMLInputElement>("[data-range]")!;
    const fill = root.querySelector<HTMLElement>("[data-fill]")!;
    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const n = (value: number) => value.toLocaleString("en-US");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    // The figure eases to its new value; the screen-reader copy of it does
    // not, so the live region announces once per change instead of per frame.
    const figure = q<HTMLElement>("[data-total]");
    let anim = 0;
    let shown = price(cfg.brackets, clampLots(Number(input.value)), cfg.minimum).total;
    const showTotal = (to: number, slow = false) => {
      cancelAnimationFrame(anim);
      if (reduced.matches || Math.round(to) === Math.round(shown)) {
        shown = to;
        figure.textContent = dollars(to);
        return;
      }
      const from = shown;
      const start = performance.now();
      const duration = slow ? 600 : 240;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        shown = from + (to - from) * eased;
        figure.textContent = dollars(shown);
        if (t < 1) anim = requestAnimationFrame(tick);
        else shown = to;
      };
      anim = requestAnimationFrame(tick);
    };

    const render = (lotCount: number, source?: HTMLInputElement) => {
      const result = price(cfg.brackets, lotCount, cfg.minimum);
      if (source !== input) input.value = String(lotCount);
      if (source !== range) range.value = String(toPos(lotCount));
      const pct = (100 * Number(range.value)) / STEPS;
      fill.style.width = `calc(${pct}% + ${15 - 0.3 * pct}px)`;
      range.setAttribute("aria-valuenow", String(lotCount));
      range.setAttribute("aria-valuetext", `${n(lotCount)} ${lotCount === 1 ? "lot" : "lots"}`);
      showTotal(result.total);
      q<HTMLElement>("[data-total-sr]").textContent = `${dollars(result.total)} per month, ${money(result.perLot)} per lot`;
      q<HTMLElement>("[data-perlot]").textContent = money(result.perLot);
      q<HTMLElement>("[data-count]").textContent = `${n(result.lots)} ${result.lots === 1 ? "lot" : "lots"}`;
      q<HTMLElement>("[data-foot-lots]").textContent = n(result.lots);
      q<HTMLElement>("[data-foot-raw]").textContent = money(result.raw);
      q<HTMLElement>("[data-floor]").hidden = !result.floored;
      q<HTMLElement>("[data-raw]").textContent = money(result.raw);
      q<HTMLElement>("[data-floor-row]").hidden = !result.floored;

      result.bands.forEach((band, index) => {
        const row = q<HTMLElement>(`[data-band="${index}"]`);
        row.classList.toggle("is-empty", band.lots === 0);
        row.querySelector<HTMLElement>("[data-band-lots]")!.textContent = n(band.lots);
        row.querySelector<HTMLElement>("[data-band-amount]")!.textContent = money(band.amount);
      });
    };

    input.addEventListener("input", () => render(clampLots(Number(input.value)), input));
    input.addEventListener("change", () => {
      const lotCount = clampLots(Number(input.value));
      input.value = String(lotCount);
      render(lotCount, input);
    });
    range.addEventListener("input", () => render(toLots(Number(range.value)), range));

    // Arrow keys step the lot count on the drag's own snap grid; stepping
    // the raw track position leaves presses that move nothing.
    range.addEventListener("keydown", (event) => {
      const lots = clampLots(Number(input.value));
      const grid = lots < 20 ? 1 : lots < 100 ? 5 : 10;
      let next: number | null = null;
      if (event.key === "ArrowRight" || event.key === "ArrowUp") next = Math.min(S_MAX, lots + grid);
      else if (event.key === "ArrowLeft" || event.key === "ArrowDown") next = Math.max(S_MIN, lots - grid);
      else if (event.key === "Home") next = S_MIN;
      else if (event.key === "End") next = S_MAX;
      if (next === null) return;
      event.preventDefault();
      render(next);
    });

    // Reveal once on scroll into view; the figure counts up from zero the
    // first time. Reduced motion gets the final state immediately.
    if (reduced.matches || !("IntersectionObserver" in window)) {
      root.classList.add("is-in");
    } else {
      root.classList.add("js-reveal");
      const target = shown;
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          io.disconnect();
          root.classList.add("is-in");
          shown = 0;
          showTotal(target, true);
        },
        { threshold: 0.3 }
      );
      io.observe(root);
    }
  }
</script>
