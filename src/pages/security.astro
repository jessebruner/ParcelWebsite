---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Band from "../components/Band.astro";
import PixelSky from "../components/PixelSky.astro";
import Panel from "../components/Panel.astro";

const logSampleRows = [
  { label: "Assessment invoice run (60 lots)", value: "2026-08-01 00:00", cite: "Automated schedule #1042" },
  { label: "Notice of violation: Lot 14", value: "2026-08-05 14:22", cite: "Signed: 2 officers #1043" },
  { label: "ACH dues payment received: Lot 29", value: "2026-08-07 09:15", cite: "Stripe payout settled #1044" },
  { label: "Association data export generated", value: "2026-08-10 16:40", cite: "Manifest report #1045" },
];
---

<Base
  title="Security and Account Access"
  description="Where association records live, who can reach them, what is logged, and how to export association files."
  path="/security"
>
  <Hero eyebrow="Security" seed={512}>
    <h1 class="t-display">Where your records live, and who can reach them</h1>
    <p class="t-lede">
      Common Parcel is built around direct financial custody, database-enforced governance rules, and
      complete operational attribution.
    </p>
  </Hero>

  <section class="sec-custody">
    <div class="page">
      <h2 class="t-sheet">Direct bank settlement with zero software custody</h2>
      <p class="sec-lede">
        Owners pay assessments through a connected Stripe account directly into the association's bank account.
        Common Parcel does not hold association funds, maintain account balances, or sit in custody of your money.
      </p>

      <div class="sec-flow">
        <div class="sec-step">
          <span class="step-num">01</span>
          <h3 class="t-title">Owner payment</h3>
          <p>Resident pays dues online via ACH, card, or scheduled autopay.</p>
        </div>
        <div class="sec-arrow" aria-hidden="true">→</div>
        <div class="sec-step">
          <span class="step-num">02</span>
          <h3 class="t-title">Connected Stripe account</h3>
          <p>Processing runs directly through the association's dedicated account.</p>
        </div>
        <div class="sec-arrow" aria-hidden="true">→</div>
        <div class="sec-step">
          <span class="step-num">03</span>
          <h3 class="t-title">Association bank</h3>
          <p>Payouts deposit directly into the association's depository account.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec-approval">
    <div class="page">
      <div class="sec-grid">
        <div class="sec-col-text">
          <h2 class="t-sheet">Two officers to authorize. One to halt.</h2>
          <p>
            Consequential actions such as notices, fines, and liens require two distinct current officers
            where the workflow enforces the gate.
          </p>
          <p>
            A database constraint enforces this rule directly: there is no single-click batch approval and no
            way for the software to sign on behalf of the board.
          </p>
          <p class="sec-coda">
            Halting an action is different. Any individual board officer can pause a pending action alone,
            because stopping is safe.
          </p>
        </div>

        <div class="sec-col-panel">
          <Panel
            label="Numbered Audit Log"
            note="Illustrative record"
            rows={logSampleRows}
            caption="Illustrative audit trail records"
          />
        </div>
      </div>
    </div>
  </section>

  <PixelSky mode="band" scene="dusk" seed={518} />

  <section class="sec-access">
    <div class="page">
      <h2 class="t-sheet">Access is scoped strictly by role</h2>
      <div class="sec-roles">
        <article class="role-card">
          <span class="t-mono-label">Homeowners</span>
          <h3 class="t-title">Personal records</h3>
          <p>Residents access statements and documents for their owned lots, submit requests, and vote in elections.</p>
        </article>

        <article class="role-card">
          <span class="t-mono-label">Board Officers</span>
          <h3 class="t-title">Association governance</h3>
          <p>Officers view the association roster, ledgers, vendor agreements, violation workflows, and voting tallies.</p>
        </article>

        <article class="role-card">
          <span class="t-mono-label">Platform Staff</span>
          <h3 class="t-title">Recorded administrative console</h3>
          <p>Staff access for technical support is isolated from ordinary customer archives and recorded in a separate platform access log.</p>
        </article>
      </div>
    </div>
  </section>

  <Band title="Association data export and manifest" note="Report a problem" noteHref="/contact" field>
    <p>
      An export of financial ledgers, documents, meeting minutes, and association activity records is
      available at any time, including when closing an account.
    </p>
    <p>
      Every generated export includes an archive manifest report detailing record counts, completion status,
      and any reported file or query errors. The association's data belongs to the association.
    </p>
  </Band>

  <section class="close on-ink">
    <div class="page">
      <h2 class="t-sheet">Have security or audit questions?</h2>
      <div class="actions">
        <a class="btn btn--on-ink" href="/contact">Ask Jesse directly</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Custody Section ─────────────────────────────────────────────────── */

  .sec-custody { border-bottom: var(--stroke-rule); padding-block: var(--pad-y); }
  .sec-custody h2 { max-width: 24ch; }
  .sec-lede {
    margin: var(--s-4) 0 0;
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--ink-body);
    max-width: 58ch;
  }

  .sec-flow {
    margin-top: clamp(28px, 3.4vw, 48px);
    display: grid;
    gap: var(--s-4);
    align-items: center;
  }
  @media (min-width: 760px) {
    .sec-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      column-gap: var(--s-4);
    }
  }

  .sec-step {
    border: var(--stroke-consequence);
    background: var(--paper);
    padding: var(--s-5);
  }
  .step-num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    color: var(--terracotta);
    letter-spacing: 0.14em;
    margin-bottom: var(--s-2);
  }
  .sec-step h3 { color: var(--ink); font-size: var(--t-title); margin-bottom: var(--s-2); }
  .sec-step p { color: var(--ink-body); font-size: var(--t-micro); line-height: 1.5; margin: 0; }

  .sec-arrow {
    display: none;
    font-family: var(--font-mono);
    font-size: 24px;
    color: var(--ink-3);
    text-align: center;
  }
  @media (min-width: 760px) {
    .sec-arrow { display: block; }
  }

  /* ── Approval & Audit ─────────────────────────────────────────────────── */

  .sec-approval { background: var(--field); border-bottom: var(--stroke-rule); padding-block: var(--pad-y); }
  .sec-grid {
    display: grid;
    gap: var(--s-8);
    align-items: start;
  }
  @media (min-width: 860px) {
    .sec-grid { grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 4vw, 64px); }
  }

  .sec-col-text h2 { max-width: 22ch; }
  .sec-col-text p {
    margin: var(--s-4) 0 0;
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--ink-body);
  }
  .sec-coda { font-weight: 500; color: var(--ink) !important; }

  /* ── Access Scoping ───────────────────────────────────────────────────── */

  .sec-access { border-bottom: var(--stroke-rule); padding-block: var(--pad-y); }
  .sec-access h2 { max-width: 22ch; }
  .sec-roles {
    margin-top: clamp(28px, 3.4vw, 48px);
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 760px) {
    .sec-roles { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-6); }
  }

  .role-card {
    border-top: var(--stroke-consequence);
    padding-top: var(--s-4);
  }
  .role-card span {
    display: block;
    color: var(--ink-3);
    margin-bottom: var(--s-2);
  }
  .role-card h3 { color: var(--ink); }
  .role-card p {
    margin: var(--s-3) 0 0;
    color: var(--ink-body);
    font-size: var(--t-micro);
    line-height: 1.55;
  }

  /* ── The close ────────────────────────────────────────────────────────── */

  .close { background: var(--cold); color: var(--paper); border-top: 1.5px solid var(--terracotta); }
  .close h2 { color: var(--paper); max-width: 26ch; }
  .close .actions { margin-top: var(--s-6); }
</style>
