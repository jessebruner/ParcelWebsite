---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PixelSky from "../components/PixelSky.astro";
import { APP_URL } from "../data/site";
---
<Base title="Contact Common Parcel" description="Talk with Jesse Bruner, founder of Common Parcel, about your HOA, product questions, or support. Email directly or open the Common Parcel app." path="/contact">
  <Hero><p class="eyebrow">Let’s talk</p><h1 class="t-display">A question?<br />A good place to start.</h1><p class="t-lede">Tell us a little about your association and what you need help with. You can reach the founder directly.</p></Hero>
  <section><div class="page contact-grid"><div class="contact-note"><p class="eyebrow">Write to Jesse</p><h2 class="t-sheet">We’d like to hear from you.</h2><p>Product questions, setup, or something that needs a closer look.</p><a class="email-link" href="mailto:jesse@commonparcel.com">jesse@commonparcel.com <span aria-hidden="true">↗</span></a><p class="small">Include your association’s name and a short description of your question. Please leave passwords and bank details out of your email.</p><address>Common Parcel<br />1420 Washington Blvd, Ste 301<br />Detroit, MI 48226</address></div><div class="app-card"><div class="contact-art" aria-hidden="true"><PixelSky mode="scene" scene="street" seed={331} /></div><div class="app-copy"><h2 class="t-headline">Ready to open Common Parcel?</h2><p>Get started or sign in to your existing account.</p><a class="btn btn--primary" href={APP_URL}>Open the app <span aria-hidden="true">↗</span></a></div></div></div></section>
</Base>
<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }.contact-note > p { max-width: 32em; }.email-link { display: inline-flex; gap: 20px; align-items: center; min-height: 48px; font-size: clamp(17px, 2vw, 25px); letter-spacing: -.02em; }.small { font-size: 14px; color: var(--ink-3); margin-top: 24px; } address { font-style: normal; font-size: 14px; line-height: 1.7; margin-top: 36px; color: var(--ink-3); }.app-card { border: var(--stroke-edge); }.contact-art { height: 220px; background: var(--night); }.app-copy { padding: 30px; background: var(--field); }.app-copy p { font-size: 16px; margin: 16px 0 24px; } @media(max-width: 700px) { .contact-grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
