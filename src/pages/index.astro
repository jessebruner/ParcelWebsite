---
import Base from "../layouts/Base.astro";
import PixelSky from "../components/PixelSky.astro";
import Mark from "../components/Mark.astro";
import ProductTour from "../components/product/ProductTour.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import { APP_URL, HOME_FAQS, faqSchema } from "../data/site";
import { price, money, DEFAULT_BRACKETS, DEFAULT_MINIMUM } from "../components/pricing/brackets";
const schema = JSON.stringify([
  { "@context": "https://schema.org", "@type": "Organization", "@id": "https://commonparcel.com/#organization", name: "Common Parcel", url: "https://commonparcel.com", logo: "https://commonparcel.com/apple-touch-icon.png", email: "jesse@commonparcel.com", description: "HOA software for volunteer boards and self-managed associations." },
  { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Common Parcel", applicationCategory: "BusinessApplication", operatingSystem: "Web", url: "https://commonparcel.com/product", description: "Software for HOA dues, financial records, governing documents, meetings, and resident access." },
  faqSchema(HOME_FAQS),
]).replaceAll("<", "\\u003c");
---
<Base title="HOA software for volunteer boards | Common Parcel" description="Run your self-managed HOA with Common Parcel. Bring dues, documents, meetings, and resident access together, with clear pricing based on your lot count." path="/" schema={schema}>
  <section class="home-hero">
    <div class="page hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">HOA software. Made for volunteers.</p>
        <h1>Run your HOA.<br /><em>Enjoy your<br class="desktop-break" /> neighborhood.</em></h1>
        <p class="hero-lede">Dues, documents, and board decisions, together at last. A clearer way to care for the place you call home.</p>
        <div class="actions"><a href={APP_URL} class="btn btn--primary">Get started <span aria-hidden="true">↗</span></a><a href="#how-it-works" class="text-link">Take a look <span aria-hidden="true">↓</span></a></div>
        <p class="hero-note">For self-managed HOAs and condominium associations.</p>
      </div>
      <div class="hero-art">
        <div class="landscape" aria-hidden="true"><PixelSky mode="scene" scene="hilltop" seed={61} /></div>
        <div class="art-card"><Mark size={28} /><div><strong>Everything in its place.<br />Even when boards change.</strong><span>Common ground. Common Parcel.</span></div></div>
        <div class="art-caption"><span>Built around your neighborhood.</span><span aria-hidden="true">CP / 01</span></div>
      </div>
    </div>
  </section>
  <div class="promise-strip"><div class="page"><span>Your documents, close at hand.</span><span>Your board, in control.</span><span>Your records, ready for what’s next.</span></div></div>

  <section id="how-it-works" class="work-section">
    <div class="page">
      <div class="section-heading"><div><p class="eyebrow">The everyday work, made clearer</p><h2 class="t-sheet">One place to get<br />the board work done.</h2></div><p>Less digging through inboxes and spreadsheets.<br />More knowing where things stand.</p></div>
      <ProductTour />
    </div>
  </section>

  <section class="board-section">
    <div class="page board-grid">
      <div><p class="eyebrow">Made for the people doing the work</p><h2 class="t-sheet">You’re a neighbor<br /><em>and a board member.</em></h2><p>Common Parcel helps with the administration, while your board makes the decisions. Keep the information close, the next step clear, and the important choices in your hands.</p><a class="text-link" href="/why-common-parcel">Why we built Common Parcel <span aria-hidden="true">→</span></a></div>
      <div class="task-links">
        {[["01", "Keep the finances in view", "Ledgers, budgets, and dues records.", "/product/accounting-and-budgets"], ["02", "Keep the board moving", "Meetings, votes, and the decisions behind them.", "/product/meetings-and-voting"], ["03", "Keep residents in the loop", "A place to pay, find documents, and make requests.", "/product/resident-portal"]].map(([num, title, desc, href]) => <a href={href}><span class="task-number">{num}</span><span><h3>{title}</h3><p>{desc}</p></span><span class="task-arrow" aria-hidden="true">↗</span></a>)}
        <a class="all-product" href="/product">Explore everything in Common Parcel <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-pricing">
    <div class="page">
      <div class="section-heading"><div><p class="eyebrow">A price your board can explain</p><h2 class="t-sheet">The same features<br />at a price for your size.</h2></div><a class="text-link" href="/pricing">Calculate your price <span aria-hidden="true">→</span></a></div>
      <div class="price-examples">{[25, 50, 100].map(lots => <div><p>{lots} lots</p><strong>{money(price(DEFAULT_BRACKETS, lots, DEFAULT_MINIMUM).total, lots === 25 ? 2 : 0)}<span> / month</span></strong><span>Monthly software subscription</span></div>)}</div>
      <p class="price-note">$10 monthly minimum. Month to month. Postal mail and any payment processing fees are separate.</p>
    </div>
  </section>
  <Faq items={HOME_FAQS} title="A few good questions." />
  <CtaBand headline="Make room for the rest of your day." scene="dusk" />
</Base>
<style>
  .home-hero { padding-block: clamp(42px, 5vw, 72px) 64px; }
  .hero-grid { display: grid; grid-template-columns: 1.03fr 1fr; gap: clamp(36px, 4.5vw, 72px); align-items: center; }
  .hero-copy { padding-block: 16px; }
  .eyebrow { font-size: 12px; }
  h1 { font: 550 clamp(42px, 5.3vw, 76px)/1.06 var(--font-sans); letter-spacing: -.052em; margin: 0; }
  h1 em { font-family: var(--font-serif); font-weight: 400; font-size: .9em; letter-spacing: -.055em; color: var(--terracotta); }
  .hero-lede { font-size: 19px; line-height: 1.6; max-width: 28em; margin: 28px 0 30px; }
  .hero-note { font-size: 12px; color: var(--ink-3); margin: 20px 0 0; }
  .hero-art { position: relative; padding-bottom: 28px; }
  .landscape { height: clamp(410px, 39vw, 525px); background: var(--night); overflow: hidden; }
  .landscape :global(canvas) { object-position: 58% center; }
  .art-card { position: absolute; bottom: 60px; left: -26px; padding: 23px 28px; background: var(--paper); border: var(--stroke-edge); display: flex; align-items: start; gap: 20px; }
  .art-card strong { display: block; font: 450 21px/1.35 var(--font-serif); letter-spacing: -.035em; }
  .art-card span { display: block; margin-top: 12px; font: 400 12px/1.5 var(--font-mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .035em; }
  .art-caption { display: flex; justify-content: space-between; gap: 12px; position: absolute; bottom: 0; width: 100%; font: 400 12px/1.5 var(--font-mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .04em; }
  .promise-strip { border-top: var(--stroke-edge); border-bottom: var(--stroke-edge); }
  .promise-strip .page { display: flex; justify-content: space-between; gap: 24px; padding-block: 20px; font-size: 13px; color: var(--ink-2); }
  .promise-strip span::before { content: "✳"; font-size: 15px; margin-right: 12px; color: var(--terracotta); }
  .work-section { padding-block: 88px; }
  .section-heading > p { font-size: 16px; color: var(--ink-3); }
  .board-section { background: var(--field); border-block: var(--stroke-edge); }
  .board-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(48px, 7vw, 100px); }
  .board-grid > div:first-child > p:not(.eyebrow) { max-width: 32em; margin-block: 24px; }
  .board-grid h2 em { font-weight: 400; color: var(--terracotta); }
  .task-links > a { display: flex; gap: 20px; padding: 22px 0; border-bottom: var(--stroke-edge); color: var(--ink); text-decoration: none; align-items: start; }
  .task-links > a:first-child { border-top: var(--stroke-edge); }.task-number { color: var(--terracotta); font: 400 12px/2 var(--font-mono); }
  .task-links h3 { font: 550 21px/1.3 var(--font-sans); margin: 0; letter-spacing: -.025em; }
  .task-links p { margin: 8px 0 0; color: var(--ink-3); font-size: 15px; }
  .task-arrow { margin-left: auto; color: var(--terracotta); }.task-links a:hover h3 { color: var(--terracotta); text-decoration: underline; text-underline-offset: 5px; }
  .task-links > .all-product { color: var(--terracotta); font-size: 15px; border-bottom: 0; justify-content: space-between; }
  .price-examples { display: grid; grid-template-columns: repeat(3, 1fr); border-block: var(--stroke-edge); }
  .price-examples > div { padding: 30px; border-left: var(--stroke-edge); }.price-examples > div:first-child { padding-left: 0; border-left: 0; }
  .price-examples p { margin: 0 0 12px; font-size: 15px; }.price-examples strong { font: 500 clamp(32px, 3.5vw, 45px)/1.2 var(--font-sans); letter-spacing: -.045em; }.price-examples strong span { font-size: 14px; letter-spacing: 0; font-weight: 400; }.price-examples > div > span { display: block; font-size: 12px; color: var(--ink-3); margin-top: 12px; }.price-note { font-size: 13px; color: var(--ink-3); margin-top: 20px; }
  @media(max-width: 900px) { .hero-grid { grid-template-columns: 1fr 1fr; gap: 32px; } h1 { font-size: clamp(39px, 5.7vw, 60px); }.hero-lede { font-size: 17px; }.art-card { left: -16px; padding: 20px; }.art-card strong { font-size: 19px; }.art-card :global(svg) { display: none; }.promise-strip span::before { display: none; } }
  @media(max-width: 700px) {
    .home-hero { padding-block: 28px 36px; }.hero-grid { grid-template-columns: 1fr; gap: 30px; }.hero-copy { padding: 0; } h1 { font-size: clamp(42px, 10vw, 64px); }.desktop-break { display: none; }.hero-lede { margin-block: 22px; font-size: 18px; }.hero-note { margin-top: 16px; }.landscape { height: 285px; }.art-card { left: 16px; bottom: 46px; padding: 18px 20px; }.art-card strong { font-size: 19px; }.art-card :global(svg) { display: block; }.art-caption { font-size: 12px; }.promise-strip .page { flex-direction: column; gap: 6px; font-size: 12px; padding-block: 16px; }.promise-strip span::before { display: inline; }.work-section { padding-block: 52px; }.board-grid { grid-template-columns: 1fr; gap: 30px; }.price-examples { grid-template-columns: 1fr; }.price-examples > div, .price-examples > div:first-child { padding: 22px 0; border-left: 0; border-bottom: var(--stroke-edge); display: grid; grid-template-columns: .7fr 1.3fr; align-items: center; gap: 6px; }.price-examples > div:last-child { border-bottom: 0; }.price-examples p { margin: 0; }.price-examples > div > span { grid-column: 2; margin: 0; }.price-examples strong { font-size: 35px; }
  }
</style>
