---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Band from "../components/Band.astro";
---
<Base
  title="See it running"
  description="A walkthrough of the board's month: the declaration going in, and the notices waiting for signature."
  path="/demo"
>
  <Hero eyebrow="Early access">
    <h1 class="t-display">See it running</h1>
    <p class="t-lede">Fifteen minutes, on a call, with your own documents if you want.</p>
  </Hero>
  <Band title="What I show you">
    <ul class="rows"><li><b>Upload.</b> Your declaration goes in and the provisions come out with the page each one sits on.</li><li><b>The month.</b> What Parcel invoices, reconciles, watches and drafts without being asked.</li><li><b>The stop.</b> Where it puts something in front of the board instead of sending it.</li><li><b>Your state.</b> What has been read for your jurisdiction, and what has not.</li></ul>
  </Band>

  <Band title="What to bring" field>
    <p>Your declaration and your roster, if you have them to hand.</p>
    <p class="coda">If you would rather see it on sample data first, that is fine. Say so.</p>
  </Band>

  <Band title="How to book it" note="See the price" noteHref="/pricing">
    <p>Email <a href="mailto:jesse@commonparcel.com">jesse@commonparcel.com</a> with your state and your lot count. I answer the same day.</p>
  </Band>

</Base>
