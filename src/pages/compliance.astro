---
/**
 * THE COMPLIANCE PAGE.
 *
 * The one page on this site that has to survive a sceptical reader, because the
 * claim it makes is the only claim no competitor makes: that the statute is
 * modelled field by field, that every value names the section it came from, and
 * that a field nobody has read switches its feature off rather than guessing.
 *
 * So it is built out of the product's own surfaces and the product's own
 * numbers. `Digest.astro` is a recreation of `StatuteDigest.tsx`, filled with
 * the real Florida store. `CoverageGrid.astro` publishes what was counted out of
 * `src/lib/statute/data`, jurisdiction by jurisdiction, with the date it was
 * counted. Nothing here is illustrative.
 *
 * The limit is stated on the page in the largest type it could honestly take.
 * Three hundred and twenty-seven of seven hundred and forty-three provisions
 * have not been read. Saying so is what makes the other four hundred and sixteen
 * believable, and it is the sentence a board will check first.
 *
 * Rhythm, since the site's standing defect is three identical bands: figures and
 * a grid, then a split, then a wide sheet, then numbered steps, then the one
 * inverted panel this design system allows, then a table, then a two-column FAQ.
 * No two neighbours are the same shape.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Band from "../components/Band.astro";
import Figures from "../components/compliance/Figures.astro";
import CoverageGrid from "../components/compliance/CoverageGrid.astro";
import Digest, { type DigestRow } from "../components/compliance/Digest.astro";
import { TOTALS, NOTHING_READ, READ_IN_FULL, NAMES, MEASURED_ON } from "../components/compliance/coverage";

const FIGURES = [
  { figure: String(TOTALS.jurisdictions), label: "Jurisdictions held" },
  { figure: String(TOTALS.held), label: "Provisions tracked" },
  { figure: String(TOTALS.read), label: "Read, with a citation" },
  { figure: String(TOTALS.unread), label: "Nobody has read" },
];

/** "Arkansas, Georgia and Wyoming". The islands take an article in a sentence. */
const names = (codes: string[]) => {
  const list = codes.map((c) => (NAMES[c].startsWith("US ") ? `the ${NAMES[c]}` : NAMES[c]));
  return `${list.slice(0, -1).join(", ")} and ${list[list.length - 1]}`;
};

/**
 * Florida, exactly as the store holds it.
 *
 * Labels are the product's own from `digest.ts`. Values are what its `render`
 * function prints. Reasons and caveats are the notes the readers wrote, which
 * are the most useful text in the table and the reason two of these rows are
 * worth more than a green tick.
 */
const FLORIDA: DigestRow[] = [
  {
    label: "Order used when applying a payment",
    value: "interest → late fee → collection cost → principal",
    citation: "Fla. Stat. §720.3085(3)(b)",
    use: "runs",
    quote:
      "Any payment received by an association and accepted shall be applied first to any interest accrued, then to any administrative late fee, then to any costs and reasonable attorney fees incurred in collection, and then to the delinquent assessment.",
  },
  { label: "Steps before a lien", value: "3 listed", citation: "Fla. Stat. §720.3085", use: "runs" },
  {
    label: "Notice before a members' meeting",
    value: "at least 14 days",
    citation: "Fla. Stat. §720.306",
    use: "runs",
    because:
      "Carried over from the code this store replaced and flagged as not re-read against primary text. No citation was recorded with the value; §720.306 is where it should be checked. First in the queue.",
  },
  {
    label: "Notice before a board election",
    use: "unread",
    because: "Florida's election notice period has not been read.",
  },
  {
    label: "Architectural request deemed approved after",
    use: "unread",
    because:
      "Held a plausible 30 days citing only chapter 720, with a note saying it had never been checked. The audit removed it. Florida's architectural review sections have not been read.",
  },
  {
    label: "Reserve study required every",
    value: "every 3 years",
    citation: "Fla. Stat. §718.112(2)(g)",
    use: "runs",
    because:
      "The structural integrity study brought in after Surfside. The section was located by research and its text was not re-read. The milestone inspection is a different statute and easy to confuse with it.",
  },
  {
    label: "Reserve fund required",
    use: "unread",
    because:
      "Florida has reserve funding rules for condominiums and nobody has read them into this shape. Recorded as unread rather than as no rule, which would be false.",
  },
  { label: "Time to answer a records request", value: "10 days", citation: "Fla. Stat. §720.303(5)", use: "runs" },
  { label: "Those days counted as", value: "business days", citation: "Fla. Stat. §720.303(5)", use: "runs" },
  { label: "Records with a different deadline", value: "No such rule in this statute", citation: "Fla. Stat. §720.303(5)", use: "runs" },
  { label: "Extension the association may take", value: "No such rule in this statute", citation: "Fla. Stat. §720.303(5)", use: "runs" },
  { label: "Damages for answering late", value: "$50 per calendar day, up to 10 days", citation: "Fla. Stat. §720.303(5)", use: "runs" },
  {
    label: "Attorney's fees for a records dispute",
    value: "No such rule in this statute",
    citation: "Fla. Stat. §720.303(5)",
    use: "runs",
    because:
      "Subsection (5) says nothing about fees. There is a general prevailing party rule at §720.305, and reading it into this section would assert something this section does not say.",
  },
  { label: "Request must be in writing", value: "Yes", citation: "Fla. Stat. §720.303(5)", use: "runs" },
  { label: "Records that may be withheld", value: "8 listed", citation: "Fla. Stat. §720.303(5)", use: "runs" },
];

const SWEEP = [
  {
    signal: "Moved",
    means: "A bill Parcel tracks has status fields that changed since the last sweep.",
    does: "Queues the jurisdiction to be read again.",
  },
  {
    signal: "Appeared",
    means: "A bill Parcel had not seen before matched the query. While a legislature is in session this is the common one.",
    does: "Queues the jurisdiction to be read again.",
  },
  {
    signal: "Vanished",
    means: "A bill Parcel had recorded that this sweep did not return. Usually a relevance wobble rather than a repeal.",
    does: "Reported and not acted on, and kept in the ledger so it does not come back next week looking like news.",
  },
  {
    signal: "Settled",
    means: "Present, and identical to last time.",
    does: "Nothing. The result says settled rather than unchanged, and the difference is the next paragraph.",
  },
];

const FAQ: [string, string][] = [
  [
    "Which parts will run for my association?",
    "Coverage is per field and per state, so the answer is a list rather than a yes. The grid above is counted out of the data the product runs on. Ask before you pay and you get your state's list.",
  ],
  [
    "Does Parcel make my association compliant?",
    "No. It prepares and it stops. A notice is drafted, dated and cited by Parcel; sending it needs two distinct board members to sign, and the software cannot sign for a board.",
  ],
  [
    "Is any of this legal advice?",
    "No. Parcel is not a law firm. It records what the statute says, the section it says it in, and the date somebody read it. Your attorney reads it for your association.",
  ],
  [
    "Where do the readings come from?",
    "The state's own publication. Never a law firm's summary and never a third party statute database. The link is stored beside the value, so a board can open the same page Parcel read.",
  ],
  [
    "Why does my state hold fewer rules than the one next door?",
    "Because a legislature that imposed nothing is recorded as a finding, carrying the citation of the section that is silent. A state is not less covered for having less law.",
  ],
  [
    "What happens the week a bill passes?",
    "The sweep names the bills that moved and queues your state. Nothing stored changes until somebody reads the statute again. If a notice period changes, that is not a memo to file; it is a date on your calendar and every notice counted back from it.",
  ],
];
---

<Base
  title="Compliance"
  description="Parcel holds HOA statute for all fifty states, DC, Puerto Rico and the US Virgin Islands, field by field, with the section on every value. Where nobody has read a provision, it refuses to act rather than guessing."
  shareTitle="It reads the law, then watches it change"
  path="/compliance"
  reviewed="August 2026"
>
  <Hero eyebrow="Compliance" seed={23}>
    <h1 class="t-display">It reads the law, then watches it change</h1>
    <p class="t-lede">
      An association answers to two things: its own recorded documents, and the statute of the state
      it sits in. The documents rarely move. The statute moves every session.
    </p>
  </Hero>

  <!-- ─── Counted, then drawn. The limit before the pitch. ─────────────── -->
  <section class="count">
    <div class="page">
      <h2 class="t-sheet">What has actually been read</h2>
      <p class="lede-w">
        Not one record per state. One record per rule, held on its own, because rules change on
        their own. Fourteen for most jurisdictions, fifteen where the state also fixes the order a
        payment is applied in.
      </p>

      <Figures items={FIGURES} />

      <div class="grid-wrap">
        <CoverageGrid />
      </div>

      <p class="coda">
        {names(NOTHING_READ)} have nothing read at all. {names(READ_IN_FULL)} are read in full.
        Everywhere else it depends on the field, which is why the useful question is not whether your
        state is supported but which of its rules Parcel can show you the section for.
      </p>
    </div>
  </section>

  <!-- ─── Split: the argument beside the thing it describes. ───────────── -->
  <section class="split">
    <div class="page">
      <div class="say">
        <h2 class="t-sheet">Three answers, not two</h2>
        <p>
          Software normally records a rule it does not have as an empty field. That collapses two
          opposite statements. A legislature that imposed no rule and a statute nobody has opened
          both arrive as nothing, and every piece of code downstream treats them the same.
        </p>
        <p>
          One of them should let a feature run. The other has to switch it off. So Parcel stores the
          difference instead of the blank.
        </p>
        <p class="coda">
          A finding of silence carries a citation, because a legislature imposing nothing is still a
          claim about the law and a board relying on it deserves the section. An unread field carries
          nothing, because there is nothing yet to say.
        </p>
      </div>

      <ol class="answers">
        <li>
          <p class="t-label">Read, and the statute sets a rule</p>
          <div class="a-row">
            <span class="a-lab">Time to answer a records request</span>
            <span class="a-val">10 days</span>
          </div>
          <p class="a-cite">Fla. Stat. §720.303(5)</p>
        </li>
        <li>
          <p class="t-label">Read, and the statute imposes nothing</p>
          <div class="a-row">
            <span class="a-lab">Attorney's fees for a records dispute</span>
            <span class="a-val">No such rule in this statute</span>
          </div>
          <p class="a-cite">Fla. Stat. §720.303(5)</p>
          <p class="a-why">
            Subsection (5) is silent. §720.305 is a different section and a different rule.
          </p>
        </li>
        <li>
          <p class="t-label">Nobody has read it</p>
          <div class="a-row">
            <span class="a-lab">Notice before a members' meeting, Michigan</span>
            <span class="a-chip">Not read</span>
          </div>
          <p class="a-cite none">No citation, because there is nothing to cite</p>
          <p class="a-why">
            The Condominium Act sets no period. MCL 450.2404(1)(a) gives 10 to 60 days, but only
            where the association is incorporated as a nonprofit, which is usual and not universal.
            A conditional rule asserted as a universal one is how a board acts on law that does not
            reach them.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ─── The sheet. The product's own screen, real data. ──────────────── -->
  <section class="one-state">
    <div class="page">
      <h2 class="t-sheet">One state, field by field</h2>
      <p class="lede-w">
        This is the digest a Florida board opens. Every row is a value the store actually holds, what
        it says, and the section it came from. Three rows are blank, and they say why.
      </p>

      <Digest
        label="Florida · statutory digest"
        note="12 run · 3 not read"
        rows={FLORIDA}
        footing={{ label: "Provisions held for Florida", value: "15" }}
        caption={`Read out of Parcel's statutory store on ${MEASURED_ON}. Not sample data.`}
      />

      <div class="panel--enforcement caveat">
        <p class="t-label">Two rows carry a warning, and it is deliberate</p>
        <p>
          The meeting notice period has been driving real notice dates since before this store
          existed, and no citation was recorded with it. Rather than quietly keep it or quietly drop
          it, the store keeps the value and prints the caveat: not re-read against primary text,
          first in the queue. The reserve study cycle has a section that research located and whose
          text nobody has re-read. A board reading either one knows exactly how much weight it
          carries.
        </p>
      </div>

      <p class="coda">
        Michigan is the other end of the range, and its two read provisions are worth more than the
        count suggests. No Michigan statute mandates a reserve study on any cycle, which is a finding
        with the whole Condominium Act and the complete administrative rules behind it. MCL 559.205
        separately requires condominiums to maintain a reserve fund, and the rule under it sets a
        floor of ten percent of the annual budget. A board told Michigan has no reserve requirement
        would be badly misinformed, and one combined field is exactly what would have told them that.
      </p>
    </div>
  </section>

  <!-- ─── Steps. How a reading is allowed to do anything. ──────────────── -->
  <Band title="How a reading earns the right to act" field>
    <p>
      Reading a statute and acting on one are different bars. A single flag for whether a value can
      be trusted has to read no for all fifty-three until every one of them is perfect, which is why
      Parcel asks a narrower question: what may this particular value be used for? A provision can be
      good enough to show a member beside the passage it rests on long before it is good enough to
      draft a demand letter asserting it, and both of those are true at the same time. Ohio has five
      provisions sitting in exactly that position today.
    </p>

    <ol class="steps">
      <li>
        <h3 class="t-title">Read the state's own publication</h3>
        <p>
          Not a law firm's summary, not a third party database. The link is stored beside the value.
          Which official site gets read turns out to matter more than it sounds: Florida's older one
          serves a page for a section that does not exist, so software built on it cannot tell a
          missing statute from a real one. Parcel reads the other one, which says plainly that the
          section is not there.
        </p>
      </li>
      <li>
        <h3 class="t-title">Record the passage, not the conclusion</h3>
        <p>
          A reading returns the verbatim span of text the value rests on and where that span sits in
          a stored, content hashed snapshot. Then five mechanical checks run: the offsets have to
          resolve inside the snapshot, slicing it at them has to reproduce the quote exactly, the
          value has to appear inside the quote, the citation has to be shaped like that
          jurisdiction's, and its section number has to appear near the quote. A cited section that
          was never written can be given a convincing quote, and that quote cannot be made to appear
          in bytes Parcel already holds.
        </p>
      </li>
      <li>
        <h3 class="t-title">Have it read again, by somebody who cannot see the first answer</h3>
        <p>
          Agreement promotes the value. Disagreement demotes both readings and neither is used, with
          no tie break and no majority, because two careful readers who differ is positive evidence
          that the provision is ambiguous and ambiguity is when a board should least be handed a
          number. Of {TOTALS.compared} values compared, {TOTALS.contested} came back contested. Both
          readings stay on the record where the next reader can see that somebody disagreed.
        </p>
      </li>
      <li>
        <h3 class="t-title">Then decide what it may do</h3>
        <p>
          A value with a citation may be shown to a member beside its source. A value a second reader
          confirmed may run a clock or advance a ladder. Only a value a person read, linked and
          quoted may go into a document that asserts a legal position. Readings made by software stop
          one rung short of that, permanently, because they rest on a page as fetched rather than on
          bytes Parcel keeps: the evidence can be fetched again and cannot be resolved again, and a
          letter has to still have its evidence after the state redesigns its website.
        </p>
      </li>
    </ol>

    <p class="coda">
      Most of this store was read by software against the state's own publication and checked by a
      second, independent reading. That is enough to date a notice and not enough to write one. The
      ceiling is the behaviour, not a caveat in the margin, and it names the exact work that would
      lift it.
    </p>
  </Band>

  <!-- ─── The one inversion this design system allows. ─────────────────── -->
  <section class="refuse">
    <div class="page">
      <h2 class="t-sheet">Where it refuses</h2>

      <div class="panel--statutory">
        <p class="t-label">It fails closed</p>
        <p class="lede">
          An unread provision does not fall back to a default. The feature that needs it does not
          run, and the screen names the provision it is missing.
        </p>
        <p class="note">
          {TOTALS.unread} of the {TOTALS.held} provisions Parcel tracks have not been read. That
          count is per field and per state, so what runs for your association is a specific list, and
          you get it before you pay rather than in a notice that did not arrive.
        </p>
      </div>

      <p class="coda">
        The code this replaced did the opposite. A state with no record of its own fell back to
        Florida, so Florida's thirty and sixty day rungs, and a notice citing Fla. Stat. 720.335,
        went to owners in forty-seven other states. The letter looked right. The clock was not
        theirs, and that is the defect every rule on this page exists to prevent.
      </p>
    </div>
  </section>

  <!-- ─── Table. Four outcomes, and what a quiet week proves. ──────────── -->
  <section class="watch">
    <div class="page">
      <h2 class="t-sheet">The watch, and what a quiet week proves</h2>
      <p class="lede-w">
        A statute Parcel read in March can be amended in April. One query per jurisdiction goes out
        against the bills that could move a rule the store holds, and the sweep returns four kinds of
        answer.
      </p>

      <div class="scroll-x">
        <table>
          <caption>What one sweep returns</caption>
          <thead>
            <tr>
              <th scope="col">Signal</th>
              <th scope="col">What it means</th>
              <th scope="col">What Parcel does</th>
            </tr>
          </thead>
          <tbody>
            {SWEEP.map((s) => (
              <tr>
                <th scope="row">{s.signal}</th>
                <td>{s.means}</td>
                <td>{s.does}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="panel--enforcement limit">
        <p class="t-label">Settled is not the same as unchanged</p>
        <p>
          What the sweep compares is a hash of a bill's status fields. It does not cover the bill's
          text, its amendments, its supplements or its votes. So a quiet week is not confirmation
          that your statute is untouched, and the sweep result carries the list of what it does not
          cover, so that nothing downstream can quietly render it as a green tick.
        </p>
      </div>

      <ul class="rows">
        <li>
          <b>A sweep never edits a value.</b> A moved bill queues a reading, and the reading is what
          produces a fact, with a passage and a second reader. A summary from an aggregator has
          neither, and letting one write into the store would put a third party's paraphrase behind a
          lien notice.
        </li>
        <li>
          <b>One query per jurisdiction, not one national sweep.</b> Results come back ranked by
          relevance and paginated, so a single national query truncates whichever states rank lowest.
          Those are the states with the least legislative noise, which are exactly the ones where a
          single amendment matters most.
        </li>
        <li>
          <b>Puerto Rico and the US Virgin Islands are not swept.</b> They are outside the bill
          service's coverage, so they are reported as unwatched. No change detected never quietly
          includes a jurisdiction nothing was checked for.
        </li>
      </ul>

      <p class="attr">
        Legislative metadata from <a href="https://legiscan.com" rel="noopener">LegiScan</a>, used
        under CC BY 4.0.
      </p>
    </div>
  </section>

  <Band title="Questions a board asks" note="See documents and answers" noteHref="/product/documents-and-answers">
    <dl class="faq">
      {FAQ.map(([q, a]) => <div><dt class="t-title">{q}</dt><dd>{a}</dd></div>)}
    </dl>
  </Band>

  <section class="close on-ink">
    <div class="page">
      <h2 class="t-sheet">Ask what has been read for your state.</h2>
      <div class="actions">
        <a class="btn btn--on-ink" href="/demo">Get early access</a>
        <a class="btn btn--ghost-on-ink" href="/contact">Email the founder</a>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { max-width: 18ch; }

  /* A section heading and its opening sentence, held to a readable measure
     rather than the full page width. */
  .lede-w {
    font-family: var(--font-serif); font-size: var(--t-lede); line-height: 1.45;
    color: var(--ink); max-width: 34em; margin: var(--s-5) 0 0; text-wrap: pretty;
  }
  section > .page > h2 { max-width: 26ch; }

  /* ── Counted ───────────────────────────────────────────────────────── */
  .count { border-bottom: var(--stroke-rule); }
  .count :global(.figs) { margin-top: var(--s-12); }
  .grid-wrap { margin-top: var(--s-12); }
  .count .coda { max-width: 44em; margin-top: var(--s-8); }

  /* ── Split ─────────────────────────────────────────────────────────── */
  .split { background: var(--field); border-bottom: var(--stroke-rule); }
  .split > .page { display: grid; gap: var(--s-12); align-items: start; }
  @media (min-width: 1000px) {
    .split > .page { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(40px, 5vw, 88px); }
  }
  .say > * + * { margin-top: var(--s-4); }
  .say p { margin: 0; text-wrap: pretty; }

  .answers { list-style: none; margin: 0; padding: 0; }
  .answers > li {
    border-top: var(--stroke-consequence);
    padding: var(--s-4) 0 var(--s-5);
  }
  .answers > li + li { margin-top: var(--s-6); }
  .a-row {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: var(--s-2); margin-top: var(--s-3);
  }
  .a-lab { font-size: var(--t-body); color: var(--ink); }
  .a-val {
    font-family: var(--font-mono); font-size: var(--t-mono-data);
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .a-chip {
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3);
    border: var(--stroke-edge); padding: 3px 8px;
  }
  .a-cite {
    margin: var(--s-2) 0 0;
    font-family: var(--font-mono); font-size: var(--t-mono-label);
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--terracotta);
  }
  .a-cite.none { color: var(--ink-3); }
  .a-why { margin: var(--s-3) 0 0; font-size: var(--t-micro); color: var(--ink-2); text-wrap: pretty; }

  /* ── One state ─────────────────────────────────────────────────────── */
  .one-state { border-bottom: var(--stroke-rule); }
  .one-state :global(.sheet) { margin-top: var(--s-8); }
  .caveat { margin-top: var(--s-8); max-width: 44em; }
  .caveat p:last-child { margin: var(--s-3) 0 0; }
  .one-state .coda { max-width: 44em; margin-top: var(--s-8); }

  /* ── Steps ─────────────────────────────────────────────────────────── */
  .steps { list-style: none; margin: var(--s-6) 0 0; padding: 0; counter-reset: step; }
  .steps > li {
    counter-increment: step;
    border-top: var(--stroke-rule);
    padding-top: var(--s-4);
    padding-left: 3.1em;
    position: relative;
  }
  .steps > li + li { margin-top: var(--s-6); }
  .steps > li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute; left: 0; top: var(--s-4);
    font-family: var(--font-mono); font-size: var(--t-mono-data);
    font-variant-numeric: tabular-nums; letter-spacing: 0.08em;
    color: var(--terracotta);
  }
  .steps h3 { margin: 0 0 var(--s-2); }
  .steps p { margin: 0; text-wrap: pretty; }

  /* ── Refuses ───────────────────────────────────────────────────────── */
  .refuse { border-bottom: var(--stroke-rule); }
  .refuse .panel--statutory { margin-top: var(--s-8); }
  .refuse .coda { max-width: 44em; margin-top: var(--s-8); }

  /* ── Watch ─────────────────────────────────────────────────────────── */
  .watch { background: var(--field); border-bottom: var(--stroke-rule); }
  .watch .scroll-x { margin-top: var(--s-8); }
  .watch table { min-width: 34em; }
  .watch th[scope="row"] {
    font-family: var(--font-mono); font-size: var(--t-mono-label);
