---
/**
 * Dynamic Blog Post Route.
 *
 * Renders authoritative HOA guides with structured statutory citations, procedural hero art,
 * and clear typography.
 */
import Base from "../../layouts/Base.astro";
import BlogHeaderArt from "../../components/blog/BlogHeaderArt.astro";
import CitationBlock from "../../components/blog/CitationBlock.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import { BLOG_POSTS, readingMinutes, type BlogPost } from "../../data/blog";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

/**
 * **Lead-in.** rest -> <b>Lead-in.</b> rest
 *
 * Same convention and same one-line implementation as Blocks.astro, so a
 * writer moving between a product page and a post does not have to remember
 * which file uses which markup. Nothing else in the copy is marked up.
 */
function bold(s: string): string {
  return s.replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");
}

/** `callout` then `callouts`, so a section may hold one or several. */
function calloutsOf(section: { callout?: unknown; callouts?: unknown[] }) {
  return [section.callout, ...(section.callouts ?? [])].filter(Boolean);
}

const minutes = readingMinutes(post);

/*
 * BlogPosting and BreadcrumbList.
 *
 * The posts already carried Article microdata — headline, description, author,
 * datePublished, articleBody — so this is not markup arriving where there was
 * none. What the microdata has never carried is `image` or `publisher`, both of
 * which Google asks for on an article, and a crawler had no breadcrumb for the
 * blog at all.
 *
 * Every value is read from src/data/blog.ts. There is deliberately no
 * `dateModified`: the schema has no field for it, and stamping today's date or
 * copying datePublished would both be claims about a revision that never
 * happened. A post that gets rewritten needs a field, not a default.
 *
 * The breadcrumb is Home > Blog > this post, which is the path that actually
 * exists. The visible trail above reads Blog / {category}, and category is not
 * a page, so it is not in the markup pointing at a URL that would 404.
 */
const site = "https://commonparcel.com";
const url = `${site}/blog/${post.slug}`;
const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.publishedAt,
    inLanguage: "en-US",
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    url,
    image: `${site}/og.png`,
    articleSection: post.category,
    wordCount: post.sections.reduce(
      (n, s) =>
        n +
        (s.paragraphs ?? []).join(" ").split(/\s+/).filter(Boolean).length +
        (s.list?.items ?? []).join(" ").split(/\s+/).filter(Boolean).length,
      post.lede.split(/\s+/).filter(Boolean).length
    ),
    /*
     * The author of all six posts is "Common Parcel", so it is an
     * Organization. Emitting it as a Person produced a person named Common
     * Parcel, and `role` is "Detroit, Michigan" on every post, so mapping it
     * to jobTitle gave that person the job title "Detroit, Michigan". `role`
     * is a place here; there is no field that means job, so nothing claims
     * one. A named human author later needs a field, not this one reused.
     */
    author:
      post.author.name === "Common Parcel"
        ? { "@type": "Organization", name: post.author.name, url: site }
        : { "@type": "Person", name: post.author.name },
    publisher: {
      "@type": "Organization",
      name: "Common Parcel",
      url: site,
      logo: { "@type": "ImageObject", url: `${site}/apple-touch-icon.png` },
    },
    ...(post.citations.length
      ? { citation: post.citations.map((c) => [c.source, c.section, c.title].filter(Boolean).join(", ")) }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${site}/blog` },
      { "@type": "ListItem", position: 3, name: post.title },
    ],
  },
]);
---

<Base
  title={post.title}
  description={post.description}
  path={`/blog/${post.slug}`}
  shareTitle={post.title}
  schema={schema}
>
  <article class="post-layout" itemscope itemtype="https://schema.org/Article">
    <!-- Header / Hero -->
    <header class="post-hero">
      <div class="page">
        <nav class="post-breadcrumbs" aria-label="Breadcrumbs">
          <a href="/blog" class="crumb-link">Blog</a>
          <span class="crumb-separator" aria-hidden="true">/</span>
          <span class="crumb-current">{post.category}</span>
        </nav>

        <h1 class="t-display post-title" itemprop="headline">{post.title}</h1>
        <p class="t-lede post-lede" itemprop="description">{post.lede}</p>

        <div class="post-meta">
          <!--
            Organization, not Person. Every post is authored by Common Parcel,
            and this said Person, so the markup Google reads today describes a
            person by that name. The visible "(Detroit, Michigan)" stays as
            presentation and carries no itemprop, because it is a place and
            there is no author property it belongs to.
          -->
          <div class="post-author" itemprop="author" itemscope itemtype="https://schema.org/Organization">
            <span class="author-label t-mono-label">Author</span>
            <span class="author-name" itemprop="name">{post.author.name}</span>
            <span class="author-role t-micro">({post.author.role})</span>
          </div>

          <div class="meta-divider" aria-hidden="true"></div>

          <div class="post-date-group">
            <span class="date-label t-mono-label">Published</span>
            <time datetime={post.publishedAt} class="published-date t-mono" itemprop="datePublished">
              {post.publishedAt}
            </time>
          </div>

          <div class="meta-divider" aria-hidden="true"></div>

          <div class="post-read-time">
            <span class="read-label t-mono-label">Reading Time</span>
            <span class="read-time t-mono">{minutes} min</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Procedural Hero Art -->
    <div class="page post-art-wrap">
      <BlogHeaderArt subject={post.artSubject} mode="hero" />
    </div>

    <!-- Post Body -->
    <div class="page post-body-container">
      <div class="post-content" itemprop="articleBody">
        {post.sections.map((section) => (
          <section class="post-section">
            {section.heading && (
              <h2 class="t-sheet post-section-heading">{section.heading}</h2>
            )}

            {(section.paragraphs ?? []).map((p) => (
              <p class="post-paragraph" set:html={bold(p)} />
            ))}

            {calloutsOf(section).map((c) => (
              <div class:list={["post-callout", `callout--${c.type}`]}>
                {c.title && (
                  <div class="callout-header t-mono-label">{c.title}</div>
                )}
                <p class="callout-text">{c.text}</p>
              </div>
            ))}

            {section.list && (
              <div class="post-list-block">
                {section.list.title && (
                  <h3 class="t-title list-title">{section.list.title}</h3>
                )}
                <ul class="rows post-list">
                  {section.list.items.map((item) => (
                    <li set:html={bold(item)} />
                  ))}
                </ul>
              </div>
            )}
          </section>
        ))}

        <!-- Primary Sources and Statutory Citations -->
        <CitationBlock citations={post.citations} />

        <!--
          The card at the foot of every post. It said "Common Parcel provides
          verified governance tools and statutory workflows", which claims
          something nobody has verified, and "these guides cite statutory
          reference provisions", which is not true of a post that cites
          nothing. It now says what the guides are and who writes them.
        -->
        <div class="post-author-box">
          <div class="author-box-content">
            <span class="t-mono-label">About these guides</span>
            <p class="author-box-bio">
              Common Parcel builds software for HOA and condominium boards that run their own
              association. We write these guides for the same boards. Where one quotes a statute,
              the section and the date it was read are printed at the foot of the post, so you can
              open it yourself. None of it is legal advice.
            </p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- CTA -->
  <!-- "required books" asserted a legal requirement this site has not sourced. -->
  <CtaBand
    headline="Your association, in your hands."
    scene="dusk"
    seed={197}
  />
</Base>

<style>
  .post-layout {
    background: var(--paper);
    padding-bottom: var(--pad-y);
  }
  .post-hero {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(24px, 3vw, 40px);
    border-bottom: var(--stroke-rule);
  }
  .post-breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .crumb-link {
    color: var(--terracotta);
    text-decoration: none;
  }
  .crumb-link:hover {
    text-decoration: underline;
  }
  .crumb-separator {
    color: var(--ink-3);
  }
  .crumb-current {
    color: var(--ink-2);
  }
  .post-title {
    max-width: 26ch;
    margin-bottom: var(--s-4);
  }
  .post-lede {
    max-width: 44ch;
    color: var(--ink-2);
    margin-bottom: var(--s-6);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--stroke-hairline);
  }
  .meta-divider {
    width: 1px;
    height: 24px;
    background: var(--c-edge);
  }
  .post-author, .post-date-group, .post-read-time {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .author-label, .date-label, .read-label {
    color: var(--ink-3);
  }
  .author-name {
    font-weight: 600;
    color: var(--ink);
    font-size: var(--t-micro);
  }
  .author-role {
    color: var(--ink-3);
  }
  .published-date, .read-time {
    color: var(--ink);
    font-size: var(--t-mono-data);
  }

  .post-art-wrap {
    margin-top: clamp(24px, 3vw, 40px);
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .post-body-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .post-body-container {
      grid-template-columns: minmax(0, 44em);
    }
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .post-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .post-section-heading {
    margin-top: var(--s-4);
    color: var(--ink);
  }
  .post-paragraph {
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--ink-body);
    margin: 0;
  }

  /* Callout styling */
  .post-callout {
    margin-top: var(--s-3);
    margin-bottom: var(--s-3);
    padding: var(--s-5) var(--s-6);
    border: var(--stroke-rule);
    background: var(--card);
  }
  .callout--statutory {
    background: var(--night);
    color: var(--paper);
    border: 1px solid var(--plum);
  }
  .callout--statutory .callout-header {
    color: var(--sand);
  }
  .callout--statutory .callout-text {
    color: var(--mist);
  }
  .callout--note {
    background: var(--field);
    border-left: 4px solid var(--terracotta);
  }
  .callout--note .callout-header {
    color: var(--terracotta);
  }
  .callout-header {
    margin-bottom: var(--s-2);
    letter-spacing: 0.14em;
  }
  .callout-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: 1.55;
  }

  .post-list-block {
    margin-top: var(--s-3);
  }
  .list-title {
    margin-bottom: var(--s-3);
  }
  .post-list {
    margin-top: var(--s-2);
  }

  .post-author-box {
    margin-top: var(--s-8);
    padding: var(--s-6);
    background: var(--field);
    border-top: 2px solid var(--terracotta);
  }
  .author-box-bio {
    margin: var(--s-2) 0 0;
    font-size: var(--t-micro);
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
