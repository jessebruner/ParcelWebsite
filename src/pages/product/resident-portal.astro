---
/**
 * Resident Portal Feature Page
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CtaBand from "../../components/ui/CtaBand.astro";

const description = "A modern self-serve homeowner portal for dues payments, maintenance requests, community directory, and governing documents.";
---

<Base
  title="Resident Portal"
  description={description}
  path="/product/resident-portal"
  shareTitle="Common Parcel: Self-Serve Homeowner Portal"
>
  <Hero eyebrow="Homeowner Experience" scene="dawn" seed={55}>
    <h1 class="t-display">A clean homeowner portal your neighbors will actually use.</h1>
    <p class="t-lede">
      No forgotten passwords or clunky menus. Fast dues payments, instant document downloads, and direct maintenance requests from any device.
    </p>
    <div class="actions">
      <button type="button" class="btn btn--on-ink" data-open-modal="early-access">Request Early Access</button>
      <a href="/pricing" class="btn btn--ghost-on-ink">View Transparent Pricing</a>
    </div>
  </Hero>

  <!-- SELF SERVE PAYMENTS -->
  <section class="band">
    <div class="page">
      <div class="feature-two-up">
        <div class="text-side">
          <span class="t-label">Self-Serve Payments</span>
          <h2 class="t-sheet">Homeowners pay dues in under sixty seconds.</h2>
          <p class="t-lede">
            Homeowners log in via secure magic links or standard authentication. They can view current account balances, download past payment receipts, and set up automatic annual or monthly payments.
          </p>
          <ul class="rows">
            <li><b>Automatic Receipts:</b> Instant email confirmation and downloadable PDF statements.</li>
            <li><b>Autopay Support:</b> Optional recurring payments so neighbors never miss a due date.</li>
            <li><b>Mobile Friendly:</b> Formatted for phones, tablets, and desktop browsers.</li>
          </ul>
        </div>
        <div class="visual-side">
          <div class="portal-mockup-frame">
            <div class="phone-card">
              <div class="phone-header">
                <span class="phone-brand">Common Parcel</span>
                <span class="phone-tag">Unit 108</span>
              </div>
              <div class="phone-balance">
                <div class="bal-label">Current Balance</div>
                <div class="bal-amount num">$0.00</div>
                <div class="bal-status">Paid for 2026 Fiscal Year</div>
              </div>
              <div class="phone-action">
                <button type="button" class="btn btn--primary full-width">View Payment History</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DOCUMENT REPOSITORY -->
  <section class="band band--field">
    <div class="page">
      <div class="feature-two-up reverse">
        <div class="text-side">
          <span class="t-label">Document Center</span>
          <h2 class="t-sheet">Official community records available around the clock.</h2>
          <p class="t-lede">
            Stop digging through old email threads when an owner needs the CC&Rs for a home sale. By-laws, meeting minutes, budgets, and insurance certificates are organized and searchable.
          </p>
          <ul class="rows">
            <li><b>Categorized Folders:</b> Clean separation for governance, financial audits, and meeting records.</li>
            <li><b>Public vs Private:</b> Control which documents are visible to owners versus board officers.</li>
            <li><b>Fast Search:</b> Locate specific resolutions or rules in seconds.</li>
          </ul>
        </div>
        <div class="visual-side">
          <div class="docs-browser">
            <div class="doc-row">
              <div class="doc-icon">PDF</div>
              <div class="doc-meta">
                <div class="doc-title">Declaration of Covenants, Conditions & Restrictions (CC&Rs)</div>
                <div class="doc-info">Updated Jan 2024 · 2.4 MB</div>
              </div>
            </div>
            <div class="doc-row">
              <div class="doc-icon">PDF</div>
              <div class="doc-meta">
                <div class="doc-title">2026 Approved Association Operating Budget</div>
                <div class="doc-info">Posted Dec 2025 · 410 KB</div>
              </div>
            </div>
            <div class="doc-row">
              <div class="doc-icon">PDF</div>
              <div class="doc-meta">
                <div class="doc-title">Master Certificate of Liability Insurance</div>
                <div class="doc-info">Valid through Nov 2026 · 180 KB</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAINTENANCE & REQUESTS -->
  <section class="band">
    <div class="page">
      <div class="feature-two-up">
        <div class="text-side">
          <span class="t-label">Community Requests</span>
          <h2 class="t-sheet">Maintenance tickets with real-time status updates.</h2>
          <p class="t-lede">
            Homeowners can report common-area issues such as sprinkler leaks, gate repairs, or lighting outages directly through the portal with photo attachments.
          </p>
          <ul class="rows">
            <li><b>Photo Uploads:</b> Neighbors capture and upload issue photos directly from their phones.</li>
            <li><b>Vendor Assignment:</b> Board members assign preferred maintenance contractors with one click.</li>
            <li><b>Status Notifications:</b> Homeowners receive automatic updates when work is completed.</li>
          </ul>
        </div>
        <div class="visual-side">
          <div class="ticket-card">
            <div class="ticket-head">
              <span class="ticket-id">Ticket #312</span>
              <span class="ticket-status in-progress">In Progress</span>
            </div>
            <div class="ticket-title">North Gate Sensor Intermittent Failure</div>
            <div class="ticket-body">
              Assigned to: Valley Gate & Automation Co.<br />
              Estimated service visit: Thursday, 10:00 AM
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    headline="Give your homeowners a modern digital experience."
    lede="Request early access or review our transparent pricing."
  />
</Base>

<style>
  .feature-two-up {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .feature-two-up.reverse .text-side { order: 2; }
  .feature-two-up.reverse .visual-side { order: 1; }

  @media (max-width: 860px) {
    .feature-two-up, .feature-two-up.reverse {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .feature-two-up.reverse .text-side { order: 1; }
    .feature-two-up.reverse .visual-side { order: 2; }
  }

  .text-side { display: flex; flex-direction: column; gap: var(--s-3); }

  .phone-card {
    background: var(--card);
    border: 1.5px solid var(--ink);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .phone-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--c-edge);
    padding-bottom: var(--s-3);
  }
  .phone-brand {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--ink);
  }
  .phone-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--field);
    padding: 2px 6px;
  }
  .phone-balance {
    text-align: center;
    padding: var(--s-3) 0;
  }
  .bal-label { font-size: 12px; font-family: var(--font-mono); color: var(--ink-3); text-transform: uppercase; }
  .bal-amount { font-size: 36px; font-weight: 700; color: var(--ink); margin: 4px 0; }
  .bal-status { font-size: 12px; color: #137333; font-weight: 500; }
  .full-width { width: 100%; justify-content: center; }

  .docs-browser {
    background: var(--card);
    border: 1px solid var(--c-edge);
    display: flex;
    flex-direction: column;
  }
  .doc-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--c-hairline);
  }
  .doc-row:last-child { border-bottom: none; }
  .doc-icon {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    background: var(--held);
    color: var(--terracotta);
    padding: 6px 8px;
    border: 1px solid var(--bisque-edge);
  }
  .doc-title { font-size: 13px; font-weight: 600; color: var(--ink); }
  .doc-info { font-size: 11px; color: var(--ink-3); }

  .ticket-card {
    background: var(--card);
    border: 1px solid var(--c-edge);
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .ticket-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ticket-id { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); }
  .ticket-status {
    font-family: var(--font-mono); font-size: 10px; font-weight: 600;
    text-transform: uppercase; padding: 2px 6px;
  }
  .ticket-status.in-progress { background: #fef7e0; color: #b06000; }
  .ticket-title { font-family: var(--font-serif); font-size: 16px; font-weight: 600; color: var(--ink); }
  .ticket-body { font-size: 13px; color: var(--ink-2); line-height: 1.45; }
</style>
