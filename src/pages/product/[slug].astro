---
import Base from "../../layouts/Base.astro";
import Band from "../../components/Band.astro";
import Blocks from "../../components/Blocks.astro";
import Faq from "../../components/Faq.astro";
import FeatureScene from "../../components/product/FeatureScene.astro";
import { FEATURES, type PageSpec } from "../../data/content";
import { APP_URL, faqSchema } from "../../data/site";
export function getStaticPaths() { return FEATURES.map(feature => ({ params: { slug: feature.slug }, props: { feature } })); }
interface Props { feature: PageSpec; }
const { feature } = Astro.props;
const faqs = feature.faqs ?? [];
const relatedBySlug: Record<string, string[]> = {
  "dues-and-payments": ["collections", "accounting-and-budgets", "resident-portal"],
  "collections": ["dues-and-payments", "rules-and-enforcement", "records-and-audit"],
  "accounting-and-budgets": ["dues-and-payments", "vendors-and-insurance", "records-and-audit"],
  "rules-and-enforcement": ["documents-and-answers", "resident-portal", "meetings-and-voting"],
  "meetings-and-voting": ["records-and-audit", "documents-and-answers", "resident-portal"],
  "documents-and-answers": ["rules-and-enforcement", "records-and-audit", "resident-portal"],
  "vendors-and-insurance": ["accounting-and-budgets", "records-and-audit", "documents-and-answers"],
  "resident-portal": ["dues-and-payments", "documents-and-answers", "rules-and-enforcement"],
  "records-and-audit": ["meetings-and-voting", "accounting-and-budgets", "documents-and-answers"],
};
const related = (relatedBySlug[feature.slug] ?? []).map(slug => FEATURES.find(item => item.slug === slug)!);
const schema = JSON.stringify([faqSchema(faqs), {
  "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://commonparcel.com/" },
    { "@type": "ListItem", position: 2, name: "Product", item: "https://commonparcel.com/product" },
    { "@type": "ListItem", position: 3, name: feature.title },
  ],
}]).replaceAll("<", "\\u003c");
---
<Base title={feature.title} description={feature.description} path={`/product/${feature.slug}`} schema={schema}>
  <section class="feature-intro"><div class="page feature-grid">
    <div><a class="back-link" href="/product">← All features</a><h1 class="t-display">{feature.h1}</h1><p class="t-lede">{feature.lede}</p><div class="actions"><a class="btn btn--primary" href={APP_URL}>Get started <span aria-hidden="true">↗</span></a><a class="text-link" href="/pricing">See pricing</a></div></div>
    <figure class="feature-art"><div class="scene-frame"><FeatureScene slug={feature.slug} /></div><figcaption>Illustrative example · Fictional association data</figcaption></figure>
  </div></section>
  {feature.bands.map(band => <Band title={band.title} layout={band.layout} field={band.field}><Blocks body={band.body} /></Band>)}
  <Faq items={faqs} />
  <div class="page related"><div>{related.map(item => <a href={`/product/${item.slug}`}>{item.title} <span aria-hidden="true">↗</span></a>)}</div></div>
</Base>
<style>
  .feature-intro { padding-block: 44px 72px; border-bottom: var(--stroke-edge); }.feature-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }.back-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; margin-bottom: 24px; text-decoration: none; }.eyebrow { font-size: 12px; } h1 { font-size: clamp(38px, 4.3vw, 60px); max-width: 17ch; }.t-lede { margin: 24px 0 28px; max-width: 34em; font-size: 19px; }.feature-art { margin: 0; min-width: 0; }.scene-frame { width: 100%; }.scene-frame :global(.feature-scene) { width: 100%; } figcaption { font: 400 12px/1.6 var(--font-mono); color: var(--ink-3); padding-top: 12px; }.related { padding-block: 24px 64px; }.related > div { display: flex; flex-wrap: wrap; gap: 16px 36px; }.related a { display: inline-flex; min-height: 44px; align-items: center; gap: 14px; font-size: 15px; }
  @media(max-width: 850px) { .feature-grid { grid-template-columns: 1fr; gap: 32px; } h1 { max-width: 22ch; }.scene-frame { max-width: 600px; }.feature-art { max-width: 600px; width: 100%; } }
</style>
