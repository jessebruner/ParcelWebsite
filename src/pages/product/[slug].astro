---
/**
 * One template for the eight feature pages. Content lives in
 * src/data/content.ts; the shape lives here, once.
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Band from "../../components/Band.astro";
import Blocks from "../../components/Blocks.astro";
import { FEATURES } from "../../data/content";

export function getStaticPaths() {
  return FEATURES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<Base
  title={page.title}
  description={page.description}
  path={`/product/${page.slug}`}
  reviewed="August 2026"
>
  <Hero eyebrow={page.eyebrow}>
    <h1 class="t-display">{page.h1}</h1>
    <p class="t-lede">{page.lede}</p>
  </Hero>

  {page.bands.map((band) => (
    <Band
      title={band.title}
      field={band.field}
      note={band.note?.[0]}
      noteHref={band.note?.[1]}
    >
      <Blocks body={band.body} />
    </Band>
  ))}

  <section class="close on-ink">
    <div class="page">
      <h2 class="t-sheet">Get your evenings back.</h2>
      <div class="actions">
        <a class="btn btn--on-ink" href="/demo">Get early access</a>
        <a class="btn btn--ghost-on-ink" href="/pricing">See the price</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .close { background: var(--cold); color: var(--paper); border-top: 1.5px solid var(--terracotta); }
  .close h2 { color: var(--paper); }
  .close .actions { margin-top: var(--s-6); }
  h1 { max-width: 20ch; }
</style>
