---
/**
 * COLLECTIONS. The first product page to leave the shared template.
 *
 * Astro gives a static route precedence over a dynamic one, so this file takes
 * /product/collections away from [slug].astro on its own. The data entry in
 * src/data/content.ts is now dead for this slug and stays only because the other
 * seven pages still read from that file.
 *
 * Why it left. One template produced eight pages with the same five bands in the
 * same order, so a reader could not tell the delinquency ladder from the vendor
 * re-bid calendar without reading the words. A ladder is a dated sequence with a
 * waiting period between each pair of steps, and it wants a timeline. That shape
 * is the argument.
 *
 * Everything factual here was read out of ParcelHOA rather than written for the
 * page, and the departures from what that code does are noted where they occur:
 *
 *   src/lib/delinquency.ts             accrual, holds, rung selection, cure gaps
 *   src/lib/delinquency.test.ts        the cases the team cared about
 *   src/lib/officer-gate.ts            two signatures, and the fail-closed default
 *   src/lib/statute/data/fl.ts         the ladder in the timeline, and its citation
 *   src/lib/statute/data/contested.ts  what two readers could not agree on
 *   src/lib/notice-brief.ts            what may honestly be said about delivery
 *   src/components/parcel/charts/AgingBarChart.tsx   the exhibit
 *
 * Three corrections to the copy this page inherited, all of them factual:
 *   The old page said four steps. The ladder has three rungs at most, and
 *   Florida's record holds three.
 *   The old page put the friendly reminder on the day the grace period ends.
 *   Florida puts it on day one after the due date, which is inside grace.
 *   The old page said Parcel "sends" the reminder, the notice and the demand.
 *   Parcel drafts them. Certified mail is issue #25 and is not connected.
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Band from "../../components/Band.astro";
import Panel from "../../components/Panel.astro";
import PixelSky from "../../components/PixelSky.astro";
import Ladder, { type Step } from "../../components/collections/Ladder.astro";
import Split from "../../components/collections/Split.astro";
import AgingChart from "../../components/collections/AgingChart.astro";

/*
 * Florida, verbatim from src/lib/statute/data/fl.ts:53. Three steps, day counts
 * of 1, 30 and 60, and a section reference on step 2 only. The record's own note
 * says as much: "Only step 2 carries a section reference in the original data."
 *
 * The cure period is the gap between one threshold and the next, which is what
 * selectRung uses: `step.daysAfterDue - previous.daysAfterDue`. So 29 days, then
 * 30. It is not a number this page chose.
 */
const STEPS: Step[] = [
  {
    n: 1,
    day: 1,
    name: "Friendly reminder",
    ref: null,
    what:
      "Day one after the due date, which is still inside the grace period your own documents set. " +
      "Nothing has been charged yet, and this letter does not charge anything.",
    who: "Parcel drafts it",
    cure: 29,
  },
  {
    n: 2,
    day: 30,
    name: "Formal late notice",
    ref: "Fla. Stat. §720.335",
    what:
      "The notice the statute names. By now the late fee has been charged once and interest has " +
      "started running, both at the rates recorded in your governing documents.",
    who: "Parcel drafts it · two officers sign it",
    cure: 30,
    elapsed: 0.6,
  },
  {
    n: 3,
    day: 60,
    name: "Demand letter / lien warning",
    ref: null,
    what:
      "The letter before a lien, with principal, late fee and interest broken out separately so " +
      "the figure can be checked line by line.",
    who: "Parcel drafts it · two officers sign it · the board mails it",
  },
];

/*
 * Every reason selectRung and accrue decline to act, with what the board is told.
 * The third column is quoted from the product, not written for this table:
 *   1  delinquency.ts:180, :317
 *   2  delinquency.ts:364
 *   3  statute/data/contested.ts, the stored value for a contested fact
 *   4  delinquency.ts:201
 *   5  delinquency.ts:402
 *   6  officer-gate.ts:177
 */
const REFUSALS: [string, string, string][] = [
  ["A hold on the account", "Accrual and the ladder both stop", "An active hold freezes this account."],
  [
    "Your state's collection procedure is unread",
    "No notice is drafted",
    "The account is still delinquent; it cannot be escalated defensibly from here.",
  ],
  [
    "Two readers disagreed about the statute",
    "Neither reading is used",
    "Two independent readings disagreed, so neither is used.",
  ],
  [
    "No late fee or interest rate on file",
    "Nothing is charged",
    "Confirm the terms in its governing documents first.",
  ],
  [
    "The last notice went out too recently",
    "The next step waits out the cure period",
    "The previous notice went out 3 days ago and this jurisdiction allows 30 to cure.",
  ],
  ["Only one officer has signed", "Nothing is sent", "You have already signed this. It needs a second officer."],
];

const FAQS: [string, string][] = [
  [
    "Can we set our own day counts?",
    "Your grace period comes from your own documents, and Parcel uses it. The step thresholds come " +
      "from your state's statute, and those are not a field anybody can type into. That is what " +
      "makes the resulting letter defensible.",
  ],
  [
    "We are already four months behind on a lot. Does it jump straight to the lien warning?",
    "No. It starts at step one, then waits out the cure period your state's own thresholds imply " +
      "before it offers step two. An owner who opened a friendly reminder and an intent to lien in " +
      "the same post had no opportunity to cure between them.",
  ],
  [
    "Is interest compounded?",
    "No. Simple daily interest on the principal, and never on the late fee. The late fee is charged " +
      "once, at the greater of the flat amount or the percentage your documents set.",
  ],
  [
    "The nightly job ran twice. Did the balance move?",
    "No. The second run adds nothing. Interest is recomputed from a day count and rounded once, so " +
      "an account processed every night and an account processed weekly land on the same figure.",
  ],
  [
    "Our state's collection rule is one two lawyers would read differently. Then what?",
    "Then two readers here disagreed as well, and Parcel holds the field empty rather than picking a " +
      "side. The ladder does not advance in your state until somebody reads that section and a second " +
      "reader confirms it. Ledgers, statements, documents and the resident portal work normally.",
  ],
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map(([q, a]) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
});
---

<Base
  title="Collections"
  description="A graduated delinquency ladder that runs on your state's periods, holds when a board says hold, and waits for two officers before anything statutory leaves."
  shareTitle="What happens when someone stops paying"
  path="/product/collections"
  reviewed="August 2026"
  schema={schema}
>
  <Hero eyebrow="Collections" seed={1471}>
    <h1 class="t-display">What happens when someone stops paying</h1>
    <p class="t-lede">
      Parcel drafts the reminder, then the late notice, then the demand, on the dates your documents
      and your state set. It will not move faster than that. Moving faster is, in most states,
      procedurally void.
    </p>
  </Hero>

  <Band title="The order notices go out in">
    <p>
      Three steps at most, in order, and none of them skips. An account that sat a year overdue with
      nothing sent still starts at step one. Serving a foreclosure warning to an owner who never
      received a late notice is indefensible, and a board that does it usually loses the point it
      was trying to win.
    </p>
    <p>
      Between two steps there is a waiting period, and the waiting period is the part boards get
      wrong. Parcel takes it from the gap between your state's own thresholds rather than from a
      number it picked.
    </p>

    <Ladder
      steps={STEPS}
      caption="Florida, as Parcel records it. Source: Fla. Stat. §720.3085. Step 2 is the only step the record holds a section reference for."
    />

    <p class="coda">
      Those day counts are Florida's. Your state's are its own, and Parcel runs yours. Where the
      grace period ends is set by your governing documents, not by the statute and not by us.
    </p>
  </Band>

  <PixelSky mode="band" scene="dawn" seed={1474} />

  <section class="exhibit">
    <div class="page">
      <p class="t-label">Aging</p>
      <h2 class="t-sheet">The arithmetic behind the figure on the notice</h2>

      <Split>
        <h3 class="t-title">It does not compound, and it does not drift</h3>
        <p>
          Interest is simple daily interest on the principal only. It never compounds, and it is
          never charged on the late fee. Neither Florida's assessment statute nor a typical
          declaration authorizes either one, and a policy that does both is a policy an owner's
          attorney can have thrown out in full.
        </p>
        <p>
          The balance is recomputed from a day count and rounded once, rather than accumulated pass
          by pass. Two lots owing the same money owe the same money, whether the nightly job ran
          every night or missed a week. Run it twice in one day and the second run adds nothing.
        </p>
        <p class="coda">
          Nothing accrues before the grace period ends, and nothing accrues at all while your late
          fee and interest rate are missing. Parcel will not reach for a default: the one it has
          built in is Florida's eighteen percent ceiling, and billing a Colorado owner at Florida's
          ceiling is not an accounting correction that can be quietly reversed.
        </p>

        <AgingChart slot="figure" />
      </Split>
    </div>
  </section>

  <Band title="Putting an account on hold">
    <p>
      A board can freeze an account: a hardship, a filed dispute, an agreed payment plan, a death in
      the family. A hold is a person deciding that nothing accrues.
    </p>
    <ul class="rows">
      <li><b>Accrual stops.</b> No late fee, no interest, and no days counted toward interest while the hold is on.</li>
      <li><b>The ladder stops.</b> No step is selected and no notice is drafted, however overdue the account is.</li>
      <li><b>It does not catch up.</b> When the hold lifts, the held months are not back-charged. A hold that accrued quietly in the background would surprise an owner who agreed a plan in good faith, which would make the hold worth nothing.</li>
      <li><b>The board is told it is their own hold.</b> The hold is checked before anything else, so the sentence on the screen names the decision the board made rather than something Parcel could not read. Both stop the ladder. Only one of them is something they did.</li>
    </ul>
    <p class="coda">
      Withdrawing a notice is not gated either. Any one officer can stop one alone and the reason is
      recorded. Halting an action is safe; committing one is not.
    </p>
  </Band>

  <Band title="Nothing statutory leaves on one signature">
    <p>
      A demand, a lien warning, or any letter carrying legal weight needs two distinct officers. The
      record shows who signed, when, and on what the figure stood at the time.
    </p>

    <Panel
      label="Lot 63 · demand letter"
      note="1 of 2 signatures"
      rows={[
        { label: "Drafted and cited by Parcel", value: "10 Aug", cite: "Fla. Stat. §720.3085" },
        { label: "Signed by the treasurer", value: "11 Aug", cite: "On the balance as it stood that morning" },
        { label: "Second officer", chip: "Pending", cite: "Nothing is sent until this is signed", pending: true },
        { label: "Accrual", value: "Frozen", cite: "Hardship recorded by the board" },
        { label: "Withdrawal", value: "Any officer, alone", cite: "Not gated. Stopping is safe" },
      ]}
      footing={{ label: "Signatures collected", value: "1 of 2" }}
      caption="Sample data. The signature wording is the gate's own."
    />

    <ul class="rows">
      <li><b>Two is the default, not the exception.</b> The list of actions allowed to proceed on one signature has two entries: an announcement, and a courtesy reminder that starts no clock. Anything absent from that list needs two, so adding a new kind of letter and forgetting to classify it gates it at two and somebody complains. That is the failure worth having.</li>
      <li><b>One officer cannot sign twice.</b> A unique database index holds one signature per officer per item. A double click, a retry after a failure, or a second server cannot satisfy the gate alone. The friendly error is the application check; the index is the guarantee.</li>
      <li><b>A support operator cannot sign at all.</b> Reading an association through an officer's role is refused before the role is even examined, because during a view the role genuinely is an officer's. A signature has to come from the officer themselves.</li>
    </ul>
    <p class="coda">
      If your state's collection procedure has not been read and confirmed by a second reader, the
      ladder does not advance and the screen names the provision that is missing. The account is
      still delinquent. It cannot be escalated defensibly from there.
    </p>
  </Band>

  <section class="refusals">
    <div class="page">
      <p class="t-label">Refusals</p>
      <h2 class="t-sheet">Six reasons the ladder stops, and six different sentences</h2>
      <p class="intro">
        A board needs to know which one it is looking at. Held the obvious way, as one empty field,
        an unread statute and a statute that genuinely says nothing are the same thing, and every
        piece of code downstream treats them the same.
      </p>

      <div class="scroll-x" role="region" aria-label="Why the ladder stops" tabindex="0">
        <table>
          <caption>What Parcel found, what the ladder does, and what the board reads</caption>
          <thead>
            <tr><th>What Parcel found</th><th>What the ladder does</th><th>What the board reads</th></tr>
          </thead>
          <tbody>
            {REFUSALS.map(([found, does, says]) => (
              <tr>
                <th scope="row">{found}</th>
                <td>{does}</td>
                <td class="quote">{says}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="coda">
        Across every statutory fact Parcel holds, 24 of 490 compared readings are withheld on that
        third ground. There is no tie-break and no majority. A disagreement between two careful
        readers is evidence that the provision is ambiguous, and ambiguity is exactly when a board
        should not be handed a number.
      </p>
    </div>
  </section>

  <Band
    title="What Parcel cannot do yet"
    note="See rules and enforcement"
    noteHref="/product/rules-and-enforcement"
  >
    <div class="panel--statutory">
      <p class="t-label">Proof of mailing</p>
      <p class="lede">
        Certified mail is not connected. Parcel can show that a notice was drafted, cited, and
        approved by two officers. It cannot show that it was served.
      </p>
      <p class="note">
        Until that ships, mail the notice yourself and record it. The mailed copy is the one that
        counts, and a screen implying otherwise would misrepresent whether an owner was served.
      </p>
    </div>
    <p>
      Where a notice is recorded as sent with no channel against it, the record says so in as many
      words: how it was delivered was not recorded, so there is no proof of mailing here. A courtesy
      copy by email says on its face that an email is not service.
    </p>
    <p class="coda">
      This is the one claim on the page a board should check us on before launch. Everything above it
      is arithmetic and refusal, which are cheap to verify. Delivery is not.
    </p>
  </Band>

  <Band title="Questions" field note="Talk to a person" noteHref="/contact">
    <dl class="faq">
      {FAQS.map(([q, a]) => (
        <div>
          <dt class="t-title">{q}</dt>
          <dd>{a}</dd>
        </div>
      ))}
    </dl>
  </Band>

  <section class="close on-ink">
    <div class="page">
      <h2 class="t-sheet">Show your board the record before it needs one.</h2>
      <div class="actions">
        <a class="btn btn--on-ink" href="/demo">Get early access</a>
        <a class="btn btn--ghost-on-ink" href="/pricing">See the price</a>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { max-width: 22ch; }

  /* Two sections step outside the two-track rail so a wide exhibit and a
     three-column table get the full measure. The rail is right for an argument
     and wrong for a chart. */
  .exhibit { background: var(--field); border-bottom: var(--stroke-rule); }
  .exhibit h2 { max-width: 26ch; margin-top: var(--s-3); }
  .exhibit :global(.split) { margin-top: var(--s-8); }

  .refusals { border-bottom: var(--stroke-rule); }
  .refusals h2 { max-width: 30ch; margin-top: var(--s-3); }
  .refusals .intro { max-width: var(--read); margin: var(--s-5) 0 var(--s-8); }
  .refusals .coda { max-width: var(--read); margin-top: var(--s-8) !important; }

  /*
   * Three columns of sentences will squeeze to 88px each at 375 rather than
   * overflow, which is worse than scrolling: the middle column wrapped to six
   * lines. A floor of 30em makes the region scroll inside itself instead, which
   * is what .scroll-x is for, and the region is focusable so a keyboard can
   * reach the scroll.
   */
  .refusals table { min-width: 30em; }
  .refusals .scroll-x { padding-bottom: 2px; }
  .refusals :global(td.quote) { font-family: var(--font-serif); color: var(--ink); }
  .refusals :global(th[scope="row"]) {
    font-family: var(--font-sans);
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0;
    border-bottom: var(--stroke-hairline);
    padding-right: var(--s-5);
  }

  .close { background: var(--cold); color: var(--paper); border-top: 1.5px solid var(--terracotta); }
  .close h2 { color: var(--paper); max-width: 26ch; }
  .close .actions { margin-top: var(--s-6); }
</style>
