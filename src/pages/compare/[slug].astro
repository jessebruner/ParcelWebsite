---
/**
 * Dynamic Comparison Route Template
 * Renders all comparison pages defined in src/data/content.ts
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Band from "../../components/Band.astro";
import Blocks from "../../components/Blocks.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import { COMPARISONS, type PageSpec } from "../../data/content";

export function getStaticPaths() {
  return COMPARISONS.map((comp) => ({
    params: { slug: comp.slug },
    props: { comparison: comp },
  }));
}

interface Props {
  comparison: PageSpec;
}

const { comparison } = Astro.props;
---

<Base
  title={comparison.title}
  description={comparison.description}
  path={`/compare/${comparison.slug}`}
  shareTitle={`Common Parcel: ${comparison.title}`}
>
  <Hero eyebrow={comparison.eyebrow} scene="dusk" seed={88}>
    <h1 class="t-display">{comparison.h1}</h1>
    <p class="t-lede">{comparison.lede}</p>
    <div class="actions">
      <button type="button" class="btn btn--on-ink" data-open-modal="early-access">Request Early Access</button>
      <a href="/pricing" class="btn btn--ghost-on-ink">View Transparent Pricing</a>
    </div>
  </Hero>

  {comparison.bands.map((band) => (
    <Band
      title={band.title}
      field={band.field}
      note={band.note ? band.note[0] : undefined}
      noteHref={band.note ? band.note[1] : undefined}
    >
      <Blocks body={band.body} />
    </Band>
  ))}

  <CtaBand
    headline="Evaluate Common Parcel for your neighborhood."
    lede="Request early access or see our simple per-door subscription rates."
  />
</Base>
