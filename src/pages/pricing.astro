---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import RateCalculator from "../components/pricing/RateCalculator.astro";
import Faq from "../components/Faq.astro";
import { DEFAULT_BRACKETS, money } from "../components/pricing/brackets";
import { faqSchema } from "../data/site";
const faqs: [string, string][] = [
  ["How is the monthly price calculated?", "Each rate applies only to the lots in that bracket. The first 10 lots are $2.50 each, lots 11 through 70 are $1.10 each, and lots above 70 are $0.40 each. The monthly minimum is $10."],
  ["Do smaller associations get the same features?", "Yes. Every association gets the same software features. Your lot count determines the subscription price."],
  ["Is there a setup fee or a long-term contract?", "Setup, moving your owner list, and importing your documents are included. Subscriptions are month to month, with no long-term contract requirement."],
  ["What is separate from the software price?", "Postal mail is outside the subscription, and its price has not been set. Certified-mail service is not connected. Online payments may carry fees from the connected payment service; confirm those costs before enabling payments."],
  ["Can we take our records with us?", "Yes. Your association can export records including financial ledgers, governing documents, meeting minutes, and available activity records."],
];
const schema = JSON.stringify(faqSchema(faqs));
---
<Base title="HOA software pricing and calculator" description="Calculate Common Parcel’s monthly HOA software price by lot count. All features included, a $10 monthly minimum, and month-to-month subscriptions." path="/pricing" schema={schema}>
  <Hero><h1 class="t-display">One price for<br />the whole association.</h1><p class="t-lede">Four units cost $10 a month, with all software features included. Enter your number of lots or units below to calculate your association’s price.</p></Hero>
  <section class="pricing-calculator" id="calculator"><div class="page"><RateCalculator /></div></section>
  <section class="rate-section"><div class="page rate-grid"><div><h2 class="t-sheet">The per-unit rate drops as your association grows.</h2><p>For 100 lots: $25 for the first 10, $66 for the next 60, and $12 for the last 30. That’s <strong>$103 per month.</strong></p></div><div><table><caption>Monthly software rates</caption><thead><tr><th scope="col">Lots in this bracket</th><th scope="col">Per lot / month</th></tr></thead><tbody>{DEFAULT_BRACKETS.map(band => <tr><th scope="row">{band.label}</th><td>{money(band.rate)}</td></tr>)}</tbody></table><p class="small">A $10 monthly minimum applies to the association.</p></div></div></section>
  <section class="included"><div class="page"><div class="section-heading"><div><h2 class="t-sheet">The tools your board needs.</h2></div><a class="text-link" href="/product">Explore the product <span aria-hidden="true">→</span></a></div><div class="included-grid">{[["Finances", "Dues and payment records", "Collections", "Ledgers and budgets"], ["Board work", "Meetings and voting", "Violations and requests", "Vendor and insurance records"], ["Your community", "Resident portal", "Governing documents and answers", "Association records and exports"]].map(([title, ...items]) => <div><h3 class="t-title">{title}</h3><ul class="rows">{items.map(item => <li>{item}</li>)}</ul></div>)}</div><p class="small">Online payments require a connected payment service. Postal mail and any processing fees are separate.</p></div></section>
  <Faq items={faqs} title="Pricing questions." />
</Base>
<style>
  .pricing-calculator { padding-top: 48px; }.rate-section { border-top: var(--stroke-edge); }.rate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }.rate-grid h2 { max-width: 20ch; }.rate-grid p { max-width: 35em; }.small { font-size: 13px; color: var(--ink-3); margin-top: 24px; } tbody th { border-bottom: var(--stroke-edge); font-weight: 400; }.included { background: var(--field); border-block: var(--stroke-edge); }.included-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }.included-grid h3 { margin-bottom: 20px; }.included-grid li { font-size: 15px; } @media(max-width: 700px) { .rate-grid, .included-grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
