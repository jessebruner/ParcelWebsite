---
/**
 * Product Hub Overview
 * Software built for self-managed HOAs.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import StakeholderGrid from "../components/ui/StakeholderGrid.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import CtaBand from "../components/ui/CtaBand.astro";

const description = "Explore Common Parcel: automated dues collection, resident portals, architectural review workflows, and official record keeping built for self-managed HOAs.";
---

<Base
  title="What Common Parcel does"
  description={description}
  path="/product"
  shareTitle="Common Parcel: Software for Self-Managed HOAs"
>
  <Hero scene="dusk" seed={42}>
    <h1 class="t-display">Software built for self-managed HOA boards.</h1>
    <p class="t-lede">
      Common Parcel replaces scattered spreadsheets and reduces the clerical work volunteers handle by hand.
    </p>
    <div class="actions">
      <button type="button" class="btn btn--on-ink" data-open-modal="early-access">Get early access</button>
    </div>
  </Hero>

  <!-- STAKEHOLDER VALUE -->
  <section class="band band--field">
    <div class="page">
      <div class="section-intro">
        <h2 class="t-sheet">Built for everyone in the neighborhood.</h2>
        <p class="t-lede">
          Software that makes board volunteering sustainable while giving homeowners clear answers.
        </p>
      </div>
      <StakeholderGrid />
    </div>
  </section>

  <!-- FEATURE PILLARS -->
  <section class="band">
    <div class="page">
      <div class="section-intro">
        <h2 class="t-sheet">Everything a management company charges you for.</h2>
      </div>

      <!-- Pillar 1: Dues & Accounting -->
      <FeatureCard
        panelName="Assessments"
        title="Track dues and receive deposits straight to your bank."
        description="When online payments are enabled, homeowners pay by ACH or card directly into your association account. Payment records and imported bank activity stay together for the treasurer to reconcile."
        href="/product/dues-and-payments"
        linkText="Explore Financial Tools"
      >
        <div slot="details">
          <ul class="rows">
            <li><b>Direct to Bank:</b> Common Parcel never holds HOA funds; payments deposit to your account.</li>
            <li><b>Payment Tracking:</b> Scheduled digital invoices and clear delinquency tracking.</li>
            <li><b>Clean Ledgers:</b> Balance sheets and accounts receivable tracking for your treasurer.</li>
          </ul>
        </div>
        <div slot="visual">
          <div class="mock-table">
            <div class="mock-row head">
              <span>Lot / Unit</span>
              <span>Owner</span>
              <span>Dues Status</span>
              <span>Balance</span>
            </div>
            <div class="mock-row">
              <span class="num">Lot 14</span>
              <span>Miller, R.</span>
              <span class="status-badge paid">Paid (ACH)</span>
              <span class="num">$0.00</span>
            </div>
            <div class="mock-row">
              <span class="num">Lot 15</span>
              <span>Chang, E.</span>
              <span class="status-badge paid">Paid (Card)</span>
              <span class="num">$0.00</span>
            </div>
            <div class="mock-row">
              <span class="num">Lot 16</span>
              <span>Patel, S.</span>
              <span class="status-badge pending">Invoice Sent</span>
              <span class="num">$185.00</span>
            </div>
          </div>
        </div>
      </FeatureCard>

      <!-- Pillar 2: Resident Portal -->
      <FeatureCard
        panelName="Resident home"
        title="A straightforward portal for owners and residents."
        description="Homeowners can check their dues balance, submit architectural requests, and access community documents from any browser."
        href="/product/resident-portal"
        linkText="See Homeowner Features"
        reverse={true}
      >
        <div slot="details">
          <ul class="rows">
            <li><b>Online Dues:</b> Simple self-serve dues payments when connected.</li>
            <li><b>Community Directory:</b> Verified resident contact information for your neighborhood.</li>
            <li><b>Governing Documents:</b> Bylaws, CC&Rs, and meeting minutes available in one spot.</li>
          </ul>
        </div>
        <div slot="visual">
          <div class="mock-portal-card">
            <div class="portal-header">
              <div class="portal-greeting">Welcome back, Sarah</div>
              <div class="portal-lot">Unit 402 - Annual Dues: Current</div>
            </div>
            <div class="portal-tiles">
              <div class="portal-tile">
                <span class="tile-icon">Payment</span>
                <span class="tile-title">Pay Annual Dues</span>
                <span class="tile-sub">Next due Oct 1</span>
              </div>
              <div class="portal-tile">
                <span class="tile-icon">Docs</span>
                <span class="tile-title">Governing Docs</span>
                <span class="tile-sub">12 files posted</span>
              </div>
              <div class="portal-tile">
                <span class="tile-icon">Requests</span>
                <span class="tile-title">Submit ARC Form</span>
                <span class="tile-sub">1 active ticket</span>
              </div>
            </div>
          </div>
        </div>
      </FeatureCard>

      <!-- Pillar 3: Architectural Reviews & Rules -->
      <FeatureCard
        panelName="Architectural review"
        title="Structured architectural reviews without neighborhood disputes."
        description="Handle paint, roofing, solar, and landscaping submissions with clear steps, committee voting, and recorded decisions."
        href="/product/rules-and-enforcement"
        linkText="View Architectural Workflows"
      >
        <div slot="details">
          <ul class="rows">
            <li><b>Digital Submissions:</b> Homeowners attach contractor plans and material photos.</li>
            <li><b>Committee Review:</b> Private board discussion and recorded votes.</li>
            <li><b>Written Decisions:</b> Downloadable decision letters based on your association rules.</li>
          </ul>
        </div>
        <div slot="visual">
          <div class="mock-arc">
            <div class="arc-badge">ARC Request #1048</div>
            <div class="arc-title">Solar Panel Installation</div>
            <div class="arc-meta">Submitted by Lot 28 on August 14</div>
            <div class="arc-votes">
              <div class="vote-tag approved">President: Approved</div>
              <div class="vote-tag approved">ARC Chair: Approved</div>
              <div class="vote-tag pending">Secretary: Reviewing</div>
            </div>
          </div>
        </div>
      </FeatureCard>

      <!-- Pillar 4: Elections & Meetings -->
      <FeatureCard
        panelName="Annual meeting"
        title="Clear records and structured voting for clean board handoffs."
        description="Every vote, resolution, and vendor agreement is kept in official records so incoming officers inherit clean history."
        href="/product/meetings-and-voting"
        linkText="Explore Governance Tools"
        reverse={true}
      >
        <div slot="details">
          <ul class="rows">
            <li><b>Digital Voting:</b> Quorum tracking and recorded ballot tallies.</li>
            <li><b>Vendor Records:</b> Central contracts, insurance certificates, and renewal alerts.</li>
            <li><b>Orderly Transitions:</b> Hand off community records to future board leaders with confidence.</li>
          </ul>
        </div>
        <div slot="visual">
          <div class="mock-gov-list">
            <div class="gov-item">
              <div class="gov-name">2026 Annual General Meeting Minutes</div>
              <span class="status-badge paid">Official Record</span>
            </div>
            <div class="gov-item">
              <div class="gov-name">Landscaping Maintenance Agreement (2026-2027)</div>
              <span class="status-badge active">Active Contract</span>
            </div>
            <div class="gov-item">
              <div class="gov-name">Master Association Insurance Policy Certificate</div>
              <span class="status-badge active">Current</span>
            </div>
          </div>
        </div>
      </FeatureCard>
    </div>
  </section>

  <!-- COMPARISON CALLOUT -->
  <section class="band band--field">
    <div class="page">
      <div class="compare-teaser">
        <div class="teaser-text">
            <h2 class="t-headline">Built specifically for volunteer boards</h2>
          <p class="t-lede">
            Explore why software designed for volunteers works differently, and read our field guides for self-managed associations.
          </p>
        </div>
        <div class="teaser-links">
          <a href="/why-common-parcel" class="compare-link-card">
            <span class="card-label">Philosophy</span>
            <div class="card-name">Why Common Parcel</div>
            <div class="card-desc">Why software built for volunteer boards operates on your governing documents.</div>
          </a>
          <a href="/blog" class="compare-link-card">
            <span class="card-label">Blog</span>
            <div class="card-name">HOA Governance & Statutory Guides</div>
            <div class="card-desc">Practical guides with primary statutory citations for self-managed boards.</div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBand
    headline="Do it without them."
    scene="dawn"
    seed={191}
  />
</Base>

<style>
  .section-intro {
    max-width: 36em;
    margin-bottom: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  /* Mockup styles */
  .mock-table {
    display: flex;
    flex-direction: column;
    font-size: var(--t-micro);
    border: 1px solid var(--c-edge);
  }
  .mock-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.2fr 1fr;
    padding: 8px 12px;
    border-bottom: 1px solid var(--c-hairline);
    align-items: center;
  }
  .mock-row.head {
    background: var(--field);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    border-bottom: 1px solid var(--c-edge);
  }
  .mock-row:last-child { border-bottom: none; }

  .status-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 6px;
    font-weight: 500;
  }
  .status-badge.paid { background: var(--held); color: var(--terracotta-deep); border: 1px solid var(--bisque-edge); }
  .status-badge.pending { background: var(--field); color: var(--ink-2); border: 1px solid var(--c-edge); }
  .status-badge.active { background: var(--held); color: var(--terracotta); border: 1px solid var(--bisque-edge); }

  .mock-portal-card {
    background: var(--paper);
    border: 1px solid var(--c-edge);
    padding: var(--s-4);
  }
  .portal-header {
    border-bottom: var(--stroke-hairline);
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .portal-greeting {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--ink);
    font-size: 16px;
  }
  .portal-lot {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .portal-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-2);
  }
  .portal-tile {
    background: var(--card);
    border: 1px solid var(--c-edge);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tile-icon {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    color: var(--terracotta);
    font-weight: 600;
  }
  .tile-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
  }
  .tile-sub {
    font-size: 10px;
    color: var(--ink-3);
  }

  .mock-arc {
    background: var(--paper);
    border: 1px solid var(--c-edge);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .arc-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--terracotta);
    font-weight: 600;
  }
  .arc-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .arc-meta {
    font-size: 12px;
    color: var(--ink-3);
  }
  .arc-votes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--s-2);
  }
  .vote-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border: 1px solid var(--c-edge);
    background: var(--card);
  }
  .vote-tag.approved { border-color: var(--c-edge); color: var(--ink); background: var(--held); }
  .vote-tag.pending { border-color: var(--bisque-edge); color: var(--terracotta); }

  .mock-gov-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .gov-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: var(--paper);
    border: 1px solid var(--c-edge);
    font-size: 13px;
  }
  .gov-name {
    font-weight: 500;
    color: var(--ink);
  }

  /* Compare teaser */
  .compare-teaser {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 860px) {
    .compare-teaser { grid-template-columns: 1fr; }
  }
  .teaser-links {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .compare-link-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--c-edge);
    padding: var(--s-4) var(--s-5);
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .compare-link-card:hover {
    border-color: var(--terracotta);
    transform: translateX(4px);
  }
  .card-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
    font-weight: 600;
  }
  .card-name {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
    margin: 2px 0 4px;
  }
  .card-desc {
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.4;
  }
</style>
