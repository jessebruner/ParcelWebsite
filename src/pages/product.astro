---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProductTour from "../components/product/ProductTour.astro";
import { FEATURES } from "../data/content";
import { APP_URL } from "../data/site";
---
<Base title="HOA management software for volunteer boards" description="Explore Common Parcel’s tools for HOA dues, accounting, documents, meetings, vendor records, and resident access. Built for self-managed associations." path="/product">
  <Hero><h1 class="t-display">One place to manage your HOA.</h1><p class="t-lede">Collect dues, review the finances, prepare meetings, and respond to residents. Common Parcel brings your association’s work into one account for the board.</p><div class="actions"><a class="btn btn--primary" href={APP_URL}>Get started <span aria-hidden="true">↗</span></a><a class="text-link" href="/pricing">See pricing</a></div></Hero>
  <section id="product-tour"><div class="page"><h2 class="t-sheet tour-heading">See how the main features work.</h2><ProductTour /></div></section>
  <section class="features"><div class="page"><div class="section-heading"><div><h2 class="t-sheet">Tools for every part of board work.</h2></div><p>Choose a feature to see what you can do<br />and how it helps your association.</p></div><div class="feature-list">{FEATURES.map((feature, i) => <a href={`/product/${feature.slug}`}><span class="feature-number">{String(i + 1).padStart(2, "0")}</span><div><h3>{feature.title}</h3><p>{feature.lede}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
</Base>
<style>
  .tour-heading { margin-bottom: 32px; }.features { background: var(--field); border-top: var(--stroke-edge); }.section-heading > p { font-size: 15px; color: var(--ink-3); }.feature-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }.feature-list a { color: var(--ink); text-decoration: none; display: flex; gap: 20px; padding-block: 28px; border-top: var(--stroke-edge); }.feature-number { font: 400 12px/2 var(--font-mono); color: var(--terracotta); } h3 { font: 500 24px/1.25 var(--font-serif); letter-spacing: -.035em; margin: 0; } .feature-list p { font-size: 15px; color: var(--ink-3); margin: 14px 0 0; }.arrow { margin-left: auto; color: var(--terracotta); }.feature-list a:hover h3 { color: var(--terracotta); text-decoration: underline; text-underline-offset: 5px; } @media(max-width: 700px) { .feature-list { grid-template-columns: 1fr; } }
</style>
