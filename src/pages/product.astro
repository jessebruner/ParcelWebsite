---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProductTour from "../components/product/ProductTour.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import { FEATURES } from "../data/content";
import { APP_URL } from "../data/site";
---
<Base title="HOA management software for volunteer boards" description="Explore Common Parcel’s tools for HOA dues, accounting, documents, meetings, vendor records, and resident access. Built for self-managed associations." path="/product">
  <Hero><p class="eyebrow">The Common Parcel workspace</p><h1 class="t-display">The work of your HOA.<br />In one place.</h1><p class="t-lede">Keep the finances, the documents, and the decisions together. Give every volunteer a clearer place to start.</p><div class="actions"><a class="btn btn--primary" href={APP_URL}>Get started <span aria-hidden="true">↗</span></a><a class="text-link" href="/pricing">See pricing</a></div></Hero>
  <section><div class="page"><h2 class="t-sheet tour-heading">Start with the everyday work.</h2><ProductTour /></div></section>
  <section class="features"><div class="page"><div class="section-heading"><div><p class="eyebrow">Explore the product</p><h2 class="t-sheet">A shared home for board work.</h2></div><p>Open a feature to see how it helps,<br />what your board reviews, and what to expect.</p></div><div class="feature-list">{FEATURES.map((feature, i) => <a href={`/product/${feature.slug}`}><span class="feature-number">{String(i + 1).padStart(2, "0")}</span><div><h3>{feature.title}</h3><p>{feature.lede}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
  <CtaBand headline="A clearer place to start." scene="street" />
</Base>
<style>
  .tour-heading { margin-bottom: 32px; }.features { background: var(--field); border-top: var(--stroke-edge); }.section-heading > p { font-size: 15px; color: var(--ink-3); }.feature-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }.feature-list a { color: var(--ink); text-decoration: none; display: flex; gap: 20px; padding-block: 28px; border-top: var(--stroke-edge); }.feature-number { font: 400 12px/2 var(--font-mono); color: var(--terracotta); } h3 { font: 500 24px/1.25 var(--font-serif); letter-spacing: -.035em; margin: 0; } .feature-list p { font-size: 15px; color: var(--ink-3); margin: 14px 0 0; }.arrow { margin-left: auto; color: var(--terracotta); }.feature-list a:hover h3 { color: var(--terracotta); text-decoration: underline; text-underline-offset: 5px; } @media(max-width: 700px) { .feature-list { grid-template-columns: 1fr; } }
</style>
